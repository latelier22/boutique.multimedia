{% extends '@SyliusUi/Layout/centered.html.twig' %}

{% block title %}Sylius | {{ 'sylius.ui.administration_panel_login'|trans }}{% endblock %}

{% block stylesheets %}
    {{ sylius_template_event('sylius.admin.layout.stylesheets') }}

    <style>
        body.centered {
            min-height: 100vh;
            margin: 0;
            background:
                radial-gradient(circle at top left, rgba(255,255,255,.10) 0%, transparent 32%),
                radial-gradient(circle at bottom right, rgba(255,255,255,.08) 0%, transparent 28%),
                linear-gradient(180deg, #ff8a1f 0%, #ef6c00 52%, #d85f00 100%);
            font-family: Inter, Arial, sans-serif;
        }

        body.centered .ui.grid {
            min-height: 100vh;
            margin: 0 !important;
            padding: 24px 16px;
        }

        body.centered .ui.grid > .column {
            max-width: 540px;
        }

      body.centered .ui.grid > .column > img.ui.image {
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    display: block;
    margin: 0 0 20px 0 !important;
    border-radius: 28px !important;
    background: linear-gradient(180deg, rgba(255,255,255,.98) 0%, rgba(246,249,255,.96) 100%);
    padding: 14px;
    border: 1px solid rgba(255,255,255,.45);
    box-shadow: 0 20px 44px rgba(0,0,0,.14);
}

        body.centered form.ui.form {
            margin-top: 0;
        }

        body.centered .ui.segment {
            background: rgba(255,255,255,.97) !important;
            border: 1px solid rgba(255,255,255,.45) !important;
            border-radius: 28px !important;
            box-shadow: 0 24px 60px rgba(0,0,0,.18) !important;
            padding: 34px !important;
        }

        body.centered .field > label {
            color: #163c83 !important;
            font-weight: 800 !important;
            margin-bottom: 7px !important;
        }

        body.centered .ui.form input[type="text"],
        body.centered .ui.form input[type="password"] {
            background: #fff !important;
            border: 1px solid #ffd1ad !important;
            border-radius: 16px !important;
            min-height: 50px !important;
            padding: 12px 14px !important;
            box-shadow: inset 0 1px 2px rgba(0,0,0,.03) !important;
            transition: all .15s ease;
        }

        body.centered .ui.form input[type="text"]:focus,
        body.centered .ui.form input[type="password"]:focus {
            border-color: #ef6c00 !important;
            box-shadow: 0 0 0 4px rgba(239,108,0,.12) !important;
        }

        body.centered .ui.toggle.checkbox label {
            color: #35507c !important;
            font-weight: 600 !important;
        }

        body.centered .ui.toggle.checkbox input:checked~.box:before,
        body.centered .ui.toggle.checkbox input:checked~label:before {
            background-color: #ef6c00 !important;
        }

        body.centered .ui.primary.button,
        body.centered .ui.primary.buttons .button {
            background: linear-gradient(180deg, #1f4ea8 0%, #163c83 100%) !important;
            color: #fff !important;
            border-radius: 16px !important;
            min-height: 50px !important;
            font-weight: 800 !important;
            letter-spacing: .2px !important;
            box-shadow: 0 12px 26px rgba(22,60,131,.26) !important;
        }

        body.centered .ui.primary.button:hover,
        body.centered .ui.primary.buttons .button:hover {
            background: linear-gradient(180deg, #255bc2 0%, #1b4699 100%) !important;
        }

        body.centered .ui.button {
            border-radius: 16px !important;
        }

        body.centered .ui.divider {
            color: rgba(22,60,131,.45) !important;
        }

        body.centered a.ui.button {
            background: rgba(31,78,168,.08) !important;
            color: #163c83 !important;
            font-weight: 700 !important;
            border: 1px solid rgba(31,78,168,.12) !important;
        }

        body.centered a.ui.button:hover {
            background: rgba(31,78,168,.14) !important;
        }

        body.centered .ui.message,
        body.centered .ui.negative.message,
        body.centered .ui.error.message {
            border-radius: 16px !important;
        }
    </style>
{% endblock %}

{% block content %}
    {{ sylius_template_event('sylius.admin.login.content', _context) }}
{% endblock %}

{% block javascripts %}
    {{ sylius_template_event('sylius.admin.layout.javascripts') }}
{% endblock %}
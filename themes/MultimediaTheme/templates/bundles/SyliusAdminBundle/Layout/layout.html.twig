{% import "@SyliusUi/Macro/rtl.html.twig" as rtl %}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <title>{% block title %}Sylius{% endblock %}</title>

    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">

    {% block metatags %}{% endblock %}

    {% block stylesheets %}
        <!--[if lt IE 9]>
        <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
        <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
        <![endif]-->

        <style>
            .admin-top-tools-menu {
                display: flex !important;
                flex-wrap: wrap !important;
                align-items: center;
                gap: 4px 0;
                margin-bottom: 1rem !important;
            }

            .admin-top-tools-menu .item {
                white-space: nowrap;
            }

            @media (max-width: 900px) {
                .admin-top-tools-menu .item {
                    padding: 10px 12px !important;
                    font-size: 14px;
                }
            }
        </style>
    {% endblock %}

    {% block head_javascripts %}
        {{ encore_entry_script_tags('admin-entry', null, 'admin') }}
        {{ encore_entry_script_tags('app-admin-entry', null, 'app.admin') }}
    {% endblock %}
</head>

<body {{ rtl.default(sylius.localeCode) }}>
    <div class="admin-layout" id="adminLayout">
        <div class="admin-layout__sidebar">
            <div class="admin-layout__nav">
                {% block sidebar %}
                    {{ knp_menu_render('sylius.admin.main', {
                        template: '@SyliusUi/Menu/sidebar.html.twig',
                        currentClass: 'active'
                    }) }}
                {% endblock %}

                <div class="admin-layout__toggle" data-layout-toggle>
                    <i class="close icon"></i>
                </div>
            </div>
        </div>

        <div class="admin-layout__body">
            <div class="admin-layout__topbar">
                <div class="ui borderless menu">
                    {% block topbar %}
                        {{ knp_menu_render('sylius.admin.topbar', {
                            template: '@SyliusUi/Menu/topbar.html.twig'
                        }) }}
                    {% endblock %}
                </div>
            </div>

            <div class="admin-layout__content">
                {% block flash_messages %}
                    {% include '@SyliusUi/_flashes.html.twig' %}
                {% endblock %}

                {% block pre_content %}
                    {% include '@SyliusAdmin/Layout/Menu/_top_admin_menu.html.twig' %}
                {% endblock %}

                {% block content %}{% endblock %}
                {% block post_content %}{% endblock %}
            </div>

            <div class="admin-layout__footer">
                {% block footer %}{% endblock %}
            </div>
        </div>
    </div>

    {% include '@SyliusUi/Modal/_confirmation.html.twig' %}

    <script>
    (function () {
        function initSidebarToggle() {
            const layout = document.getElementById('adminLayout');
            if (!layout) return;

            const buttons = document.querySelectorAll('[data-layout-toggle]');
            if (!buttons.length) return;

            const STORAGE_KEY = 'sylius:layout';
            const BREAKPOINT = 768;

            function isDesktop() {
                return window.innerWidth > BREAKPOINT;
            }

            function readState() {
                const saved = sessionStorage.getItem(STORAGE_KEY);
                if (saved === null) {
                    return isDesktop();
                }
                return saved === 'true';
            }

            function applyState(isOpen) {
                layout.classList.toggle('admin-layout--open', !!isOpen);
                sessionStorage.setItem(STORAGE_KEY, isOpen ? 'true' : 'false');
            }

            applyState(readState());

            buttons.forEach((button) => {
                if (button.dataset.sidebarBound === '1') return;
                button.dataset.sidebarBound = '1';

                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    const isOpen = layout.classList.contains('admin-layout--open');
                    applyState(!isOpen);
                });
            });
        }

        document.addEventListener('DOMContentLoaded', initSidebarToggle);
        document.addEventListener('turbo:load', initSidebarToggle);
        window.addEventListener('pageshow', initSidebarToggle);
    })();
    </script>

    {% block javascripts %}{% endblock %}
</body>
</html>
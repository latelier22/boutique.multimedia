{% for taxon in front_taxons() %}
    {% set products = products_by_taxon_slug(taxon.slug, app.request.locale) %}
 {% set min = lowest_price_by_taxon(taxon) %}
   
    {% if products is not empty %}
       
        {% set url = path('sylius_shop_product_index', {'slug': taxon.slug, '_locale': app.request.locale}) ~ '?sorting%5Bprice%5D=asc' %}
        <a href="{{ url }}">
            <span class="mobiles-link-highlight" style="display:inline-block;width:100%;height:100%;">
                <style>
                    .mobiles-link-highlight {
                        border-radius: 16px;
                        transition: background 0.2s, border 0.2s;
                    }
                    a:hover .mobiles-link-highlight {
                        background: #f0f4fa;
                        border: 2px solid #b5c7d3;
                    }
                </style>
              <h2 class="ui center aligned huge header">
    {{ taxon.name }}
    {% if min is not null %}
        <span style="display:block; font-size: 0.8em; color: #2185d0; font-style: italic;">
            À partir de {{ (min / 100)|number_format(2, ',', ' ') }} €
        </span>
    {% endif %}
</h2>

                
            </span>
        </a>    
        <h3 class="ui aligned header">{{ taxon.description }}</h3>
        <div class="ui hidden divider"></div>

        {% include '@SyliusShop/Homepage/_carousel.html.twig' with { products: products } %}
    {% endif %}
{% endfor %}

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width,initial-scale=1">
		<title>Tablette – Diaporama</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
		<style>:root
		{
			--bg: #04060a;
			--text: #EAF0FF;
			--muted: rgba(234, 240, 255, .72);
			--stroke: rgba(255, 255, 255, .12);
			--blue: #2F5FB8;
			--blue2: #7FA6E6;
			--gold: #D6B04D;
			--r: 18px
		}
		* {
			box-sizing: border-box
		}
		body {
			margin: 0;
			background: var(--bg);
			color: var(--text);
			font-family: Inter, system-ui, Segoe UI, Roboto, Arial;
			overflow: hidden
		}
		.stage {
			position: fixed;
			inset: 0;
			background: radial-gradient(900px 500px at 18% 10%, rgba(47,95,184,.22), transparent 60%), radial-gradient(900px 520px at 85% 15%, rgba(214, 176, 77, 0.14), transparent 60%), #04060a
		}
		.imgWrap {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 6vh 5vw
		}
		.img {
			max-width: 100%;
			max-height: 100%;
			object-fit: contain;
			filter:drop-shadow(0 18px 60px rgba(0, 0, 0, 0.55))
		}
		.topbar {
			position: absolute;
			top: 16px;
			left: 16px;
			right: 16px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 12px;
			z-index: 5;
			pointer-events: none
		}
		.brand {
			display: flex;
			align-items: center;
			gap: 12px;
			padding: 10px 12px;
			border: 1px solid var(--stroke);
			border-radius: var(--r);
			background: rgba(0, 0, 0, .22);
			backdrop-filter:blur(10px);
			pointer-events: auto
		}
		.brand img {
			height: 34px;
			width: auto;
			object-fit: contain
		}
		.brand .t {
			font-family: Rajdhani, Inter, system-ui;
			font-size: 16px;
			margin: 0;
			letter-spacing: 0.4px
		}
		.brand .s {
			margin: 2px 0 0;
			font-size: 12px;
			color: var(--muted)
		}
		.statusPill {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			padding: 10px 12px;
			border: 1px solid var(--stroke);
			border-radius: 999px;
			background: rgba(0, 0, 0, .22);
			backdrop-filter:blur(10px);
			font-size: 13px;
			color: var(--muted);
			pointer-events: auto;
			user-select: none
		}
		.dot {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: var(--gold);
			box-shadow: 0 0 0 3px rgba(214, 176, 77, .16)
		}
		.overlay {
			position: absolute;
			left: 0;
			right: 0;
			bottom: 0;
			padding: 40px 24px 24px;
			background: linear-gradient(to top, rgba(0,0,0,.88), rgba(0,0,0,.35), transparent);
			z-index: 4;
			pointer-events: none
		}
		.content {
			width: min(1100px, 100%);
			margin: 0 auto
		}
		.title {
			font-family: Rajdhani, Inter, system-ui;
			font-size: clamp(28px, 4.5vw, 56px);
			font-weight: 700;
			letter-spacing: 0.4px;
			margin: 0;
			text-shadow: 0 6px 24px rgba(0, 0, 0, .55)
		}
		.priceRow {
			margin-top: 10px;
			display: flex;
			gap: 14px;
			align-items: baseline;
			flex-wrap: wrap
		}
		.price {
			font-size: clamp(26px, 3.2vw, 44px);
			font-weight: 700
		}
		.oldPrice {
			font-size: 18px;
			opacity: .70;
			text-decoration: line-through
		}
		.badge {
			display: inline-flex;
			align-items: center;
			padding: 6px 10px;
			border-radius: 999px;
			background: rgba(214, 176, 77, .18);
			border: 1px solid rgba(214, 176, 77, .35);
			font-weight: 600;
			font-size: 13px
		}
		.actions {
			position: absolute;
			right: 16px;
			bottom: 16px;
			display: flex;
			gap: 10px;
			z-index: 6;
			pointer-events: auto
		}
		.btn {
			border: 1px solid var(--stroke);
			background: rgba(0, 0, 0, .22);
			color: var(--text);
			padding: 12px 14px;
			border-radius: 14px;
			cursor: pointer;
			font-weight: 700;
			font-family: Rajdhani, Inter, system-ui;
			letter-spacing: 0.3px;
			display: inline-flex;
			align-items: center;
			gap: 10px;
			backdrop-filter:blur(10px)
		}
		.btn-primary {
			background: linear-gradient(180deg, rgba(47,95,184,.92), rgba(47,95,184,.52));
			border-color: rgba(127, 166, 230, .30)
		}
		.btn svg {
			width: 18px;
			height: 18px;
			opacity: .95
		}
		.hint {
			position: absolute;
			left: 16px;
			bottom: 16px;
			padding: 10px 12px;
			border: 1px solid var(--stroke);
			border-radius: 14px;
			background: rgba(0, 0, 0, .22);
			backdrop-filter:blur(10px);
			color: rgba(234, 240, 255, .65);
			font-size: 12px;
			z-index: 6;
			pointer-events: none
		}
		.newBanner {
			position: absolute;
			top: 84px;
			left: 16px;
			padding: 10px 14px;
			border-radius: 999px;
			background: linear-gradient(180deg, rgba(214,176,77,.95), rgba(214,176,77,.55));
			border: 1px solid rgba(214, 176, 77, .55);
			color: #0b0f14;
			font-family: Rajdhani, Inter, system-ui, sans-serif;
			font-weight: 800;
			letter-spacing: 0.6px;
			box-shadow: 0 12px 40px rgba(0, 0, 0, .35);
			z-index: 7;
			display: none;
		}
		.newBanner.show {
			display: inline-flex;
			align-items: center;
			gap: 10px;
		}
		.newBanner .spark {
			width: 10px;
			height: 10px;
			border-radius: 50%;
			background: #0b0f14;
			opacity: .9;
		}
		.grid9 {
			position: absolute;
			inset: 0;
			padding: 16px;
			z-index: 3;
			display: none;
		}

		.grid9.show {
			display: block;
		}

		.grid9Inner {
			height: 100%;
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			grid-template-rows: repeat(3, 1fr);
			gap: 12px;
		}

		.gridCard {
			border: 1px solid var(--stroke);
			border-radius: var(--r);
			background: rgba(0, 0, 0, .22);
			backdrop-filter: blur(10px);
			overflow: hidden;
			display: flex;
			flex-direction: column;
			min-height: 0;
		}

		.gridCard .ph {
			flex: 1 1 auto;
			min-height: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 10px;
		}

		.gridCard img {
			max-width: 100%;
			max-height: 100%;
			object-fit: contain;
			filter: drop-shadow(0 10px 35px rgba(0,0,0,.45));
		}

		.gridCard .meta {
			padding: 10px 12px;
			border-top: 1px solid var(--stroke);
			display: flex;
			justify-content: space-between;
			gap: 10px;
			align-items: baseline;
		}

		.gridCard .name {
			font-family: Rajdhani, Inter, system-ui, sans-serif;
			font-weight: 800;
			letter-spacing: 0.3px;
			font-size: 14px;
			line-height: 1.1;
			overflow: hidden;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
		}

		.gridCard .p {
			font-weight: 800;
			white-space: nowrap;
			font-size: 14px;
		}

		.imgWrap {
			position: absolute;
			inset: 0;
			z-index: 1;
		} /* <= AJOUTE z-index */
		.overlay {
			z-index: 2;
		} /* (ton overlay est déjà z-index:4, ok) */

		.grid9 {
			position: absolute;
			inset: 0;
			padding: 16px;
			z-index: 9; /* <= AU DESSUS DE TOUT */
			display: none;
			pointer-events: auto; /* <= important */
		}

		.grid9.show {
			display: block;
		}

		/* Mobile: 2x? (optionnel) */
		@media(max-width:740px) {
			.grid9Inner {
				grid-template-columns: repeat(2, 1fr);
				grid-template-rows: auto;
			}
		}
		@media(max-width:740px) {
			.actions {
				left: 16px;
				right: 16px;
				justify-content: space-between
			}
			.btn {
				width: calc(50% - 5px);
				justify-content: center
			}
		}
	</style>
</head>

<body>
	<main class="stage" id="stage">
		<div class="imgWrap"><img id="img" class="img" alt="Produit"></div>
		<div class="grid9" id="grid9" aria-hidden="true">
			<div class="grid9Inner" id="grid9Inner"></div>
		</div>

		<div class="topbar">
			<div class="brand">
				<img src="{{ asset('build/app/shop/images/logo-multimedia-services.71b1b6d1.png') }}" alt="Multimédia Services">
				<div>
					<p class="t">Multimédia Services</p>
					<p class="s">Tablette – Diaporama</p>
				</div>
			</div>
			<div class="statusPill">
				<span class="dot"></span>
				<span id="wsState">Connexion…</span>
			</div>
		</div>

		<section class="overlay">
			<div class="content">
				<h1 class="title" id="title">Chargement…</h1>
				<div class="priceRow">
					<div class="price" id="price">—</div>
					<div class="oldPrice" id="oldPrice" style="display:none">—</div>
					<div class="badge" id="badge" style="display:none">Promo</div>
				</div>
			</div>
		</section>

		<div class="hint">Tap/clic : produit suivant</div>

		<div class="actions">
			<form method="post" action="{{ path('tablet_logout') }}" style="margin:0">
				<button class="btn" type="submit">Verrouiller</button>
			</form>
			<button class="btn btn-primary" id="btn-reco" type="button">Reconnecter</button>
		</div>

		<div id="newBanner" class="newBanner">
			<span class="spark"></span>
			NOUVEAU
		</div>
	</main>

	{# <audio id="newSound" preload="auto">
		<source src="/sounds/mixkit-game-level-completed-2059.wav" type="audio/wav">
	</audio> #}
	<script>
		(function () {
const API_PRODUCTS = "{{ path('tablet_products') }}";

// ====== CYCLE ======
const GRID_COUNT = 9; // 3x3
const GRID_SHOW_MS = 3000; // durée d’affichage grille
const SLIDE_MS = 5000; // durée par produit (diapo)
const REFRESH_MS = 60000; // refresh API produits

const device = {{ device|json_encode|raw }};
const token = {{ token|json_encode|raw }};

// ====== DOM ======
const stage = document.getElementById("stage");
const imgEl = document.getElementById("img");
const titleEl = document.getElementById("title");
const priceEl = document.getElementById("price");
const oldPriceEl = document.getElementById("oldPrice");
const badgeEl = document.getElementById("badge");
const wsStateEl = document.getElementById("wsState");
const btnReco = document.getElementById("btn-reco");

const newBannerEl = document.getElementById("newBanner");
const newSound = document.getElementById("newSound");

const grid9 = document.getElementById("grid9");
const grid9Inner = document.getElementById("grid9Inner");

// ====== AUDIO ======
let audioUnlocked = false;
let audioCtx = null;

function unlockAudio() {
if (audioUnlocked) 
return true;


try {
if (newSound) {
newSound.muted = true;
// const p = newSound.play();
if (p && p.then) {
p.then(() => {
newSound.pause();
newSound.currentTime = 0;
newSound.muted = false;
audioUnlocked = true;
}).catch(() => {});
}
}
} catch (e) {}

try {
const Ctx = window.AudioContext || window.webkitAudioContext;
if (Ctx && ! audioCtx) 
audioCtx = new Ctx();

if (audioCtx && audioCtx.state === "suspended") 
audioCtx.resume();

if (audioCtx && audioCtx.state === "running") 
audioUnlocked = true;

} catch (e) {}

return audioUnlocked;
}["pointerdown", "mousedown", "touchstart", "keydown"].forEach((evt) => {
document.addEventListener(evt, unlockAudio, {
once: true,
passive: true
});
});

function beep() {
if (! audioUnlocked) 
return;

try {
const Ctx = window.AudioContext || window.webkitAudioContext;
if (! Ctx) 
return;

if (! audioCtx) 
audioCtx = new Ctx();

if (audioCtx.state === "suspended") 
audioCtx.resume();


const o = audioCtx.createOscillator();
const g = audioCtx.createGain();
o.type = "sine";
o.frequency.value = 880;
g.gain.value = 0.08;

o.connect(g);
g.connect(audioCtx.destination);

o.start();
setTimeout(() => {
try {
o.stop();
} catch (e) {}
}, 180);
} catch (e) {}
}

function playNewSound() {
try {
document.body.style.transition = "background 0.2s ease";
document.body.style.background = "#1c2e52";
setTimeout(() => {
document.body.style.background = "";
}, 250);

if (! unlockAudio()) 
return;


if (newSound) {
newSound.pause();
newSound.currentTime = 0;
newSound.volume = 1.0;
newSound.play().catch(() => beep());
} else {
beep();
}
} catch (e) {}
}

// ====== HELPERS ======
function formatPrice(p) {
const n = Number(p ?? 0);
if (Number.isNaN(n)) 
return "—";

return n.toFixed(2).replace(".", ",") + " €";
}

function proxify(url) {
if (! url) 
return "";

if (url.includes("multimediaservices22.hiboutik.com/api/products_images/")) {
return "https://shop.multimedia-services.fr/api/hiboutik/image?src=" + encodeURIComponent(url);
}
return url;
}

function pickFirstNonEmpty(arr) {
if (!Array.isArray(arr)) 
return "";

for (const u of arr) {
const s = String(u ?? "").trim();
if (s) 
return s;

}
return "";
}

function firstImageRaw(p) {
const list = Array.isArray(p ?. images) ? p.images : [];
return(String(p ?. image ?? "").trim() || String(p ?. thumb ?? "").trim() || pickFirstNonEmpty(list));
}

function firstImage(p) {
const raw = firstImageRaw(p);
return String(proxify(raw) ?? "").trim();
}

function hasImage(p) {
return !! firstImage(p);
}

function normalizeProducts(list) { // Dédoublonnage + garde le plus récent
const map = new Map();
for (const p of(Array.isArray(list) ? list : [])) {
const id = Number(p ?. product_id || 0);
if (! id) 
continue;


if (! map.has(id)) 
map.set(id, p);
 else {
const a = String(map.get(id) ?. updated_at ?? "");
const b = String(p ?. updated_at ?? "");
if (b && (! a || b > a)) 
map.set(id, p);

}
}
// Filtre strict : PAS de produits sans image
return Array.from(map.values()).filter(hasImage);
}

function escapeHtml(s) {
return String(s).replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#039;");
}

// ====== STATE ======
let products = [];
let index = 0;

let mode = "grid"; // "grid" | "slide"
let cycleStep = 0; // compteur slides dans un cycle complet

let slideTimer = null;
let refreshTimer = null;
let gridTimer = null;
let highlightTimer = null;

// 🔒 Lock grille : tant que grille visible, aucun event ne peut la fermer
let gridLockUntil = 0;

// Event SSE en attente (le dernier gagne)
let pendingFocusId = 0;

function nowMs() {
return Date.now();
}

function showNewBanner(ms = 8000) {
if (! newBannerEl) 
return;

newBannerEl.classList.add("show");
if (highlightTimer) 
clearTimeout(highlightTimer);

highlightTimer = setTimeout(() => newBannerEl.classList.remove("show"), ms);
}

// ====== GRID ======
function buildGrid() {
if (! grid9 || ! grid9Inner) 
return;


const slice = products.slice(0, GRID_COUNT);

grid9Inner.innerHTML = slice.map((p) => {
const img = firstImage(p);
const hasPromo = (p ?. product_discount_price ?? "0") !== "0" && Number(p ?. product_discount_price) > 0;

const price = formatPrice(hasPromo ? p.product_discount_price : p.product_price);
const name = String(p ?. product_model ?? "Produit");

return `
        <div class="gridCard">
          <div class="ph"><img src="${img}" alt="${
escapeHtml(name)
}"></div>
          <div class="meta">
            <div class="name">${
escapeHtml(name)
}</div>
            <div class="p">${
escapeHtml(price)
}</div>
          </div>
        </div>
      `;
}).join("");
}

function hideGrid() {
if (gridTimer) {
clearTimeout(gridTimer);
gridTimer = null;
}
if (grid9) 
grid9.classList.remove("show");

}

function showGrid() {
mode = "grid";
stopSlide();

buildGrid();
if (grid9) 
grid9.classList.add("show");


// 🔒 lock
gridLockUntil = nowMs() + GRID_SHOW_MS;

if (gridTimer) 
clearTimeout(gridTimer);

gridTimer = setTimeout(() => {
hideGrid();
startCycleSlides(); // démarrage diapo après la grille
}, GRID_SHOW_MS);

console.log("[GRID] show for", GRID_SHOW_MS, "ms");
}

// ====== SLIDESHOW ======
function stopSlide() {
if (slideTimer) 
clearInterval(slideTimer);

slideTimer = null;
}

function render(i) {
if (! products.length) {
hideGrid();
titleEl.textContent = "Aucun produit (avec image) en stock";
priceEl.textContent = "—";
oldPriceEl.style.display = "none";
badgeEl.style.display = "none";
imgEl.removeAttribute("src");
imgEl.alt = "";
stopSlide();
return;
}

index = ((i % products.length) + products.length) % products.length;
const p = products[index];

const img = firstImage(p);
if (img) 
imgEl.src = img;
 else 
imgEl.removeAttribute("src");
 // sécurité (normalement impossible car filtré)

imgEl.alt = p ?. product_model ?? "Produit";
titleEl.textContent = p ?. product_model ?? "Produit";

const hasPromo = (p ?. product_discount_price ?? "0") !== "0" && Number(p ?. product_discount_price) > 0;

const priceStr = hasPromo ? p.product_discount_price : p.product_price;
priceEl.textContent = formatPrice(priceStr);

if (hasPromo) {
oldPriceEl.style.display = "";
oldPriceEl.textContent = formatPrice(p.product_price);
badgeEl.style.display = "";
} else {
oldPriceEl.style.display = "none";
badgeEl.style.display = "none";
}

if (products.length > 1) {
const nextP = products[(index + 1) % products.length];
const nextImg = firstImage(nextP);
if (nextImg) {
const pre = new Image();
pre.src = nextImg;
}
}
}

function startCycleSlides() {
mode = "slide";
cycleStep = 0;

// ✅ Si un product_updated est arrivé pendant la grille : on démarre dessus
if (pendingFocusId) {
const idx = products.findIndex(p => Number(p ?. product_id) === Number(pendingFocusId));
if (idx >= 0) {
console.log("[SSE] applying pending focus:", pendingFocusId);
index = idx;
}
pendingFocusId = 0;
}

render(index);

stopSlide();
if (products.length > 1) {
slideTimer = setInterval(() => nextSlide(), SLIDE_MS);
}

console.log("[SLIDE] start cycle, products=", products.length);
}

function nextSlide() {
render(index + 1);
cycleStep++;

// fin de cycle => on a affiché N produits
if (products.length > 0 && cycleStep >= products.length) {
index = 0;
showGrid(); // <= la grille revient à chaque cycle
}
}

// clic : uniquement en mode slide (pendant grille -> rien)
stage.addEventListener("click", () => {
if (mode !== "slide") 
return;

if (products.length > 1) 
nextSlide();

});

// ====== LOAD PRODUCTS ======
async function loadProducts({
focusId = 0,
forceRestart = false
} = {}) {
try {
const res = await fetch(API_PRODUCTS, {cache: "no-store"});
if (! res.ok) 
throw new Error("HTTP " + res.status);

const json = await res.json();

const raw = Array.isArray(json ?. data) ? json.data : [];
products = normalizeProducts(raw);

console.log(`[DATA] raw=${
raw.length
} kept(with image)=${
products.length
}`);

if (! products.length) {
render(0);
return;
}

if (index >= products.length) 
index = 0;


// focus demandé (SSE)
if (focusId) { // 🔒 si grille lock : on stocke et on applique après la grille
if (nowMs() < gridLockUntil || mode === "grid") {
pendingFocusId = Number(focusId);
console.log("[SSE] focus queued (grid locked):", pendingFocusId);
return; // IMPORTANT: ne ferme pas la grille
}

// sinon appliquer direct
const idx = products.findIndex(p => Number(p ?. product_id) === Number(focusId));
if (idx >= 0) {
index = idx;
render(index);
showNewBanner(8000);
// on repart sur un cycle propre
stopSlide();
startCycleSlides();
}
return;
}

if (forceRestart) {
index = 0;
showGrid();
return;
}

// refresh normal : ne casse pas la grille si elle est lock
if (mode === "grid") {
buildGrid(); // met à jour le contenu sans reset timer
} else {
render(index);
}
} catch (e) {
console.error(e);
hideGrid();
titleEl.textContent = "Impossible de charger les produits";
priceEl.textContent = "Vérifier la connexion";
oldPriceEl.style.display = "none";
badgeEl.style.display = "none";
imgEl.removeAttribute("src");
stopSlide();
}
}

function startRefresh() {
if (refreshTimer) 
clearInterval(refreshTimer);

refreshTimer = setInterval(() => loadProducts({}), REFRESH_MS);
}

// ====== SSE (refresh + son) ======
let es = null;
function connectSSE() {
try {
if (es) {
try {
es.close();

// ====== WS (redirect only) ======
let ws = null,
retry = 0,
retryTimer = null,
pingTimer = null;
const PING_EVERY_MS = 20000;

function wsUrl() {
const proto = (location.protocol === "https:") ? "wss" : "ws";
return `${proto}://${
location.host
}/ws-tablet?device=${
encodeURIComponent(device)
}&token=${
encodeURIComponent(token)
}`;
}

function setWsState(t) {
wsStateEl.textContent = t;
}

function clearWsTimers() {
if (retryTimer) 
clearTimeout(retryTimer);

if (pingTimer) 
clearInterval(pingTimer);

retryTimer = null;
pingTimer = null;
}

function startPing() {
pingTimer = setInterval(() => {
try {
if (ws && ws.readyState === 1) 
ws.send(JSON.stringify({type: "ping", t: Date.now()}));

} catch (e) {}
}, PING_EVERY_MS);
}

function scheduleReconnect() {
clearWsTimers();
const delay = Math.min(15000, Math.round(800 * Math.pow(2, retry)));
retry = Math.min(retry + 1, 6);
setWsState("Hors ligne");
retryTimer = setTimeout(connectWs, delay);
}

function connectWs() {
clearWsTimers();

try {
if (ws && (ws.readyState === 0 || ws.readyState === 1)) 
ws.close();

} catch (e) {}setWsState("Connexion…");

try {
ws = new WebSocket(wsUrl());
} catch (e) {
scheduleReconnect();
return;
}

ws.onopen = () => {
retry = 0;
setWsState("Connecté");
startPing();
};
ws.onerror = () => setWsState("Instable");
ws.onclose = () => scheduleReconnect();

ws.onmessage = (e) => {
try {
const msg = JSON.parse(e.data);
if (msg && msg.url) 
location.href = msg.url;

} catch (err) {}
};
}

btnReco.addEventListener("click", () => {
retry = 0;
connectWs();
loadProducts({forceRestart: true});
});

document.addEventListener("visibilitychange", () => {
if (!document.hidden && (! ws || ws.readyState === 3)) 
connectWs();

});

// ====== INIT ======

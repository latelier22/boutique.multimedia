:root {
        --bg: #04060a;
        --text: #EAF0FF;
        --muted: rgba(234, 240, 255, .72);
        --stroke: rgba(255, 255, 255, .12);
        --blue: #2F5FB8;
        --blue2: #7FA6E6;
        --gold: #D6B04D;
        --r: 18px;
    }

    * { box-sizing: border-box; }

    body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: Inter, system-ui, Segoe UI, Roboto, Arial;
        overflow: hidden;
    }

    .stage {
        position: fixed;
        inset: 0;
        background:
            radial-gradient(900px 500px at 18% 10%, rgba(47,95,184,.22), transparent 60%),
            radial-gradient(900px 520px at 85% 15%, rgba(214,176,77,.14), transparent 60%),
            #04060a;
    }

    .imgWrap {
        position: absolute;
        inset: 0;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 6vh 5vw;
        transition: padding .25s ease;
    }

    .img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 18px 60px rgba(0, 0, 0, 0.55));
    }

    .topbar {
        position: absolute;
        top: 16px;
        left: 16px;
        right: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        z-index: 10;
        pointer-events: none;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border: 1px solid var(--stroke);
        border-radius: var(--r);
        background: rgba(0, 0, 0, .22);
        backdrop-filter: blur(10px);
        pointer-events: auto;
    }

    .brand img {
        height: 34px;
        width: auto;
        object-fit: contain;
    }

    .brand .t {
        font-family: Rajdhani, Inter, system-ui;
        font-size: 16px;
        margin: 0;
        letter-spacing: .4px;
    }

    .brand .s {
        margin: 2px 0 0;
        font-size: 12px;
        color: var(--muted);
    }

    .statusPill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        border: 1px solid var(--stroke);
        border-radius: 999px;
        background: rgba(0, 0, 0, .22);
        backdrop-filter: blur(10px);
        font-size: 13px;
        color: var(--muted);
        pointer-events: auto;
        user-select: none;
    }

    .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--gold);
        box-shadow: 0 0 0 3px rgba(214,176,77,.16);
    }

    .overlay {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 40px 24px 24px;
        background: linear-gradient(to top, rgba(0,0,0,.88), rgba(0,0,0,.35), transparent);
        z-index: 4;
        pointer-events: none;
    }

    .content {
        width: min(1100px, 100%);
        margin: 0 auto;
    }

    .title {
        font-family: Rajdhani, Inter, system-ui;
        font-size: clamp(28px, 4.5vw, 56px);
        font-weight: 700;
        letter-spacing: .4px;
        margin: 0;
        text-shadow: 0 6px 24px rgba(0, 0, 0, .55);
    }

    .priceRow {
        margin-top: 10px;
        display: flex;
        gap: 14px;
        align-items: baseline;
        flex-wrap: wrap;
    }

    .price {
        font-size: clamp(26px, 3.2vw, 44px);
        font-weight: 700;
    }

    .oldPrice {
        font-size: 18px;
        opacity: .7;
        text-decoration: line-through;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(214,176,77,.18);
        border: 1px solid rgba(214,176,77,.35);
        font-weight: 600;
        font-size: 13px;
    }

    .actions {
        position: absolute;
        right: 16px;
        bottom: 16px;
        display: flex;
        gap: 10px;
        z-index: 10;
        pointer-events: auto;
    }

    .btn {
        border: 1px solid var(--stroke);
        background: rgba(0, 0, 0, .22);
        color: var(--text);
        padding: 12px 14px;
        border-radius: 14px;
        cursor: pointer;
        font-weight: 700;
        font-family: Rajdhani, Inter, system-ui;
        letter-spacing: .3px;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        backdrop-filter: blur(10px);
    }

    .btn-primary {
        background: linear-gradient(180deg, rgba(47,95,184,.92), rgba(47,95,184,.52));
        border-color: rgba(127,166,230,.30);
    }

    .hint {
        position: absolute;
        left: 16px;
        bottom: 16px;
        padding: 10px 12px;
        border: 1px solid var(--stroke);
        border-radius: 14px;
        background: rgba(0, 0, 0, .22);
        backdrop-filter: blur(10px);
        color: rgba(234,240,255,.65);
        font-size: 12px;
        z-index: 10;
        pointer-events: none;
    }

    .newBanner {
        position: absolute;
        top: 84px;
        left: 16px;
        padding: 10px 14px;
        border-radius: 999px;
        background: linear-gradient(180deg, rgba(214,176,77,.95), rgba(214,176,77,.55));
        border: 1px solid rgba(214,176,77,.55);
        color: #0b0f14;
        font-family: Rajdhani, Inter, system-ui, sans-serif;
        font-weight: 800;
        letter-spacing: .6px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, .35);
        z-index: 11;
        display: none;
    }

    .newBanner.show {
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .newBanner .spark {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #0b0f14;
        opacity: .9;
    }

    .grid9 {
        position: absolute;
        inset: 0;
        padding: 16px;
        z-index: 9;
        display: none;
        pointer-events: auto;
    }

    .grid9.show {
        display: block;
    }

    .grid9Inner {
        height: 100%;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(3, 1fr);
        gap: 12px;
    }

    .gridCard {
        border: 1px solid var(--stroke);
        border-radius: var(--r);
        background: rgba(0, 0, 0, .22);
        backdrop-filter: blur(10px);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    .gridCard .ph {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px;
    }

    .gridCard img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 10px 35px rgba(0,0,0,.45));
    }

    .gridCard .meta {
        padding: 10px 12px;
        border-top: 1px solid var(--stroke);
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: baseline;
    }

    .gridCard .name {
        font-family: Rajdhani, Inter, system-ui, sans-serif;
        font-weight: 800;
        letter-spacing: .3px;
        font-size: 14px;
        line-height: 1.1;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .gridCard .p {
        font-weight: 800;
        white-space: nowrap;
        font-size: 14px;
    }

    .labelMode .overlay {
	display: none;
}

.bootLoader {
	position: fixed;
	inset: 0;
	z-index: 9999;
	display: none;
	align-items: center;
	justify-content: center;
	background:
		radial-gradient(900px 500px at 18% 10%, rgba(47,95,184,.16), transparent 60%),
		radial-gradient(900px 520px at 85% 15%, rgba(214,176,77,.10), transparent 60%),
		#04060a;
}

.bootLoader.show {
	display: flex;
}

.bootLoader__card {
	min-width: 320px;
	max-width: 90vw;
	background: #fff;
	color: #1d2a3a;
	border-radius: 24px;
	padding: 28px 26px;
	box-shadow: 0 18px 50px rgba(20,49,96,.18);
	border: 1px solid #d9e2f0;
	display: flex;
	flex-direction: column;
	align-items: center;
	text-align: center;
}

.bootLoader__spinner {
	width: 58px;
	height: 58px;
	border-radius: 50%;
	border: 6px solid rgba(239,108,0,.18);
	border-top-color: #ef6c00;
	animation: msSpin .9s linear infinite;
	margin-bottom: 18px;
}

.bootLoader__title {
	font-size: 24px;
	font-weight: 800;
	color: #1f4ea8;
	margin-bottom: 6px;
}

.bootLoader__text {
	font-size: 15px;
	color: #5c6f8f;
}

@keyframes msSpin {
	to { transform: rotate(360deg); }
}

/* on masque l'écran tant que ça boot */
.stage.isBooting .imgWrap,
.stage.isBooting .overlay,
.stage.isBooting .grid9,
.stage.isBooting .tablet-label,
.stage.isBooting .topbar,
.stage.isBooting .hint,
.stage.isBooting .actions,
.stage.isBooting .newBanner {
	visibility: hidden;
}

/* fond orange quand la grille est affichée */
.stage.gridMode {
	background:
		radial-gradient(900px 500px at 18% 10%, rgba(255,255,255,.10), transparent 60%),
		radial-gradient(900px 520px at 85% 15%, rgba(0,0,0,.08), transparent 60%),
		linear-gradient(180deg, #ef6c00 0%, #d85f00 100%);
}
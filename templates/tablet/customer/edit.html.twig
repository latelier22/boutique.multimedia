{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'tablet/tablet/tablet_css.html.twig' %}

    <style>
        .tablet-auto-return {
            background: #eff6ff;
            border: 2px solid #93c5fd;
            color: #1e3a8a;
            border-radius: 18px;
            padding: 18px 20px;
            margin-bottom: 18px;
            text-align: center;
        }

        .tablet-auto-return-title {
            font-size: 1.4rem;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .tablet-auto-return-count {
            font-size: 3rem;
            line-height: 1;
            font-weight: 900;
            margin: 8px 0;
        }

        .tablet-auto-return-text {
            font-size: 1rem;
            font-weight: 600;
        }
    </style>
{% endblock %}

{% block body %}

<div class="tablet-page">
    <div class="tablet-shell">
        <div class="tablet-card">

            <div class="tablet-header">
                <div class="tablet-header-top">
                    <div class="tablet-logo-box">
                        <img src="{{ asset('logo-multimedia.png') }}" alt="Logo Multimédia Services">
                    </div>

                    <div class="tablet-title-wrap">
                        <div class="tablet-brand">MULTIMÉDIA SERVICES &amp; CASH</div>
                        <div class="tablet-subtitle">Achat - Vente - Réparation</div>
                        <span class="tablet-chip">Fiche client</span>
                        <span class="tablet-chip">Client #{{ customer.customers_id }}</span>
                    </div>
                </div>
            </div>

            <div class="tablet-content">

                {% if saved %}
                    <div class="tablet-auto-return">
                        <div class="tablet-auto-return-title">Enregistrement effectué</div>
                        <div class="tablet-auto-return-count">
                            <span id="returnCountdown">5</span>
                        </div>
                        <div class="tablet-auto-return-text">
                            Retour automatique en cours…
                        </div>
                    </div>
                {% endif %}

                {% for message in app.flashes('success') %}
                    <div class="tablet-flash tablet-flash-success">{{ message }}</div>
                {% endfor %}

                {% for message in app.flashes('error') %}
                    <div class="tablet-flash tablet-flash-error">{{ message }}</div>
                {% endfor %}

                <form method="post" id="customerForm" class="tablet-stack">
                    <div class="tablet-section">
                        <h2 class="tablet-section-title">Informations client</h2>

                        <div class="tablet-grid">
                            <div class="tablet-field">
                                <label>Nom</label>
                                <input class="tablet-input" name="last_name" value="{{ customer.last_name ?? '' }}">
                            </div>

                            <div class="tablet-field">
                                <label>Prénom</label>
                                <input class="tablet-input" name="first_name" value="{{ customer.first_name ?? '' }}">
                            </div>

                            <div class="tablet-field tablet-field-full">
                                <label>Société</label>
                                <input class="tablet-input" name="company" value="{{ customer.company ?? '' }}">
                            </div>

                            <div class="tablet-field">
                                <label>Email</label>
                                <input class="tablet-input" name="email" value="{{ customer.email ?? '' }}" inputmode="email" autocomplete="email">
                            </div>

                            <div class="tablet-field">
                                <label>Téléphone</label>
                                <input class="tablet-input" name="phone" value="{{ customer.phone ?? '' }}" inputmode="tel" autocomplete="tel">
                            </div>

                            <div class="tablet-field tablet-field-full">
                                <label>Pays</label>
                                <input class="tablet-input" name="country" value="{{ customer.country ?? 'FRA' }}">
                            </div>
                        </div>
                    </div>

                    <div class="tablet-section">
                        <h2 class="tablet-section-title">Adresse</h2>

                        <div class="tablet-grid">
                            <div class="tablet-field tablet-field-full">
                                <label>Adresse</label>
                                <textarea class="tablet-textarea" name="address_address">{{ address.address ?? '' }}</textarea>
                            </div>

                            <div class="tablet-field">
                                <label>Code postal</label>
                                <input class="tablet-input" name="address_zip_code" value="{{ address.zip_code ?? '' }}">
                            </div>

                            <div class="tablet-field">
                                <label>Ville</label>
                                <input class="tablet-input" name="address_city" value="{{ address.city ?? '' }}">
                            </div>

                            <div class="tablet-field">
                                <label>Département / Région</label>
                                <input class="tablet-input" name="address_state" value="{{ address.state ?? '' }}">
                            </div>

                            <div class="tablet-field">
                                <label>Pays adresse</label>
                                <input class="tablet-input" name="address_country" value="{{ address.country ?? 'FRA' }}">
                            </div>
                        </div>
                    </div>

                    <div class="tablet-actions">
                        <button type="submit" id="saveBtn" class="tablet-btn tablet-btn-primary" {% if saved %}disabled{% endif %}>
                            {% if saved %}ENREGISTRÉ{% else %}ENREGISTRER{% endif %}
                        </button>

                        <a href="{{ path('tablet_wait', {device: 'TAB1'}) }}" class="tablet-btn tablet-btn-accent">
                            QUITTER
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const form = document.getElementById('customerForm');
    const btn = document.getElementById('saveBtn');
    if (!form || !btn) return;

    form.addEventListener('submit', function () {
        btn.disabled = true;
        btn.textContent = 'ENREGISTREMENT EN COURS...';
    });
})();
</script>

<script>
(function () {
    const form = document.querySelector('form');
    if (!form) return;

    const LIVE_URL = "{{ path('tablet_live_publish') }}";
    const DEVICE = "{{ app.request.query.get('device')|default('TAB1')|e('js') }}";
    const SCREEN = "customer_edit";
    const INTERVENTION_ID = "{{ intervention.id|default('')|e('js') }}";

    let timer = null;
    let lastPayload = '';

    function collectForm() {
        const data = {};

        form.querySelectorAll('input, textarea, select').forEach(el => {
            const key = el.name || el.id;
            if (!key) return;

            if (el.type === 'password') return;

            if (el.type === 'radio') {
                if (el.checked) {
                    data[key] = el.value;
                }
                return;
            }

            if (el.type === 'checkbox') {
                data[key] = !!el.checked;
                return;
            }

            data[key] = el.value ?? '';
        });

        return data;
    }

    async function publish(status = 'editing') {
        const payload = {
            device: DEVICE,
            screen: SCREEN,
            status,
            interventionId: INTERVENTION_ID || null,
            hiboutikCustomerId: form.querySelector('[name="customers_id"]')?.value || null,
            activeField: document.activeElement?.name || document.activeElement?.id || null,
            form: collectForm()
        };

        const raw = JSON.stringify(payload);

        if (status === 'editing' && raw === lastPayload) {
            return;
        }

        lastPayload = raw;

        try {
            await fetch(LIVE_URL, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: raw,
                keepalive: true
            });
        } catch (e) {
            console.error('[tablet-live-publish]', e);
        }
    }

    function schedulePublish() {
        clearTimeout(timer);
        timer = setTimeout(() => publish('editing'), 120);
    }

    form.addEventListener('input', schedulePublish);
    form.addEventListener('change', schedulePublish);
    form.addEventListener('focus', schedulePublish, true);

    window.addEventListener('pageshow', () => publish('opened'));
    form.addEventListener('submit', () => publish('saving'));
})();
</script>

{% if saved %}
<script>
(function () {
    const countdownNode = document.getElementById('returnCountdown');
    const waitUrl = "{{ path('tablet_wait', {device: 'TAB1'})|e('js') }}";
    let remaining = 5;

    const timer = setInterval(function () {
        remaining--;

        if (countdownNode) {
            countdownNode.textContent = String(Math.max(remaining, 0));
        }

        if (remaining <= 0) {
            clearInterval(timer);
            window.location.href = waitUrl;
        }
    }, 1000);
})();
</script>
{% endif %}

{% endblock %}
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Tablette – Diaporama</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
  <style>
    :root{--bg:#04060a;--text:#EAF0FF;--muted:rgba(234,240,255,.72);--stroke:rgba(255,255,255,.12);--blue:#2F5FB8;--blue2:#7FA6E6;--gold:#D6B04D;--r:18px}
    *{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,Segoe UI,Roboto,Arial;overflow:hidden}
    .stage{position:fixed;inset:0;background:radial-gradient(900px 500px at 18% 10%, rgba(47,95,184,.22), transparent 60%),radial-gradient(900px 520px at 85% 15%, rgba(214,176,77,.14), transparent 60%),#04060a}
    .imgWrap{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:6vh 5vw}
    .img{max-width:100%;max-height:100%;object-fit:contain;filter:drop-shadow(0 18px 60px rgba(0,0,0,.55))}
    .topbar{position:absolute;top:16px;left:16px;right:16px;display:flex;align-items:center;justify-content:space-between;gap:12px;z-index:5;pointer-events:none}
    .brand{display:flex;align-items:center;gap:12px;padding:10px 12px;border:1px solid var(--stroke);border-radius:var(--r);background:rgba(0,0,0,.22);backdrop-filter:blur(10px);pointer-events:auto}
    .brand img{height:34px;width:auto;object-fit:contain}
    .brand .t{font-family:Rajdhani,Inter,system-ui;font-size:16px;margin:0;letter-spacing:.4px}
    .brand .s{margin:2px 0 0;font-size:12px;color:var(--muted)}
    .statusPill{display:inline-flex;align-items:center;gap:8px;padding:10px 12px;border:1px solid var(--stroke);border-radius:999px;background:rgba(0,0,0,.22);backdrop-filter:blur(10px);font-size:13px;color:var(--muted);pointer-events:auto;user-select:none}
    .dot{width:8px;height:8px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px rgba(214,176,77,.16)}
    .overlay{position:absolute;left:0;right:0;bottom:0;padding:40px 24px 24px;background:linear-gradient(to top, rgba(0,0,0,.88), rgba(0,0,0,.35), transparent);z-index:4;pointer-events:none}
    .content{width:min(1100px,100%);margin:0 auto}
    .title{font-family:Rajdhani,Inter,system-ui;font-size:clamp(28px,4.5vw,56px);font-weight:700;letter-spacing:.4px;margin:0;text-shadow:0 6px 24px rgba(0,0,0,.55)}
    .priceRow{margin-top:10px;display:flex;gap:14px;align-items:baseline;flex-wrap:wrap}
    .price{font-size:clamp(26px,3.2vw,44px);font-weight:700}
    .oldPrice{font-size:18px;opacity:.70;text-decoration:line-through}
    .badge{display:inline-flex;align-items:center;padding:6px 10px;border-radius:999px;background:rgba(214,176,77,.18);border:1px solid rgba(214,176,77,.35);font-weight:600;font-size:13px}
    .actions{position:absolute;right:16px;bottom:16px;display:flex;gap:10px;z-index:6;pointer-events:auto}
    .btn{border:1px solid var(--stroke);background:rgba(0,0,0,.22);color:var(--text);padding:12px 14px;border-radius:14px;cursor:pointer;font-weight:700;font-family:Rajdhani,Inter,system-ui;letter-spacing:.3px;display:inline-flex;align-items:center;gap:10px;backdrop-filter:blur(10px)}
    .btn-primary{background:linear-gradient(180deg, rgba(47,95,184,.92), rgba(47,95,184,.52));border-color:rgba(127,166,230,.30)}
    .btn svg{width:18px;height:18px;opacity:.95}
    .hint{position:absolute;left:16px;bottom:16px;padding:10px 12px;border:1px solid var(--stroke);border-radius:14px;background:rgba(0,0,0,.22);backdrop-filter:blur(10px);color:rgba(234,240,255,.65);font-size:12px;z-index:6;pointer-events:none}
    .newBanner{
      position:absolute;
      top:84px;
      left:16px;
      padding:10px 14px;
      border-radius:999px;
      background: linear-gradient(180deg, rgba(214,176,77,.95), rgba(214,176,77,.55));
      border:1px solid rgba(214,176,77,.55);
      color:#0b0f14;
      font-family: Rajdhani, Inter, system-ui, sans-serif;
      font-weight:800;
      letter-spacing:.6px;
      box-shadow: 0 12px 40px rgba(0,0,0,.35);
      z-index:7;
      display:none;
    }
    .newBanner.show{ display:inline-flex; align-items:center; gap:10px; }
    .newBanner .spark{
      width:10px; height:10px; border-radius:50%;
      background:#0b0f14;
      opacity:.9;
    }
    @media (max-width:740px){
      .actions{left:16px;right:16px;justify-content:space-between}
      .btn{width:calc(50% - 5px);justify-content:center}
    }
  </style>
</head>

<body>
<main class="stage" id="stage">
  <div class="imgWrap"><img id="img" class="img" alt="Produit"></div>

  <div class="topbar">
    <div class="brand">
      <img src="{{ asset('build/app/shop/images/logo-multimedia-services.71b1b6d1.png') }}" alt="Multimédia Services">
      <div>
        <p class="t">Multimédia Services</p>
        <p class="s">Tablette – Diaporama</p>
      </div>
    </div>
    <div class="statusPill"><span class="dot"></span><span id="wsState">Connexion…</span></div>
  </div>

  <section class="overlay">
    <div class="content">
      <h1 class="title" id="title">Chargement…</h1>
      <div class="priceRow">
        <div class="price" id="price">—</div>
        <div class="oldPrice" id="oldPrice" style="display:none">—</div>
        <div class="badge" id="badge" style="display:none">Promo</div>
      </div>
    </div>
  </section>

  <div class="hint">Tap/clic : produit suivant</div>

  <div class="actions">
    <form method="post" action="{{ path('tablet_logout') }}" style="margin:0">
      <button class="btn" type="submit">Verrouiller</button>
    </form>
    <button class="btn btn-primary" id="btn-reco" type="button">Reconnecter</button>
  </div>

  <div id="newBanner" class="newBanner">
    <span class="spark"></span> NOUVEAU
  </div>
</main>

<audio id="newSound" preload="auto">
  <source src="/sounds/mixkit-game-level-completed-2059.wav" type="audio/wav">
</audio>

<script>
(function(){
  const API_PRODUCTS = "{{ path('tablet_products') }}";
  const SLIDE_MS = 5000;
  const REFRESH_MS = 60000;

  const device = {{ device|json_encode|raw }};
  const token  = {{ token|json_encode|raw }};

  const stage = document.getElementById('stage');
  const imgEl = document.getElementById('img');
  const titleEl = document.getElementById('title');
  const priceEl = document.getElementById('price');
  const oldPriceEl = document.getElementById('oldPrice');
  const badgeEl = document.getElementById('badge');
  const wsStateEl = document.getElementById('wsState');
  const btnReco = document.getElementById('btn-reco');

  const newSound = document.getElementById("newSound");
let audioUnlocked = false;
let audioCtx = null;

function unlockAudio(){
  if (audioUnlocked) return true;

  // Débloque <audio>
  try {
    if (newSound) {
      newSound.muted = true;
      const p = newSound.play();
      if (p && p.then) {
        p.then(() => {
          newSound.pause();
          newSound.currentTime = 0;
          newSound.muted = false;
          audioUnlocked = true;
          console.log("[AUDIO] unlocked (HTMLAudio)");
        }).catch(() => {});
      }
    }
  } catch(e){}

  // Débloque WebAudio
  try {
    const Ctx = window.AudioContext || window.webkitAudioContext;
    if (Ctx && !audioCtx) audioCtx = new Ctx();
    if (audioCtx && audioCtx.state === "suspended") audioCtx.resume();
    if (audioCtx && audioCtx.state === "running") {
      audioUnlocked = true;
      console.log("[AUDIO] unlocked (WebAudio)");
    }
  } catch(e){}

  return audioUnlocked;
}

// IMPORTANT : au moins un de ces events arrivera sur ordi
["pointerdown","mousedown","touchstart","keydown"].forEach(evt => {
  document.addEventListener(evt, unlockAudio, { once:true, passive:true });
});

 function playNewSound(){
  try {
    // visuel OK même si audio bloqué
    document.body.style.transition = "background 0.2s ease";
    document.body.style.background = "#1c2e52";
    setTimeout(() => { document.body.style.background = ""; }, 250);

    if (!unlockAudio()) {
      console.warn("[AUDIO] blocked until user gesture");
      return;
    }

    if (newSound) {
      newSound.pause();
      newSound.currentTime = 0;
      newSound.volume = 1.0;
      newSound.play().catch(() => beep());
    } else {
      beep();
    }
  } catch(e){}
}

function beep(){
  if (!audioUnlocked) return; // <-- clé : pas d'erreur Chrome
  try {
    const Ctx = window.AudioContext || window.webkitAudioContext;
    if (!Ctx) return;
    if (!audioCtx) audioCtx = new Ctx();
    if (audioCtx.state === "suspended") audioCtx.resume();

    const o = audioCtx.createOscillator();
    const g = audioCtx.createGain();
    o.type = "sine";
    o.frequency.value = 880;
    g.gain.value = 0.08;

    o.connect(g);
    g.connect(audioCtx.destination);

    o.start();
    setTimeout(() => { try { o.stop(); } catch(e){} }, 180);
  } catch(e){}
}

  function formatPrice(p){
    const n = Number(p ?? 0);
    if (Number.isNaN(n)) return "—";
    return n.toFixed(2).replace('.', ',') + " €";
  }

  function proxify(url){
    if (!url) return "";
    if (url.includes("multimediaservices22.hiboutik.com/api/products_images/")) {
      return "https://shop.multimedia-services.fr/api/hiboutik/image?src=" + encodeURIComponent(url);
    }
    return url;
  }

  function firstImage(p){
    const list = Array.isArray(p?.images) ? p.images : [];
    const u = p?.image ?? p?.thumb ?? list[0] ?? "";
    return proxify(u);
  }

  let products = [];
  let index = 0;
  let slideTimer = null;
  let refreshTimer = null;

  const newBannerEl = document.getElementById("newBanner");
  let highlightTimer = null;

  function showNewBanner(ms = 8000){
    if (!newBannerEl) return;
    newBannerEl.classList.add("show");
    if (highlightTimer) clearTimeout(highlightTimer);
    highlightTimer = setTimeout(() => {
      newBannerEl.classList.remove("show");
    }, ms);
  }

  function goToProductId(productId){
    const idx = products.findIndex(p => Number(p?.product_id) === Number(productId));
    if (idx >= 0) {
      render(idx);
      showNewBanner(8000);
      startSlide();
    }
  }

  function render(i){
    if (!products.length) {
      titleEl.textContent = "Aucun produit en stock";
      priceEl.textContent = "—";
      oldPriceEl.style.display = "none";
      badgeEl.style.display = "none";
      imgEl.removeAttribute("src");
      return;
    }

    index = ((i % products.length) + products.length) % products.length;
    const p = products[index];

    const img = firstImage(p);
    if (img) imgEl.src = img;
    imgEl.alt = p?.product_model ?? "Produit";
    titleEl.textContent = p?.product_model ?? "Produit";

    const hasPromo =
      (p?.product_discount_price ?? "0") !== "0" &&
      Number(p?.product_discount_price) > 0;

    const priceStr = hasPromo ? p.product_discount_price : p.product_price;
    priceEl.textContent = formatPrice(priceStr);

    if (hasPromo) {
      oldPriceEl.style.display = "";
      oldPriceEl.textContent = formatPrice(p.product_price);
      badgeEl.style.display = "";
    } else {
      oldPriceEl.style.display = "none";
      badgeEl.style.display = "none";
    }

    if (products.length > 1) {
      const next = products[(index + 1) % products.length];
      const nextImg = firstImage(next);
      if (nextImg) { const pre = new Image(); pre.src = nextImg; }
    }
  }

  function next(){ render(index + 1); }
  function startSlide(){ stopSlide(); slideTimer = setInterval(next, SLIDE_MS); }
  function stopSlide(){ if (slideTimer) clearInterval(slideTimer); slideTimer = null; }

  async function loadProducts(focusId = 0){
    try {
      const res = await fetch(API_PRODUCTS, { cache: "no-store" });
      if (!res.ok) throw new Error("HTTP " + res.status);
      const json = await res.json();

      const list = Array.isArray(json?.data) ? json.data : [];
      products = list;

      if (focusId) {
        goToProductId(focusId);
      } else {
        if (index >= products.length) index = 0;
        render(index);
        startSlide();
      }
    } catch(e) {
      titleEl.textContent = "Impossible de charger les produits";
      priceEl.textContent = "Vérifier la connexion";
      oldPriceEl.style.display = "none";
      badgeEl.style.display = "none";
      stopSlide();
    }
  }

  // ===== SSE (api.multimedia-services.fr) : refresh diapo =====
  let es = null;

  function connectSSE(){
    try {
      if (es) { try { es.close(); } catch(e) {} es = null; }

      es = new EventSource("https://api.multimedia-services.fr/api/events");

      es.addEventListener("product_updated", (ev) => {
        try {
          const data = JSON.parse(ev.data || "{}");
          const id = Number(data?.product_id || 0);
          if (!id) return;

          loadProducts(id);
          playNewSound();
        } catch(e) {}
      });

      es.onerror = () => {
        // optionnel : tu peux reconnecter ici si tu veux
      };

      return es;
    } catch(e) {
      return null;
    }
  }

  connectSSE();

  stage.addEventListener('click', () => { if (products.length) next(); });

  function startRefresh(){
    if (refreshTimer) clearInterval(refreshTimer);
    refreshTimer = setInterval(loadProducts, REFRESH_MS);
  }

  // ===== WS redirect =====
  let ws=null, retry=0, retryTimer=null, pingTimer=null;
  const PING_EVERY_MS = 20000;

  function wsUrl(){
    const proto = (location.protocol === 'https:') ? 'wss' : 'ws';
    return `${proto}://${location.host}/ws-tablet?device=${encodeURIComponent(device)}&token=${encodeURIComponent(token)}`;
  }
  function setWsState(t){ wsStateEl.textContent = t; }
  function clearWsTimers(){
    if (retryTimer) clearTimeout(retryTimer);
    if (pingTimer) clearInterval(pingTimer);
    retryTimer=null; pingTimer=null;
  }
  function startPing(){
    pingTimer = setInterval(() => {
      try { if (ws && ws.readyState===1) ws.send(JSON.stringify({type:"ping", t:Date.now()})); } catch(e){}
    }, PING_EVERY_MS);
  }
  function scheduleReconnect(){
    clearWsTimers();
    const delay = Math.min(15000, Math.round(800 * Math.pow(2, retry)));
    retry = Math.min(retry + 1, 6);
    setWsState("Hors ligne");
    retryTimer = setTimeout(connectWs, delay);
  }

  function connectWs(){
    clearWsTimers();

    try {
      if (ws && (ws.readyState === 0 || ws.readyState === 1)) ws.close();
    } catch (e) {}

    setWsState("Connexion…");

    try {
      ws = new WebSocket(wsUrl());
    } catch (e) {
      scheduleReconnect();
      return;
    }

    ws.onopen = () => {
      retry = 0;
      setWsState("Connecté");
      startPing();
    };

    ws.onerror = () => {
      setWsState("Instable");
    };

    ws.onclose = () => {
      scheduleReconnect();
    };

    ws.onmessage = (e) => {
      try {
        const msg = JSON.parse(e.data);

        if (msg && msg.type === "products_updated") {
          loadProducts();
          return;
        }

        if (msg && msg.url) {
          location.href = msg.url;
          return;
        }
      } catch (err) {}
    };
  }

  btnReco.addEventListener('click', () => { retry=0; connectWs(); loadProducts(); });
  document.addEventListener('visibilitychange', () => { if (!document.hidden && (!ws || ws.readyState===3)) connectWs(); });

  // Débloque l'audio sur 1er clic (iOS / Chrome policies)
  document.addEventListener("click", () => {
    if (newSound) newSound.play().then(()=>newSound.pause()).catch(()=>{});
  }, { once: true });

  loadProducts();
  startRefresh();
  connectWs();
})();
</script>

</body>
</html>
<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width,initial-scale=1">
		<title>Tablette – Diaporama</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
		<style>
			

			{% include 	'tablet/tablet/_diapo_css.html.twig' %}
			{% include 'tablet/tablet/_label_css.html.twig' %}

			@media (max-width: 740px) {
				.grid9Inner {
					grid-template-columns: repeat(2, 1fr);
					grid-template-rows: auto;
				}

				.actions {
					left: 16px;
					right: 16px;
					justify-content: space-between;
				}

				.btn {
					width: calc(50% - 5px);
					justify-content: center;
				}
			}
		</style>
	</head>

	<body>
		<main class="stage" id="stage">
			<div class="imgWrap" id="imgWrap">
				<img id="img" class="img" alt="Produit">
			</div>

			{% include 'tablet/tablet/_label.html.twig' %}

			<div class="grid9" id="grid9" aria-hidden="true">
				<div class="grid9Inner" id="grid9Inner"></div>
			</div>

			<div class="topbar">
				<div class="brand">
					<img src="{{ asset('build/app/shop/images/logo-multimedia-services.71b1b6d1.png') }}" alt="Multimédia Services">
					<div>
						<p class="t">Multimédia Services</p>
						<p class="s">Tablette – Diaporama</p>
					</div>
				</div>
				<div class="statusPill">
					<span class="dot"></span>
					<span id="wsState">Connexion…</span>
				</div>
			</div>

			<section class="overlay">
				<div class="content">
					<h1 class="title" id="title">Chargement…</h1>
					<div class="priceRow">
						<div class="price" id="price">—</div>
						<div class="oldPrice" id="oldPrice" style="display:none">—</div>
						<div class="badge" id="badge" style="display:none">Promo</div>
					</div>
				</div>
			</section>

			<div class="hint">Tap/clic : produit suivant</div>

			<div class="actions">
				<form method="post" action="{{ path('tablet_logout') }}" style="margin:0">
					<button class="btn" type="submit">Verrouiller</button>
				</form>
				<button class="btn btn-primary" id="btn-reco" type="button">Reconnecter</button>
			</div>

			<div id="newBanner" class="newBanner">
				<span class="spark"></span>
				NOUVEAU
			</div>
		</main>

		


		<div id="bootLoader" class="bootLoader show" aria-live="polite">
	<div class="bootLoader__card">
		<div class="bootLoader__spinner"></div>
		<div class="bootLoader__title">Chargement en cours…</div>
		<div class="bootLoader__text">Préparation de l’affichage produits</div>
	</div>
</div>

<script>
			{% include 'tablet/tablet/_label_js.html.twig' %}
		</script>

		<script>
			{% include 'tablet/tablet/_diapo_js.html.twig' %}
		</script>
	</body>
</html>
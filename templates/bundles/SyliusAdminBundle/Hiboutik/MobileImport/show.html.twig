{% extends '@!SyliusAdmin/layout.html.twig' %}

{% block title %}Session import #{{ session.id }}
{% endblock %}

{% block content %}
	<div class="ui segment">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;">
    <div>
      <h1 class="ui header" style="margin:0 0 6px 0;">
        <i class="tasks icon"></i>
        <div class="content">
          Session import #{{ session.id }}
          <div class="sub header">
            {{ session.sourceFilename ?: 'Document sans nom' }}
          </div>
        </div>
      </h1>

      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;">
        <span class="ui small label">
          Type :
          {% if session.sourceType == 'purchase_order' %}
            Bon de commande
          {% elseif session.sourceType == 'delivery_note' %}
            Bon de livraison
          {% elseif session.sourceType == 'hib_inventory_input' %}
            Arrivage Hiboutik
          {% else %}
            {{ session.sourceType ?: '—' }}
          {% endif %}
        </span>

        <span class="ui small label">
          Lignes : {{ session.rows|length }}
        </span>

        {% if session.hibInventoryInputId %}
          <span class="ui small green label">
            Arrivage lié #{{ session.hibInventoryInputId }}
          </span>
        {% else %}
          <span class="ui small orange label">
            Aucun arrivage lié
          </span>
        {% endif %}
      </div>
    </div>

    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <button type="submit" class="ui primary button" form="grid-form">
        <i class="save icon"></i>
        Enregistrer la grille
      </button>

      <a href="{{ path('admin_hib_mobile_import_index') }}" class="ui button">
        Retour à la liste
      </a>
    </div>
  </div>
</div>

<div class="ui three stackable cards">
  <div class="card">
    <div class="content">
      <div class="header">Document</div>
      <div class="description" style="margin-top:10px;">
        <div><strong>Nom :</strong> {{ session.sourceFilename ?: '—' }}</div>
        <div><strong>Référence :</strong> {{ session.documentCode ?: '—' }}</div>
        <div><strong>Type :</strong>
          {% if session.sourceType == 'purchase_order' %}
            Bon de commande
          {% elseif session.sourceType == 'delivery_note' %}
            Bon de livraison
          {% elseif session.sourceType == 'hib_inventory_input' %}
            Arrivage Hiboutik
          {% else %}
            {{ session.sourceType ?: '—' }}
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="content">
      <div class="header">Fournisseur</div>
      <div class="description" style="margin-top:10px;">
        <div><strong>ID fournisseur :</strong> {{ session.supplierId ?: '—' }}</div>
        <div><strong>Arrivage lié :</strong>
          {% if session.hibInventoryInputId %}
            #{{ session.hibInventoryInputId }}
          {% else %}
            —
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="content">
      <div class="header">Actions arrivage</div>
      <div class="description" style="margin-top:10px;">
        {% if session.hibInventoryInputId %}
          <div class="ui small green message" style="margin-bottom:10px;">
            Cette session est déjà liée à l’arrivage #{{ session.hibInventoryInputId }}.
          </div>
        {% else %}
          <div class="ui small orange message" style="margin-bottom:10px;">
            Aucun arrivage n’est encore lié à cette session.
          </div>
        {% endif %}

        <form method="post" action="{{ path('admin_hib_mobile_import_prepare_arrival', {id: session.id}) }}" class="ui form" data-turbo="false">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token('hib_mobile_prepare_' ~ session.id) }}">

          <div class="field">
            <label>Référence document</label>
            <input type="text" name="document_code" value="{{ session.documentCode }}">
          </div>

          <div class="field">
            <label>Fournisseur Hiboutik</label>
            <select name="supplier_id" class="ui dropdown" required>
              <option value="">Choisir...</option>
              {% for s in suppliers %}
                <option value="{{ s.supplier_id }}" {% if session.supplierId and session.supplierId == s.supplier_id %}selected{% endif %}>
                  {{ s.supplier_name }}
                </option>
              {% endfor %}
            </select>
          </div>

          <button type="submit" class="ui primary button">
            {% if session.hibInventoryInputId %}
              Vérifier / rattacher l’arrivage
            {% else %}
              Créer ou rattacher l’arrivage
            {% endif %}
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

	<div class="ui segment">
		<button type="submit" class="ui primary button" form="grid-form">
			<i class="save icon"></i>
			Enregistrer la grille
		</button>

		<form method="post" action="{{ path('admin_hib_mobile_import_import_all', {id: session.id}) }}" style="display:inline-block;margin-left:8px;" data-turbo="false">
			<input type="hidden" name="_csrf_token" value="{{ csrf_token('hib_mobile_import_all_' ~ session.id) }}">
			<button type="submit" class="ui green button" {% if not session.hibInventoryInputId %} disabled {% endif %}>
				<i class="play icon"></i>
				Tout importer
			</button>
		</form>
	</div>
</div>


<div class="ui segment">
	<h3 class="ui dividing header">Actions de masse</h3>

	<div class="ui form">
		<div style="display:flex;gap:10px;flex-wrap:wrap;align-items:end;">
			<div class="field">
				<label><input type="checkbox" id="check-all-rows">
					Tout cocher</label>
			</div>

			<div class="field">
				<label>TVA</label>
				<select id="bulk-vat" class="ui dropdown">
					<option value="">—</option>
					<option value="20">20</option>
					<option value="0">0</option>
				</select>
			</div>

			<div class="field">
				<label>Compte compta</label>
				<select id="bulk-accounting" class="ui dropdown">
					<option value="">—</option>
					<option value="707002">707002</option>
					<option value="707001">707001</option>
				</select>
			</div>

			<div class="field">
				<label>Supplier</label>
				<select id="bulk-supplier" class="ui dropdown">
					<option value="">—</option>
					{% for s in suppliers %}
						<option value="{{ s.supplier_id }}">{{ s.supplier_name }}</option>
					{% endfor %}
				</select>
			</div>

			<div class="field">
				<label>Catégorie</label>
				<select id="bulk-category" class="ui dropdown">
					<option value="">—</option>
					{% for c in categories %}
						<option value="{{ c.category_id }}">{{ c.category_name ?? c.category_label ?? ('Catégorie #' ~ c.category_id) }}</option>
					{% endfor %}
				</select>
			</div>

			<div class="field">
				<label>Marque</label>
				<select id="bulk-brand" class="ui dropdown">
					<option value="">—</option>
					{% for b in brands %}
						<option value="{{ b.brand_id }}">{{ b.brand_name ?? ('Marque #' ~ b.brand_id) }}</option>
					{% endfor %}
				</select>
			</div>

			<div class="field">
				<label>Coeff PV</label>
				<input type="text" id="bulk-price-coeff" value="1.8">
			</div>

			<div class="field">
    <label>Prix vente fixe</label>
    <input type="text" id="bulk-sell-price" placeholder="Ex: 19,90">
</div>


			<div class="field">
				<button type="button" class="ui button" id="apply-bulk-values">Appliquer à la sélection</button>
			</div>

			<div class="field">
				<button type="button" class="ui button" id="apply-price-coeff">PV = PA × coeff</button>
			</div>
		</div>
	</div>
</div>

<style>
  table.sessions-table tbody tr:nth-child(odd) > td {
    background: #fafbfc !important;
  }

  table.sessions-table tbody tr:nth-child(even) > td {
    background: #e5e7ef !important
  }

  table.sessions-table tbody tr:hover > td {
    background: #dff1ff !important;
    transition: background 0.15s ease;
  }
</style>

<div class="ui segment" style="margin-bottom:1rem;">
  <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
    <div style="flex:1; min-width:280px;">
      <div class="ui left icon input fluid">
        <i class="search icon"></i>
        <input
          type="text"
          id="live-row-filter"
          placeholder="Filtrer les lignes en live : nom, IMEI, EAN, SKU, catégorie, marque, raison…"
          autocomplete="off"
        >
      </div>
    </div>

    <div class="ui small basic label">
      <span id="live-row-filter-count">0 / 0</span>
    </div>

    <button type="button" class="ui small button" id="live-row-filter-reset">
      <i class="undo icon"></i> Tout voir
    </button>

    <button type="button" class="ui small teal button" id="select-visible-rows">
      <i class="check square outline icon"></i> Sélectionner visibles
    </button>

    <button type="button" class="ui small button" id="unselect-visible-rows">
      <i class="square outline icon"></i> Désélectionner visibles
    </button>
  </div>
</div>

<div class="ui segment">
	{% if rowsView is empty %}
		<div class="ui message">Aucune ligne.</div>
	{% else %}
		<div style="overflow-x:auto;">
			<table class="ui celled table sessions-table">
				<thead>
					<tr >
						<th></th>
						<th>Ligne</th>
						<th>Libellé brut</th>
						<th>SKU</th>
						<th>IMEI</th>
						<th>EAN</th>
						<th>Qté</th>
						<th>Nom final</th>
						<th>Barcode final</th>
						<th>Ref ext</th>
						<th>PA</th>
						<th>PV</th>
						<th>TVA</th>
						<th>Compte</th>
						<th>Catégorie</th>
						<th>Marque</th>
						<th>Supplier</th>
						<th>Ignorer</th>
						<th>Prêt</th>
						<th>Bloqué</th>
						<th>Raison</th>
						<th>Produit créé</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody>
					{% for item in rowsView %}
						{% set row = item.row %}
						<tr class="import-row {% if row.isBlocked %}error{% elseif row.createdProductId %}positive{% endif %}"
						data-filter-text="
        {{ row.lineNumber }}
        {{ row.rawLabel }}
        {{ row.sku ?: '' }}
        {{ row.imei ?: '' }}
        {{ row.ean ?: '' }}
        {{ row.quantity }}
        {{ row.resolvedName ?: row.rawLabel }}
        {{ row.resolvedBarcode ?: row.imei ?: row.ean ?: '' }}
        {{ row.resolvedProductsRefExt ?: row.sku ?: '' }}
        {{ row.resolvedBuyPrice ?: row.buyPrice ?: '' }}
        {{ row.resolvedSellPrice ?: row.buyPrice ?: '' }}
        {{ row.resolvedVat is not null ? row.resolvedVat : '' }}
        {{ row.resolvedAccountingAccount ?: '' }}
        {{ row.resolvedCategoryLabel ?: '' }}
        {{ row.resolvedBrandLabel ?: '' }}
        {{ row.blockReason ?: '' }}
        {{ row.createdProductId ?: '' }}
        {{ row.isBlocked ? 'bloque' : '' }}
        {{ row.isReady ? 'pret' : '' }}
        {{ row.isIgnored ? 'ignore' : '' }}
        {{ row.createdProductId ? 'deja traite' : '' }}
    "
						
						>
							<td>
							<input type="checkbox"
       class="row-check"
       data-row-id="{{ row.id }}"
       name="selected_ids[]"
       value="{{ row.id }}"
       form="grid-form">
							</td>
							<td>{{ row.lineNumber }}</td>
							<td style="min-width:220px;">{{ row.rawLabel }}</td>
							<td>{{ row.sku ?: '—' }}</td>
							<td>{{ row.imei ?: '—' }}</td>
							<td>{{ row.ean ?: '—' }}</td>
							<td>{{ row.quantity }}</td>

							<td style="min-width:220px;">
								<input type="text" name="rows[{{ row.id }}][resolvedName]" value="{{ row.resolvedName ?: row.rawLabel }}" form="grid-form" class="row-resolved-name" data-row-id="{{ row.id }}" style="width:100%;">
							</td>

							<td style="min-width:150px;">
								<input type="text" name="rows[{{ row.id }}][resolvedBarcode]" value="{{ row.resolvedBarcode ?: row.imei ?: row.ean }}" form="grid-form" class="row-resolved-barcode" data-row-id="{{ row.id }}" style="width:100%;">
							</td>

							<td style="min-width:150px;">
								<input type="text" name="rows[{{ row.id }}][resolvedProductsRefExt]" value="{{ row.resolvedProductsRefExt ?: row.sku }}" form="grid-form" class="row-resolved-refext" data-row-id="{{ row.id }}" style="width:100%;">
							</td>

							<td style="min-width:90px;">
								<input type="text" name="rows[{{ row.id }}][resolvedBuyPrice]" value="{{ row.resolvedBuyPrice ?: row.buyPrice }}" form="grid-form" class="row-resolved-buy" data-row-id="{{ row.id }}" style="width:100%;">
							</td>

							<td style="min-width:90px;">
								<input type="text" name="rows[{{ row.id }}][resolvedSellPrice]" value="{{ row.resolvedSellPrice ?: row.buyPrice }}" form="grid-form" class="row-resolved-sell" data-row-id="{{ row.id }}" style="width:100%;">
							</td>

							<td style="min-width:70px;">
								<input type="text" name="rows[{{ row.id }}][resolvedVat]" value="{{ row.resolvedVat is not null ? row.resolvedVat : '' }}" form="grid-form" class="row-resolved-vat" data-row-id="{{ row.id }}" style="width:100%;">
							</td>

							<td style="min-width:90px;">
								<input type="text" name="rows[{{ row.id }}][resolvedAccountingAccount]" value="{{ row.resolvedAccountingAccount ?: '' }}" form="grid-form" class="row-resolved-accounting" data-row-id="{{ row.id }}" style="width:100%;">
							</td>

							<td style="min-width:160px;">
								<select name="rows[{{ row.id }}][resolvedCategoryId]" form="grid-form" class="row-resolved-category" data-row-id="{{ row.id }}" style="width:100%;">
									<option value="">—</option>
									{% for c in categories %}
										{% set cid = c.category_id %}
										<option value="{{ cid }}" {% if row.resolvedCategoryId and row.resolvedCategoryId == cid %} selected {% endif %}>
											{{ c.category_name ?? c.category_label ?? ('Catégorie #' ~ cid) }}
										</option>
									{% endfor %}
								</select>
							</td>

							<td style="min-width:160px;">
								<select name="rows[{{ row.id }}][resolvedBrandId]" form="grid-form" class="row-resolved-brand" data-row-id="{{ row.id }}" style="width:100%;">
									<option value="">—</option>
									{% for b in brands %}
										{% set bid = b.brand_id %}
										<option value="{{ bid }}" {% if row.resolvedBrandId and row.resolvedBrandId == bid %} selected {% endif %}>
											{{ b.brand_name ?? ('Marque #' ~ bid) }}
										</option>
									{% endfor %}
								</select>
							</td>

							<td style="min-width:160px;">
								<select name="rows[{{ row.id }}][resolvedSupplierId]" form="grid-form" class="row-resolved-supplier" data-row-id="{{ row.id }}" style="width:100%;">
									<option value="">—</option>
									{% for s in suppliers %}
										{% set sid = s.supplier_id %}
										<option value="{{ sid }}" {% if row.resolvedSupplierId and row.resolvedSupplierId == sid %} selected {% endif %}>
											{{ s.supplier_name }}
										</option>
									{% endfor %}
								</select>
							</td>

							<td style="text-align:center;">
								<input type="checkbox" name="rows[{{ row.id }}][isIgnored]" value="1" form="grid-form" {% if row.isIgnored %} checked {% endif %}>
							</td>

							<td>
								{% if row.isReady %}
									<span class="ui tiny green label">Oui</span>
								{% else %}
									<span class="ui tiny grey label">Non</span>
								{% endif %}
							</td>
							<td>
								{% if row.isBlocked %}
									<span class="ui tiny red label">Oui</span>
								{% else %}
									<span class="ui tiny grey label">Non</span>
								{% endif %}
							</td>
							<td>{{ row.blockReason ?: '—' }}</td>

							<td>
								{% if row.createdProductId %}
									<a class="ui tiny button" target="_blank" href="{{ path('admin_hiboutik_product_edit', {id: row.createdProductId}) }}">
										#{{ row.createdProductId }}
									</a>
								{% else %}
									—
								{% endif %}
							</td>

							<td>
								{% if row.createdProductId %}
									<span style="color:#888;">Déjà traité</span>
								{% else %}
									<button type="submit" class="ui tiny primary button" form="import-row-{{ row.id }}" {% if not session.hibInventoryInputId %} disabled {% endif %}>
										Importer
									</button>
								{% endif %}
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

		<div style="margin-top:16px;display:flex;gap:8px;flex-wrap:wrap;">
    <button type="submit" class="ui primary button" form="grid-form">
        <i class="save icon"></i>
        Enregistrer la grille
    </button>

    <button type="submit"
            class="ui orange button"
            form="grid-form"
            formaction="{{ path('admin_hib_mobile_import_import_selected', {id: session.id}) }}">
        <i class="check square outline icon"></i>
        Importer la sélection
    </button>
	<button type="submit"
        class="ui teal button"
        form="grid-form"
        formaction="{{ path('admin_hib_mobile_import_reapply_selected', {id: session.id}) }}">
    <i class="refresh icon"></i>
    Réappliquer la sélection
</button>
</div>
	{% endif %}


</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const checkAll = document.getElementById('check-all-rows');
    const gridForm = document.getElementById('grid-form');

    function rowChecks() {
        return Array.from(document.querySelectorAll('.row-check'));
    }

    function getCheckedRowIds() {
        return rowChecks()
            .filter(cb => cb.checked)
            .map(cb => cb.dataset.rowId);
    }

    function setValueForRows(rowIds, selector, value) {
        rowIds.forEach(id => {
            const input = document.querySelector(selector + '[data-row-id="' + id + '"]');
            if (input) {
                input.value = value;
            }
        });
    }

    if (checkAll) {
        checkAll.addEventListener('change', function () {
            rowChecks().forEach(cb => {
                cb.checked = checkAll.checked;
            });
        });
    }

    const applyBulkBtn = document.getElementById('apply-bulk-values');
    if (applyBulkBtn) {
        applyBulkBtn.addEventListener('click', function () {
            const rowIds = getCheckedRowIds();
            if (!rowIds.length) {
                alert('Aucune ligne cochée.');
                return;
            }

            const vat = document.getElementById('bulk-vat')?.value || '';
            const accounting = document.getElementById('bulk-accounting')?.value || '';
            const supplier = document.getElementById('bulk-supplier')?.value || '';
            const category = document.getElementById('bulk-category')?.value || '';
            const brand = document.getElementById('bulk-brand')?.value || '';
            const sellPrice = (document.getElementById('bulk-sell-price')?.value || '').trim();

            if (vat !== '') setValueForRows(rowIds, '.row-resolved-vat', vat);
            if (accounting !== '') setValueForRows(rowIds, '.row-resolved-accounting', accounting);
            if (supplier !== '') setValueForRows(rowIds, '.row-resolved-supplier', supplier);
            if (category !== '') setValueForRows(rowIds, '.row-resolved-category', category);
            if (brand !== '') setValueForRows(rowIds, '.row-resolved-brand', brand);
            if (sellPrice !== '') setValueForRows(rowIds, '.row-resolved-sell', sellPrice);
        });
    }

    const applyCoeffBtn = document.getElementById('apply-price-coeff');
    if (applyCoeffBtn) {
        applyCoeffBtn.addEventListener('click', function () {
            const rowIds = getCheckedRowIds();
            if (!rowIds.length) {
                alert('Aucune ligne cochée.');
                return;
            }

            const coeffRaw = document.getElementById('bulk-price-coeff')?.value || '1';
            const coeff = parseFloat(coeffRaw.replace(',', '.'));

            if (isNaN(coeff) || coeff <= 0) {
                alert('Coefficient invalide.');
                return;
            }

            rowIds.forEach(id => {
                const buyInput = document.querySelector('.row-resolved-buy[data-row-id="' + id + '"]');
                const sellInput = document.querySelector('.row-resolved-sell[data-row-id="' + id + '"]');

                if (buyInput && sellInput) {
                    const buy = parseFloat(String(buyInput.value).replace(',', '.'));
                    if (!isNaN(buy)) {
                        sellInput.value = (buy * coeff).toFixed(2);
                    }
                }
            });
        });
    }

    if (gridForm) {
        gridForm.addEventListener('submit', function (e) {
            const submitter = e.submitter;
            if (!submitter) {
                return;
            }

            const action = submitter.getAttribute('formaction') || '';
            if (!action.includes('/import-selected') && !action.includes('/reapply-selected')) {
                return;
            }

            const checked = document.querySelectorAll('.row-check:checked');
            if (!checked.length) {
                e.preventDefault();
                alert('Aucune ligne cochée.');
            }
        });
    }
});
</script>
<script>
(function () {
  const input = document.getElementById('live-row-filter');
  const resetBtn = document.getElementById('live-row-filter-reset');
  const selectVisibleBtn = document.getElementById('select-visible-rows');
  const unselectVisibleBtn = document.getElementById('unselect-visible-rows');
  const counter = document.getElementById('live-row-filter-count');

  if (!input || !counter) return;

  const rows = Array.from(document.querySelectorAll('tbody tr.import-row'));

  function normalize(str) {
    return (str || '')
      .toString()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/\s+/g, ' ')
      .trim();
  }

  function rowText(row) {
    const staticText = row.getAttribute('data-filter-text') || '';
    const dynamicValues = [];

    row.querySelectorAll('input, select, textarea').forEach(el => {
      if (el.type === 'checkbox' || el.type === 'radio') return;

      if (el.tagName === 'SELECT') {
        const selectedOption = el.options[el.selectedIndex];
        dynamicValues.push(el.value || '');
        dynamicValues.push(selectedOption ? selectedOption.text || '' : '');
      } else {
        dynamicValues.push(el.value || '');
      }
    });

    return normalize(staticText + ' ' + dynamicValues.join(' '));
  }

  function applyFilter() {
    const q = normalize(input.value);
    let visible = 0;

    rows.forEach(row => {
      const hay = rowText(row);
      const match = q === '' || hay.includes(q);

      row.style.display = match ? '' : 'none';

      if (match) visible++;
    });

    counter.textContent = visible + ' / ' + rows.length;
  }

  function visibleRows() {
    return rows.filter(row => row.style.display !== 'none');
  }

  function findRowCheckbox(row) {
    return row.querySelector('input.row-check');
  }

  input.addEventListener('input', applyFilter);

  if (resetBtn) {
    resetBtn.addEventListener('click', function () {
      input.value = '';
      applyFilter();
      input.focus();
    });
  }

  if (selectVisibleBtn) {
    selectVisibleBtn.addEventListener('click', function () {
      visibleRows().forEach(row => {
        const cb = findRowCheckbox(row);
        if (cb) cb.checked = true;
      });
    });
  }

  if (unselectVisibleBtn) {
    unselectVisibleBtn.addEventListener('click', function () {
      visibleRows().forEach(row => {
        const cb = findRowCheckbox(row);
        if (cb) cb.checked = false;
      });
    });
  }

  applyFilter();
})();
</script>
{% endblock %}

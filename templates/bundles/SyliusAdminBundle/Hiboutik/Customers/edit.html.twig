{% extends '@!SyliusAdmin/layout.html.twig' %}

{% block title %}Client Hiboutik #{{ customer.customers_id }}{% endblock %}

{% block content %}
{# Top menu dans le pre_content du Layout Admin #}

<div class="ui clearing basic segment" style="padding:0 0 1rem 0;">
    <h1 class="ui left floated header">
        <i class="user edit icon"></i>
        <div class="content">
            Client Hiboutik #{{ customer.customers_id }}
            <div class="sub header">
                {{ customer.first_name ?? '' }} {{ customer.last_name ?? '' }}
            </div>
        </div>
    </h1>

    <div class="ui right floated buttons">
        <a class="ui button" href="{{ path('admin_hiboutik_customer_index') }}">
            <i class="arrow left icon"></i>
            Retour
        </a>
    </div>
</div>

{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="ui {{ type == 'error' ? 'negative' : 'positive' }} message">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}

<form method="post" class="ui form">
    <div class="ui stackable two column grid">
        <div class="eight wide column">
            <div class="ui fluid card" style="width:100%;">
                <div class="content">
                    <div class="header">Client</div>
                    <div class="meta">Informations essentielles</div>
                </div>

                <div class="content">
                    <div class="field">
                        <label>Nom</label>
                        <input type="text" name="last_name" value="{{ customer.last_name ?? '' }}">
                    </div>

                    <div class="field">
                        <label>Prénom</label>
                        <input type="text" name="first_name" value="{{ customer.first_name ?? '' }}">
                    </div>

                    <div class="field">
                        <label>Société</label>
                        <input type="text" name="company" value="{{ customer.company ?? '' }}">
                    </div>

                    <div class="field">
                        <label>Email</label>
                        <input type="email" name="email" value="{{ customer.email ?? '' }}">
                    </div>

                    <div class="field">
                        <label>Téléphone</label>
                        <input type="text" name="phone" value="{{ customer.phone ?? '' }}">
                    </div>

                    <div class="field">
                        <label>Pays</label>
                        <input type="text" name="country" value="{{ customer.country ?? 'FRA' }}">
                    </div>
                </div>
            </div>
        </div>

        <div class="eight wide column">
            <div class="ui fluid card" style="width:100%;">
                <div class="content">
                    <div class="header">Adresse</div>
                    <div class="meta">
                        {% if address %}
                            Adresse existante
                        {% else %}
                            Aucune adresse enregistrée
                        {% endif %}
                    </div>
                </div>

                <div class="content">
                    <button
                        type="button"
                        class="ui button"
                        id="toggleAddressBtn"
                    >
                        <i class="home icon"></i>
                        {% if address %}
                            Modifier l’adresse
                        {% else %}
                            Ajouter une adresse
                        {% endif %}
                    </button>

                    <div id="addressFieldsWrap" style="display:{{ address ? 'block' : 'none' }}; margin-top:16px;">
                        <div class="field">
                            <label>Adresse</label>
                            <textarea name="address_address" rows="3">{{ address.address ?? '' }}</textarea>
                        </div>

                        <div class="two fields">
                            <div class="field">
                                <label>Code postal</label>
                                <input type="text" name="address_zip_code" value="{{ address.zip_code ?? '' }}">
                            </div>
                            <div class="field">
                                <label>Ville</label>
                                <input type="text" name="address_city" value="{{ address.city ?? '' }}">
                            </div>
                        </div>

                        <div class="two fields">
                            <div class="field">
                                <label>Département / Région</label>
                                <input type="text" name="address_state" value="{{ address.state ?? '' }}">
                            </div>
                            <div class="field">
                                <label>Pays adresse</label>
                                <input type="text" name="address_country" value="{{ address.country ?? customer.country ?? 'FRA' }}">
                            </div>
                        </div>

                        <div class="inline field">
                            <div class="ui checkbox">
                                <input
                                    type="checkbox"
                                    name="address_default"
                                    value="1"
                                    {% if (address.default ?? 0) == 1 %}checked{% endif %}
                                >
                                <label>Adresse par défaut</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {% if address %}
                <div class="ui small info message">
                    <strong>Adresse actuelle :</strong><br>
                    {{ address.address ?? '' }}<br>
                    {{ address.zip_code ?? '' }} {{ address.city ?? '' }}
                    {% if address.state %}<br>{{ address.state }}{% endif %}
                    {% if address.country %}<br>{{ address.country }}{% endif %}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="ui divider"></div>

    <div class="ui right aligned basic segment" style="padding:0;">
        <button class="ui primary button" type="submit">
            <i class="save icon"></i>
            Enregistrer
        </button>
    </div>
</form>

<div class="ui fluid card" style="width:100%; margin-top:16px;">
    <div class="content">
        <div class="header">Interventions du client</div>
        <div class="meta">
            {{ interventions|length }} intervention{{ interventions|length > 1 ? 's' : '' }}
        </div>
    </div>

    <div class="content">
        {% if interventions is not empty %}
            <table class="ui very basic compact table">
                <thead>
                    <tr>
                        <th>N°</th>
                        <th>Date</th>
                        <th>Appareil</th>
                        <th>Statut</th>
                        <th>Paiement</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for intervention in interventions %}
                        <tr>
                            <td>#{{ intervention.interventionNumber }}</td>
                            <td>{{ intervention.createdAt ? intervention.createdAt|date('d/m/Y H:i') : '—' }}</td>
                            <td>{{ intervention.deviceLabel ?: '—' }}</td>
                            <td>{{ intervention.status ?: '—' }}</td>
                            <td>
                                {% if intervention.amountPaid is not null %}
                                    {{ intervention.amountPaid }} €
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td class="right aligned">
                                <a
                                    class="ui mini button"
                                    href="{{ path('app_admin_intervention_edit', {id: intervention.id}) }}"
                                >
                                    Ouvrir
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="ui message">
                <div class="header">Aucune intervention</div>
                <p>Ce client n’a encore aucune intervention liée.</p>
            </div>
        {% endif %}
    </div>
</div>

<script>
(function () {
    const btn = document.getElementById('toggleAddressBtn');
    const wrap = document.getElementById('addressFieldsWrap');

    if (!btn || !wrap) return;

    btn.addEventListener('click', function () {
        wrap.style.display = wrap.style.display === 'none' ? 'block' : 'none';
    });
})();
</script>

{% endblock %}
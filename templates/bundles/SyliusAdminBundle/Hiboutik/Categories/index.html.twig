{% extends '@!SyliusAdmin/layout.html.twig' %}
{% block title %}Catégories Hiboutik{% endblock %}

{% macro renderTree(childrenByParent, parentId, level) %}
  {% import _self as self %}
  {% set kids = childrenByParent[parentId]|default([]) %}

  {% if kids|length %}
    <div class="ui list" style="margin-left: {{ level * 18 }}px">
      {% for c in kids %}
        {% set id = c.category_id|default(0) %}

        <div class="item">
          <i class="folder outline icon"></i>

          <div class="content">
            <div class="header">

              <!-- 🔥 CLICK CAT -->
              <strong style="cursor:pointer"
                onclick="selectCategory({{ id }}, '{{ c.category_name|e('js') }}')">
                {{ c.category_name|default('—') }}
              </strong>

              <span class="ui tiny basic label">#{{ id }}</span>

            </div>

            {{ self.renderTree(childrenByParent, id, level + 1) }}
          </div>
        </div>

      {% endfor %}
    </div>
  {% endif %}
{% endmacro %}

{% block content %}

{# Top menu dans le pre_content du Layout Admin #}

<div style="display:flex">

  <!-- GAUCHE -->
  <div style="width:40%">

    <h1 class="ui header">Catégories Hiboutik</h1>

    {% import _self as self %}

    {% for r in roots %}
      <div class="item">

        <!-- 🔥 CLICK ROOT -->
        <strong style="cursor:pointer"
          onclick="selectCategory({{ r.category_id }}, '{{ r.category_name|e('js') }}')">
          {{ r.category_name }}
        </strong>

        {{ self.renderTree(childrenByParent, r.category_id, 1) }}

      </div>
    {% endfor %}

  </div>

  <!-- DROITE -->
  <div style="width:60%; padding-left:20px">

  <h3 id="catTitle">Clique une catégorie</h3>

  <div id="attrList"></div>

  <hr>

  <div class="ui form">
    <div class="field">
      <label>Label</label>
      <input id="label" placeholder="Nom">
    </div>

    <div class="field">
      <label>Type</label>
      <select id="type">
        <option value="text">Texte</option>
        <option value="select">Liste</option>
      </select>
    </div>

    <div class="field">
      <label>Options</label>
      <input id="options" placeholder="64Go,128Go,Violet,Noir">
    </div>

    <div class="field">
      <label>Code</label>
      <input id="codePreview" placeholder="généré automatiquement" disabled>
      <div style="font-size:12px;color:#666;margin-top:4px;">
        Le code n’est pas modifié en édition pour ne pas casser les données déjà saisies.
      </div>
    </div>

    <div style="display:flex; gap:8px; flex-wrap:wrap;">
      <button class="ui primary button" type="button" onclick="saveAttr()" id="saveBtn">Créer</button>
      <button class="ui button" type="button" onclick="resetForm()">Annuler</button>
    </div>
  </div>

</div>

<script>
let CURRENT_CAT = null;
let CURRENT_EDIT_ID = null;
let CURRENT_ATTRS = [];

// SELECT CAT
function selectCategory(catId, catName){
  CURRENT_CAT = catId;
  CURRENT_EDIT_ID = null;
  document.getElementById('catTitle').innerText = catName;
  resetForm(false);
  loadAttributes();
}

// LOAD ATTR
async function loadAttributes(){
  if(!CURRENT_CAT) return;

  const res = await fetch('/admin/hiboutik/categories/attributes/' + CURRENT_CAT);

  if(!res.ok){
    alert("Erreur API attributes");
    return;
  }

  const data = await res.json();
  CURRENT_ATTRS = data;

  const div = document.getElementById('attrList');
  div.innerHTML = '';

  if(!data.length){
    div.innerHTML = "<div class='ui message'>Aucun attribut</div>";
    return;
  }

  data.forEach(a => {
    const optionsText = (a.options || []).join(', ');

    const el = document.createElement('div');
    el.className = 'ui segment';
    el.innerHTML = `
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;">
        <div>
          <div><b>${escapeHtml(a.label)}</b></div>
          <div style="margin-top:4px;color:#666;font-size:12px;">
            code: <code>${escapeHtml(a.code)}</code>
            &nbsp;|&nbsp;
            type: <b>${escapeHtml(a.type)}</b>
          </div>
          ${
            a.type === 'select'
              ? `<div style="margin-top:6px;font-size:12px;color:#444;">options: ${escapeHtml(optionsText || '—')}</div>`
              : ''
          }
        </div>

        <div style="display:flex;gap:6px;flex-shrink:0;">
          <button class="ui tiny button" type="button" onclick="editAttr(${a.id})">Éditer</button>
          <button class="ui tiny red button" type="button" onclick="deleteAttr(${a.id})">Supprimer</button>
        </div>
      </div>
    `;
    div.appendChild(el);
  });
}

// SAVE = create ou update
async function saveAttr(){
  if(!CURRENT_CAT){
    alert("Choisis une catégorie");
    return;
  }

  const label = document.getElementById('label').value.trim();
  const type = document.getElementById('type').value;
  const options = document.getElementById('options').value.trim();

  if(!label){
    alert("Le label est obligatoire");
    return;
  }

  let url = '/admin/hiboutik/categories/attributes/create';
  let payload = {
    category_id: CURRENT_CAT,
    label,
    type,
    options
  };

  if(CURRENT_EDIT_ID){
    url = '/admin/hiboutik/categories/attributes/' + CURRENT_EDIT_ID + '/update';
    payload = {
      label,
      type,
      options
    };
  }

  const res = await fetch(url, {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(payload)
  });

  if(!res.ok){
    const txt = await res.text();
    console.error(txt);
    alert(CURRENT_EDIT_ID ? "Erreur modification" : "Erreur création");
    return;
  }

  resetForm(false);
  loadAttributes();
}

function editAttr(id){
  const a = CURRENT_ATTRS.find(x => Number(x.id) === Number(id));
  if(!a) return;

  CURRENT_EDIT_ID = a.id;

  document.getElementById('label').value = a.label || '';
  document.getElementById('type').value = a.type || 'text';
  document.getElementById('options').value = (a.options || []).join(', ');
  document.getElementById('codePreview').value = a.code || '';
  document.getElementById('saveBtn').innerText = 'Enregistrer';
}

async function deleteAttr(id){
  if(!confirm("Supprimer cet attribut ?")) return;

  const res = await fetch('/admin/hiboutik/categories/attributes/' + id + '/delete', {
    method: 'POST'
  });

  if(!res.ok){
    const txt = await res.text();
    console.error(txt);
    alert("Erreur suppression");
    return;
  }

  if(CURRENT_EDIT_ID === id){
    resetForm(false);
  }

  loadAttributes();
}

function resetForm(clearCategory = false){
  CURRENT_EDIT_ID = null;
  document.getElementById('label').value = '';
  document.getElementById('type').value = 'text';
  document.getElementById('options').value = '';
  document.getElementById('codePreview').value = '';
  document.getElementById('saveBtn').innerText = 'Créer';

  if(clearCategory){
    CURRENT_CAT = null;
  }
}

function escapeHtml(str){
  return String(str ?? '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#039;');
}
</script>

{% endblock %}
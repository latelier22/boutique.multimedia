{% extends '@!SyliusAdmin/layout.html.twig' %}
{% block title %}Catégories Hiboutik{% endblock %}

{% macro renderTree(childrenByParent, parentId, level) %}
  {% import _self as self %}
  {% set kids = childrenByParent[parentId]|default([]) %}

  {% if kids|length %}
    <div class="ui list" style="margin-left: {{ level * 18 }}px">
      {% for c in kids %}
        {% set id = c.category_id|default(0) %}
        <div class="item">
          <i class="folder outline icon"></i>
          <div class="content">
            <div class="header">
              <strong>{{ c.category_name|default('—') }}</strong>
              <span class="ui tiny basic label">#{{ id }}</span>
              <span class="ui tiny basic label">parent {{ c.category_id_parent|default(0) }}</span>

              {% if c.category_enabled|default(0) %}
                <span class="ui tiny green label">Actif</span>
              {% else %}
                <span class="ui tiny red label">Inactif</span>
              {% endif %}
              <form class="js-toggle-www" method="post"
      action="{{ path('admin_hiboutik_categories_toggle_www', {id: c.category_id}) }}"
      style="display:inline">
  <input type="hidden" name="_token" value="{{ csrf_token('hib_cat_toggle_www_' ~ c.category_id) }}">
  <input type="hidden" name="current" value="{{ c.category_enabled_www|default(0) }}">

  {% set isWww = c.category_enabled_www|default(0) %}
  <button type="submit" class="ui tiny {{ isWww ? 'blue' : 'grey' }} button">
    {{ isWww ? 'WWW: Oui' : 'WWW: Non' }}
  </button>
</form>
            </div>

            {{ self.renderTree(childrenByParent, id, level + 1) }}
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
{% endmacro %}

{% block content %}
  <h1 class="ui header">🗂️ Catégories Hiboutik</h1>

  <div class="ui message">
    <strong>Total :</strong> {{ categories|length }}
    — <strong>Racines :</strong> {{ roots|length }}
  </div>

  {% import _self as self %}

  <div class="ui list">
    {% for r in roots %}
      <div class="item">
        <i class="sitemap icon"></i>
        <div class="content">
          <div class="header">
  <strong>{{ r.category_name|default('—') }}</strong>
  <span class="ui tiny basic label">#{{ r.category_id|default('—') }}</span>
  <span class="ui tiny basic label">parent {{ r.category_id_parent|default(0) }}</span>

  {% if r.category_enabled|default(0) %}
    <span class="ui tiny green label">Actif</span>
  {% else %}
    <span class="ui tiny red label">Inactif</span>
  {% endif %}

  <form class="js-toggle-www" method="post"
        action="{{ path('admin_hiboutik_categories_toggle_www', {id: r.category_id}) }}"
        style="display:inline">
    <input type="hidden" name="_token" value="{{ csrf_token('hib_cat_toggle_www_' ~ r.category_id) }}">
    <input type="hidden" name="current" value="{{ r.category_enabled_www|default(0) }}">

    {% set isWww = r.category_enabled_www|default(0) %}
    <button type="submit" class="ui tiny {{ isWww ? 'blue' : 'grey' }} button">
      {{ isWww ? 'WWW: Oui' : 'WWW: Non' }}
    </button>
  </form>
</div>

          {{ self.renderTree(childrenByParent, r.category_id|default(0), 1) }}
        </div>
      </div>
    {% else %}
      <div class="ui warning message">Aucune catégorie.</div>
    {% endfor %}
  </div>

<script>
document.addEventListener('submit', async (e) => {
  const form = e.target;
  if (!form.classList.contains('js-toggle-www')) return;
  e.preventDefault();

  const btn = form.querySelector('button');
  const fd = new FormData(form);

  btn.classList.add('loading');

  try {
    const res = await fetch(form.action, {
      method: 'POST',
      body: fd,
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    });

    const txt = await res.text(); // au cas où (debug)
    if (!res.ok) {
      console.error('HTTP', res.status, txt);
      alert('Erreur HTTP ' + res.status);
      return;
    }

    // Ici, notre controller renvoie du JSON, mais même si ça change, on s’en fout.
    // On flippe le bouton en se basant sur le hidden "current"
    const currentInput = form.querySelector('input[name="current"]');
    const current = Number(currentInput.value || '0');
    const next = current ? 0 : 1;

    btn.classList.toggle('blue', !!next);
    btn.classList.toggle('grey', !next);
    btn.textContent = next ? 'WWW: Oui' : 'WWW: Non';
    currentInput.value = String(next);

  } catch (err) {
    console.error(err);
    alert('Erreur réseau');
  } finally {
    btn.classList.remove('loading');
  }
});
</script>
{% endblock %}


<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Test A5</title>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
        }

        body {
            font-family: Arial, sans-serif;
        }

        .page {
            position: relative;
            width: 100%;
            height: 100%;
            border: 1mm solid red;
            box-sizing: border-box;
            background: white;
        }

        .txt {
            position: absolute;
            top: 5mm;
            left: 5mm;
            font-size: 6mm;
        }

        .line1, .line2 {
            position: absolute;
            left: 0;
            width: 100%;
            border-top: 0.3mm dashed blue;
            box-sizing: border-box;
        }

        .line1 { top: 70mm; }
        .line2 { top: 140mm; }
    </style>
</head>
<body>
    <div class="page">
        <div class="txt">TEST VRAIE PAGE A5</div>
        <div class="line1"></div>
        <div class="line2"></div>
    </div>
</body>
</html>




{% extends '@!SyliusAdmin/layout.html.twig' %}

{% block content %}

<h2 class="ui header">
  Images produit #{{ product.product_id }}
</h2>

<script>
const uploadUrl = "{{ path('admin_hiboutik_product_images', {id: product.product_id}) }}";
let selectedFiles = {};
</script>

{% include '@SyliusAdmin/Hiboutik/Products/_images_grid.html.twig' %}

<script>
function previewImage(event, id) {
    const file = event.target.files[0];
    if (!file) return;

    selectedFiles[id] = file;

    const reader = new FileReader();
    reader.onload = function (e) {
        const img = document.getElementById('preview-' + id);
        if (img) img.src = e.target.result;
    };
    reader.readAsDataURL(file);
}

function uploadImage(id) {
    if (!selectedFiles[id]) {
        alert("Choisir une image");
        return;
    }

    const formData = new FormData();
    formData.append('image', selectedFiles[id]);
    formData.append('image_id', id);

    fetch(uploadUrl, {
        method: 'POST',
        body: formData,
        credentials: 'same-origin',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(function (r) { return r.text(); })
    .then(function (t) {
        console.log("UPLOAD RESPONSE:", t);
        location.reload();
    })
    .catch(function (err) {
        console.error(err);
        alert("Erreur réseau upload");
    });
}

function deleteImage(imageName) {
    if (!confirm("Supprimer ?")) return;

    const formData = new FormData();
    formData.append('delete_image', imageName);

    fetch(uploadUrl, {
        method: 'POST',
        body: formData,
        credentials: 'same-origin',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(function (r) { return r.text(); })
    .then(function (t) {
        console.log("DELETE RESPONSE:", t);
        location.reload();
    })
    .catch(function (err) {
        console.error(err);
        alert("Erreur suppression");
    });
}

async function pasteImage(id) {
    try {
        const items = await navigator.clipboard.read();

        for (const item of items) {
            for (const type of item.types) {
                if (type.startsWith('image/')) {
                    const blob = await item.getType(type);
                    const file = new File([blob], "paste.png", { type: type });

                    selectedFiles[id] = file;

                    const reader = new FileReader();
                    reader.onload = function (e) {
                        const img = document.getElementById('preview-' + id);
                        if (img) img.src = e.target.result;
                    };
                    reader.readAsDataURL(file);

                    setTimeout(function () {
                        uploadImage(id);
                    }, 100);

                    return;
                }
            }
        }

        alert("Aucune image copiée");
    } catch (err) {
        console.warn("Clipboard bloqué", err);
        alert("Clique puis CTRL+V");
    }
}
</script>

{% endblock %}
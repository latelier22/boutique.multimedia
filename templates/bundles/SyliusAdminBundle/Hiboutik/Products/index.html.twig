<script>
	document.addEventListener('DOMContentLoaded', function () {
function syncStickyOffsets() {
const root = document.documentElement;
const topbar = document.querySelector('.admin-layout__topbar');
const stickyTop = document.getElementById('stickyTop');

const topbarH = topbar ? Math.ceil(topbar.offsetHeight) : 56;
const stickyH = stickyTop ? Math.ceil(stickyTop.offsetHeight) : 260;

root.style.setProperty('--hib-topbar-h', topbarH + 'px');
root.style.setProperty('--hib-sticky-h', stickyH + 'px');
root.style.setProperty('--hib-sticky-top', (topbarH + stickyH) + 'px');
}

syncStickyOffsets();
window.addEventListener('resize', syncStickyOffsets);
window.addEventListener('load', syncStickyOffsets);
});
</script>

<script>
	window.addEventListener('pageshow', function (event) {
if (event.persisted) {
window.location.reload();
}
});
</script>{% endblock %}

{% extends '@!SyliusAdmin/layout.html.twig' %}

{% block title %}Produits Hiboutik{% endblock %}

{% block content %}
{# {% include '@SyliusAdmin/Rachat/_menu_rachats.html.twig' %} #}
<h1 class="ui header">📦 Produits Hiboutik</h1>
{# 
<form method="post" action="{{ path('admin_arrivages_create') }}" style="margin-bottom: 1em;">
  <button type="submit" class="ui green button">
    <i class="plus icon"></i> Créer l’arrivage du mois
  </button>
</form> #}

<div class="ui label">
  count =
  {{ products is iterable ? (products|length) : 'NOT ITERABLE' }}
</div>
{# 
<pre style="white-space:pre-wrap;max-height:200px;overflow:auto">
{{ dump(products) }}
</pre> #}

<table class="ui celled table">
  <thead>
    <tr>
      <th>ID</th>
      <th>Nom</th>
      <th>Prix</th>
      <th>En ligne</th>

      
      
    </tr>
  </thead>
  <tbody>

  {% for p in products %}
    <tr>
      <td>{{ p.product_id ?? '—' }}</td>
      <td>{{ p.product_model ?? '—' }}</td>
      <td>{{ p.product_price ?? '—' }}</td>
      <td>{{ p.product_display_www ? 'Oui' : 'Non' }}</td>     
 </tr>
    {% else %}
        <tr>
        <td colspan="4" class="center aligned">Aucun produit trouvé.</td>
        </tr>
    {% endfor %}

  </tbody>
</table>
{% endblock %}


<div class="ui grid">
{% for i in 1..4 %}
  {% set directUrl = '' %}
  {% set imageName = '' %}

  {% for img in images %}
    {% if img.image_name|default('') == 'big_' ~ product.product_id ~ '-' ~ i ~ '.jpg'
       or img.image_name|default('') == 'big_' ~ product.product_id ~ '-' ~ i ~ '.jpeg' %}
      {% set directUrl = img.url|default('') %}
      {% set imageName = img.image_name|default('') %}
    {% endif %}
  {% endfor %}

  <div class="four wide column">
    <div class="ui segment center aligned" data-slot="{{ i }}">
      {% if directUrl %}
        <img id="preview-{{ i }}"
             src="{{ directUrl }}"
             style="max-width:100%; min-height:150px; background:#f5f5f5; object-fit:contain"
             onerror="this.style.border='3px solid red';">
      {% else %}
        <div id="preview-{{ i }}"
             style="width:100%; min-height:150px; background:#fff7ed; display:flex; align-items:center; justify-content:center; color:#9a3412;">
          Aucune image
        </div>
      {% endif %}

      <div style="margin-top:8px;">Image {{ i }}</div>

      <input type="file"
             id="input-{{ i }}"
             accept="image/*"
             style="display:none"
             onchange="previewImage(event, {{ i }})">

      <div style="margin-top:10px; display:flex; gap:8px; flex-wrap:wrap; justify-content:center;">
        <button type="button" class="ui button" onclick="document.getElementById('input-{{ i }}').click()">
          Modifier / ajouter
        </button>

        <button type="button" class="ui button" onclick="pasteImage({{ i }})">
          📋 Paste
        </button>

        <button type="button" class="ui primary button" onclick="uploadImage({{ i }})">
          Envoyer
        </button>

        {% if imageName %}
          <button type="button" class="ui red button" onclick="deleteImage('{{ imageName|e('js') }}')">
            🗑
          </button>
        {% endif %}
      </div>
    </div>
  </div>
{% endfor %}
</div>
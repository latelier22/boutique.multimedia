{# templates/bundles/SyliusAdminBundle/Rachat/sign_multi.html.twig #}
{% extends '@!SyliusAdmin/layout.html.twig' %}
{% block title %}Signature bon de cession multi{% endblock %}

{% block content %}
<script src="https://cdn.jsdelivr.net/npm/signature_pad@4.2.0/dist/signature_pad.umd.min.js"></script>

<h1 class="ui header">Signature – Bon de cession multi</h1>

<p>Vendeur : <strong>{{ rachats[0].prenom }} {{ rachats[0].nom }}</strong></p>

<p>Rachats concernés :</p>
<ul>
  {% for r in rachats %}
    <li>#{{ r.id }} – {{ r.marqueModele }} – {{ r.prixAchat }} €</li>
  {% endfor %}
</ul>

<style>
  /* Important pour mobile : empêche le scroll/zoom quand on signe */
  #signature-pad {
    width: 100%;
    max-width: 520px;
    height: 200px;
    display: block;
    border: 1px dashed #94a3b8;
    border-radius: 8px;
    background: #fff;
    touch-action: none;
  }
  .sig-toolbar { display:flex; gap:8px; margin-top:10px; flex-wrap:wrap; }
</style>

<canvas id="signature-pad"></canvas>

<div class="sig-toolbar">
  <button type="button" id="clear-btn" class="ui button">Effacer</button>

  <button type="button" id="undo-btn" class="ui button">Annuler un trait</button>

  <button type="submit" form="sig-form" class="ui primary button">
    ✅ Valider la signature et générer le PDF
  </button>
</div>

<form id="sig-form" method="post" action="{{ path('admin_rachats_multi_sign_submit') }}">
  <input type="hidden" name="ids" value="{{ ids_string }}">
  <input type="hidden" name="signature_dataurl" id="signature_dataurl">
</form>

<script>
(function(){
  const canvas = document.getElementById('signature-pad');
  const pad = new SignaturePad(canvas, {
    minWidth: 0.9,
    maxWidth: 2.8,
    penColor: '#111',
    backgroundColor: '#fff'
  });

  function resizeCanvas(){
    const ratio = Math.max(window.devicePixelRatio || 1, 1);
    const rect = canvas.getBoundingClientRect();

    // on sauvegarde les traits existants
    const data = pad.isEmpty() ? null : pad.toData();

    canvas.width  = Math.floor(rect.width * ratio);
    canvas.height = Math.floor(rect.height * ratio);

    const ctx = canvas.getContext('2d');
    ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

    pad.clear();
    if (data) pad.fromData(data);
  }

  // resize au chargement + quand l'écran change
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);

  // si dispo, observe les changements de taille du conteneur
  if (window.ResizeObserver) {
    new ResizeObserver(resizeCanvas).observe(canvas);
  }

  document.getElementById('clear-btn').addEventListener('click', () => pad.clear());

  document.getElementById('undo-btn').addEventListener('click', () => {
    const d = pad.toData();
    d.pop();
    pad.fromData(d);
  });

  document.getElementById('sig-form').addEventListener('submit', (e) => {
    if (pad.isEmpty()) {
      e.preventDefault();
      alert('Signature vide.');
      return;
    }
    document.getElementById('signature_dataurl').value = pad.toDataURL('image/png');
  });
})();
</script>
{% endblock %}

{% extends '@!SyliusAdmin/layout.html.twig' %}

{% block title %}Rachat multi{% endblock %}

{% block content %}
<div class="ui segment">
  <h2 class="ui header">Rachat multi</h2>

  <form class="ui form" method="post" enctype="multipart/form-data">
    {# --- VENDEUR --- #}
    <h4 class="ui dividing header">Vendeur</h4>
    <div class="three fields">
      <div class="field">
        <label>Nom</label>
        <input type="text" name="nom" required>
      </div>
      <div class="field">
        <label>Prénom</label>
        <input type="text" name="prenom" required>
      </div>
      <div class="field">
        <label>Numéro de pièce d'identité</label>
        <input type="text" name="numero_ci">
      </div>
    </div>

    <div class="three fields">
      <div class="field">
        <label>Téléphone</label>
        <input type="text" name="telephone">
      </div>
      <div class="field">
        <label>Email</label>
        <input type="email" name="email">
      </div>
      <div class="field">
        <label>Code postal</label>
        <input type="text" name="code_postal">
      </div>
    </div>

    <div class="field">
      <label>Adresse</label>
      <textarea name="adresse" rows="2"></textarea>
    </div>

    <div class="field">
      <label>Date de cession</label>
      <input type="date" name="date_cession">
    </div>

    {# --- CI --- #}
    <h4 class="ui dividing header">Pièce d'identité</h4>
    <div class="two fields">
      <div class="field">
        <label>Recto</label>
        <input type="file" name="ci_recto" accept="image/*" id="ci_recto">
        <img id="ci_recto_preview"
             style="display:none;max-width:220px;margin-top:.5rem;border:1px solid #ddd;border-radius:4px;">
      </div>
      <div class="field">
        <label>Verso</label>
        <input type="file" name="ci_verso" accept="image/*" id="ci_verso">
        <img id="ci_verso_preview"
             style="display:none;max-width:220px;margin-top:.5rem;border:1px solid #ddd;border-radius:4px;">
      </div>
    </div>

    {# --- PRODUITS --- #}
    <h4 class="ui dividing header">Produits</h4>

    <table class="ui celled table" id="products-table">
      <thead>
        <tr>
          <th>Libellé</th>
          <th>IMEI</th>
          <th>Prix rachat (€)</th>
          <th>Photos</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      </tbody>
    </table>

    <button type="button" class="ui button" id="add-product-btn">
      <i class="plus icon"></i> Ajouter un produit
    </button>

    <div class="ui divider"></div>

    <button type="submit" class="ui primary button">
      <i class="file signature icon"></i> Enregistrer et aller à la signature
    </button>
    <a href="{{ path('admin_rachats_index') }}" class="ui button">
      <i class="left arrow icon"></i> Retour
    </a>
  </form>
</div>

<script>
(function(){
  // Aperçu CI recto / verso
  function bindPreview(inputId, imgId) {
    const input = document.getElementById(inputId);
    const img   = document.getElementById(imgId);
    if (!input || !img) return;

    input.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (ev) => {
        img.src = ev.target.result;
        img.style.display = 'block';
      };
      reader.readAsDataURL(file);
    });
  }

  bindPreview('ci_recto', 'ci_recto_preview');
  bindPreview('ci_verso', 'ci_verso_preview');

  // Gestion des lignes produit
  let index = 0;
  const tbody = document.querySelector('#products-table tbody');
  const addBtn = document.getElementById('add-product-btn');

  function addRow() {
    const i = index++;
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td>
        <input type="text" name="marque_modele[]" placeholder="iPhone 13 128 Go" required>
      </td>
      <td>
        <input type="text" name="imei[]" placeholder="IMEI (optionnel)">
      </td>
      <td>
        <input type="number" step="0.01" min="0" name="prix_achat[]" placeholder="Prix" required>
      </td>
      <td>
        <input type="file" name="photos_${i}[]" multiple accept="image/*">
        <div class="ui tiny images" id="photos_preview_${i}" style="margin-top:.5rem;"></div>
      </td>
      <td class="collapsing">
        <button type="button" class="ui tiny red icon button remove-product">
          <i class="trash icon"></i>
        </button>
      </td>
    `;
    tbody.appendChild(tr);

    const photosInput = tr.querySelector(`input[name="photos_${i}[]"]`);
    const previewDiv  = tr.querySelector(`#photos_preview_${i}`);
    if (photosInput && previewDiv) {
      photosInput.addEventListener('change', (e) => {
        previewDiv.innerHTML = '';
        Array.from(e.target.files || []).forEach((file) => {
          if (!file.type.startsWith('image/')) return;
          const r = new FileReader();
          r.onload = (ev) => {
            const img = document.createElement('img');
            img.src = ev.target.result;
            img.style.maxHeight = '80px';
            img.style.borderRadius = '4px';
            img.style.border = '1px solid #ddd';
            img.style.marginRight = '4px';
            previewDiv.appendChild(img);
          };
          r.readAsDataURL(file);
        });
      });
    }

    const rmBtn = tr.querySelector('.remove-product');
    rmBtn.addEventListener('click', () => {
      tr.remove();
    });
  }

  addBtn.addEventListener('click', addRow);
  addRow(); // première ligne par défaut
})();
</script>
{% endblock %}

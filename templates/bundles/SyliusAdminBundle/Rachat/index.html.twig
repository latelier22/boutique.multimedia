					{% endfor %}
				</tbody>
			</table>
		</div>
	</form>


 {% for row in rows %}
    {% if row.id is not empty and not row.dossierV2Existe %}
        <form
            id="create-dossier-form-{{ row.id }}"
            method="post"
            action="{{ path('admin_rachats_create_dossier', { id: row.id }) }}"
            style="display:none;"
        >
            <input type="hidden" name="_token" value="{{ csrf_token('create_dossier_' ~ row.id) }}">

        </form>
    {% endif %}
{% endfor %}   
</div>

<script>
	(function () {
function bootYmFilter() {
const all = document.getElementById('ym_all');
const hid = document.getElementById('ym_hidden');
const mon = document.getElementById('ym_month');

if (! all || ! hid || ! mon) 
return;


function syncYmOnly() {
if (all.checked) {
hid.value = 'all';
mon.disabled = true;
} else {
mon.disabled = false;
hid.value = mon.value || '';
}
}

syncYmOnly();

if (! all.dataset.bound) {
all.dataset.bound = '1';
all.addEventListener('change', syncYmOnly);
}

if (! mon.dataset.bound) {
mon.dataset.bound = '1';
mon.addEventListener('change', syncYmOnly);
}
}

if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', bootYmFilter, {once: true});
} else {
bootYmFilter();
}

document.addEventListener('turbo:load', bootYmFilter);
})();
</script>

<script>
	(function () {
function bootRachatSelect() {
const form = document.getElementById('rachats_form');
if (! form) 
return;


const checkAll = form.querySelector('#check_all');
const getRowChecks = () => Array.from(form.querySelectorAll('tbody .js-rachat-row-check'));

function refreshMaster() {
if (! checkAll) 
return;


const checks = getRowChecks();
const total = checks.length;
const checked = checks.filter(cb => cb.checked).length;

checkAll.checked = total > 0 && checked === total;
checkAll.indeterminate = checked > 0 && checked < total;
}

if (checkAll && ! checkAll.dataset.bound) {
checkAll.dataset.bound = '1';

checkAll.addEventListener('change', function () {
const checked = checkAll.checked;
getRowChecks().forEach(function (cb) {
cb.checked = checked;
});
refreshMaster();
});
}

if (! form.dataset.boundRowChecks) {
form.dataset.boundRowChecks = '1';

form.addEventListener('change', function (e) {
if (e.target && e.target.classList.contains('js-rachat-row-check')) {
refreshMaster();
}
});
}

refreshMaster();
}

if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', bootRachatSelect, {once: true});
} else {
bootRachatSelect();
}

document.addEventListener('turbo:load', bootRachatSelect);
})();
</script>

<script>
	(function () {
function bootBatchButtons() {
const form = document.getElementById('rachats_form');
if (! form) 
return;


const btnMasquer = form.querySelector('button[name="val"][value="0"]');
const btnReveler = form.querySelector('button[name="val"][value="1"]');
const btnEncaisser = form.querySelector('button[formaction*="encaissement_batch"]');
const btnCreateDossiersBatch = document.getElementById('btnCreateDossiersBatch');

function getSelected() {
const values = new Set();
form.querySelectorAll('.js-rachat-row-check:checked').forEach(function (cb) {
values.add(cb.value);
});
return Array.from(values);
}

function setDisabled(el, disabled) {
if (! el) 
return;

el.disabled = disabled;
el.classList.toggle('rbtn-disabled', disabled);
}

function refresh() {
const any = getSelected().length > 0;
setDisabled(btnMasquer, ! any);
setDisabled(btnReveler, ! any);
setDisabled(btnEncaisser, ! any);
setDisabled(btnCreateDossiersBatch, ! any);
}

if (! form.dataset.boundBatch) {
form.dataset.boundBatch = '1';

form.addEventListener('change', function (e) {
if (e.target && (e.target.matches('.js-rachat-row-check') || e.target.matches('#check_all'))) {
refresh();
}
});
}

refresh();
}

if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', bootBatchButtons, {once: true});
} else {
bootBatchButtons();
}

document.addEventListener('turbo:load', bootBatchButtons);
})();
</script>{% endblock %}

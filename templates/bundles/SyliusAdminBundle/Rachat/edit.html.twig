                    </div>
                </div>
            </div>

            <div class="ci-upload-manual">
                <h4 class="ui dividing header">Upload manuel</h4>

                <div class="ui form">
                    <div class="fields">
                        <div class="eight wide field">
                            <label>Fichier recto</label>
                            <input type="file" id="ciManualRecto" accept="image/*">
                        </div>

                        <div class="eight wide field">
                            <label>Fichier verso</label>

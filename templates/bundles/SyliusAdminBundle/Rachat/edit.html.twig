            </div>
          </div>
        </div>

        <div id="ci-saved" class="ui segment" style="background:#f8fafc; display:none">
          <div class="ui header">Pièce d'identité enregistrée</div>
          <div id="ci-saved-list" style="display:flex;flex-wrap:wrap;gap:10px"></div>
        </div>
      </div>

      <div class="ui segment">
        <h3 class="ui header">
          <i class="camera icon"></i>
          Photos produit
        </h3>

        <div class="field">
          {{ form_row(form.photoFiles) }}
          <div class="muted" style="margin-top:.3rem">
            Les photos seront compressées en JPEG ≤ 1 Mo et stockées localement.
          </div>
        </div>
      </div>

    </div>
  </div>

  {# ===================== ACTIONS ===================== #}
  <div class="ui segment">
    <div style="display:flex; gap:10px; flex-wrap:wrap;">
      <button class="ui primary button" type="submit">
        <i class="save icon"></i>
        Enregistrer
      </button>

      {% if rachat.id %}
        <button type="button" id="btn-save-and-sign" class="ui button">
          <i class="edit outline icon"></i>
          Signer
        </button>

        <button type="button" id="btn-open-on-tablet" class="ui teal button">
          <i class="tablet alternate icon"></i>
          Ouvrir sur tablette
        </button>

        <button type="button" class="ui button" id="btn-tablet-sign"

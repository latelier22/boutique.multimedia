<script>
/* ===================== Recherche revendeur + appliquer ===================== */
(function () {
  const inp = document.getElementById('rev-search');
  const results = document.getElementById('rev-results');
  const tokenEl = document.getElementById('apply_revendeur_token');

  if (!inp || !results || !tokenEl) return;

  const token = tokenEl.value;
  let timer = null;
  let abortCtl = null;

  function setVal(name, value) {
    const el = document.querySelector(`[name="${name}"]`);
    if (el) el.value = value ?? '';
  }

  function render(list) {
    results.innerHTML = (list || []).map(v => `
      <div class="item" style="cursor:pointer;padding:.6rem;border-bottom:1px solid #eee" data-id="${v.id}">
        <i class="user icon"></i>
        <div class="content">
          <div class="header">${v.label}</div>
        </div>
      </div>
    `).join('');

    results.querySelectorAll('.item').forEach(el => {
      el.addEventListener('click', async () => {
        const revId = el.getAttribute('data-id');
        if (!revId) {
          alert('ID revendeur manquant');
          return;
        }

        try {
          const fd = new FormData();
          fd.append('_token', token);
          fd.append('revendeur_id', revId);

          const r = await fetch(`{{ path('admin_rachats_apply_revendeur', { id: rachat.id }) }}`, {
            method: 'POST',
            body: fd,
            headers: {
              'X-Requested-With': 'XMLHttpRequest'
            }
          });

          const txt = await r.text();

          let data = {};
          try {
            data = JSON.parse(txt);
          } catch (e) {
            alert('La réponse n’est pas du JSON. Regarde la console.');
            return;
          }

          if (!r.ok || !data.ok) {
            alert(data.error || ('Erreur HTTP ' + r.status));
            return;
          }

          setVal('rachat[nom]', data.filled?.nom);
          setVal('rachat[prenom]', data.filled?.prenom);
          setVal('rachat[telephone]', data.filled?.telephone);
          setVal('rachat[email]', data.filled?.email);
          setVal('rachat[adresse]', data.filled?.adresse);
          setVal('rachat[codePostal]', data.filled?.code_postal);

          results.innerHTML = '';
          inp.value = '';

          alert('Revendeur appliqué');
        } catch (e) {
          console.error('[REV] erreur apply', e);
          alert('Erreur JS / réseau, regarde la console');
        }
      });
    });
  }

  inp.addEventListener('input', () => {
    clearTimeout(timer);
    const q = inp.value.trim();

    if (q.length < 2) {
      results.innerHTML = '';
      return;
    }

    timer = setTimeout(async () => {
      try {
        if (abortCtl) abortCtl.abort();
        abortCtl = new AbortController();

        const res = await fetch(`/admin/revendeurs/search?q=${encodeURIComponent(q)}`, {
          signal: abortCtl.signal,
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });

        const txt = await res.text();

        let list = [];
        try {
          list = JSON.parse(txt);
        } catch (e) {
          results.innerHTML = '<div class="ui tiny red message">Réponse recherche invalide</div>';
          return;
        }

        render(list);
      } catch (e) {
        if (e.name !== 'AbortError') {
          console.error('[REV] search error', e);
        }
      }
    }, 250);
  });
})();
</script>


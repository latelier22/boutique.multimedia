                        </div>
                    </div>

                    <div class="fields">
                        <div class="eight wide field">
                            <button type="button" id="btnUploadRecto" class="ui orange fluid button">
                                Envoyer recto
                            </button>
                        </div>

                        <div class="eight wide field">
                            <button type="button" id="btnUploadVerso" class="ui blue fluid button">

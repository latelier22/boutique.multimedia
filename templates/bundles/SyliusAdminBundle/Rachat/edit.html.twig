<script>
(function () {
    const root = document.getElementById('ciWebcamBox');
    if (!root) return;

    const uploadUrl = root.dataset.uploadUrl;
    const csrfToken = root.dataset.csrf;

    const video = document.getElementById('ciVideo');
    const canvas = document.getElementById('ciCanvas');
    const cameraSelect = document.getElementById('ciCameraSelect');
    const btnStart = document.getElementById('btnStartCamera');
    const btnStop = document.getElementById('btnStopCamera');
    const statusBox = document.getElementById('ciCameraStatus');

    const previewRecto = document.getElementById('ciPreviewRecto');
    const previewVerso = document.getElementById('ciPreviewVerso');
    const previewRectoEmpty = document.getElementById('ciPreviewRectoEmpty');
    const previewVersoEmpty = document.getElementById('ciPreviewVersoEmpty');

    const manualRecto = document.getElementById('ciManualRecto');
    const manualVerso = document.getElementById('ciManualVerso');
    const btnUploadRecto = document.getElementById('btnUploadRecto');
    const btnUploadVerso = document.getElementById('btnUploadVerso');

    let stream = null;

    function showStatus(message, type) {
        statusBox.className = 'ui message';
        statusBox.classList.remove('ci-hidden');

        if (type === 'success') {
            statusBox.classList.add('positive');
        } else if (type === 'error') {
            statusBox.classList.add('negative');
        } else if (type === 'warning') {
            statusBox.classList.add('warning');
        } else {
            statusBox.classList.add('info');
        }

        statusBox.textContent = message;
    }

    function hideStatus() {
        statusBox.className = 'ui message ci-hidden';
        statusBox.textContent = '';
    }

    function setPreview(kind, url) {
        const cacheUrl = url + (url.indexOf('?') >= 0 ? '&' : '?') + 't=' + Date.now();

        if (kind === 'recto') {
            previewRecto.src = cacheUrl;
            previewRecto.classList.remove('ci-hidden');
            previewRectoEmpty.classList.add('ci-hidden');
        }

        if (kind === 'verso') {
            previewVerso.src = cacheUrl;
            previewVerso.classList.remove('ci-hidden');
            previewVersoEmpty.classList.add('ci-hidden');
        }
    }

    function stopCamera() {
        if (stream) {
            stream.getTracks().forEach(track => track.stop());
            stream = null;
        }
        video.srcObject = null;
    }

    async function loadCameras() {
        if (!navigator.mediaDevices || !navigator.mediaDevices.enumerateDevices) {
            return;
        }

        const devices = await navigator.mediaDevices.enumerateDevices();
        const cameras = devices.filter(d => d.kind === 'videoinput');

        cameraSelect.innerHTML = '<option value="">Caméra par défaut</option>';

        cameras.forEach((camera, index) => {
            const option = document.createElement('option');
            option.value = camera.deviceId;
            option.textContent = camera.label || ('Caméra ' + (index + 1));
            cameraSelect.appendChild(option);
        });
    }

    async function startCamera(deviceId) {
        hideStatus();
        stopCamera();

        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
            showStatus("Ce navigateur ne supporte pas l'accès webcam.", 'error');
            return;
        }

        try {
            const constraints = {
                audio: false,
                video: deviceId
                    ? {
                        deviceId: { exact: deviceId },
                        width: { ideal: 1920 },
                        height: { ideal: 1080 }
                    }
                    : {
                        width: { ideal: 1920 },
                        height: { ideal: 1080 }
                    }
            };

            stream = await navigator.mediaDevices.getUserMedia(constraints);
            video.srcObject = stream;
            await video.play();

            await loadCameras();

            const track = stream.getVideoTracks()[0];
            if (track && track.getSettings) {
                const settings = track.getSettings();
                if (settings.deviceId) {
                    cameraSelect.value = settings.deviceId;
                }
            }

            showStatus('Caméra active.', 'success');
        } catch (e) {
            console.error(e);
            showStatus("Impossible d'ouvrir la caméra : " + (e.message || 'erreur inconnue'), 'error');
        }
    }

    function captureBlob() {
        return new Promise((resolve, reject) => {
            const w = video.videoWidth || 0;
            const h = video.videoHeight || 0;

            if (!w || !h) {
                reject(new Error('Flux vidéo non prêt.'));
                return;
            }

            canvas.width = w;
            canvas.height = h;

            const ctx = canvas.getContext('2d');
            ctx.drawImage(video, 0, 0, w, h);

            canvas.toBlob(function (blob) {
                if (!blob) {
                    reject(new Error("Impossible de générer l'image."));
                    return;
                }
                resolve(blob);
            }, 'image/jpeg', 0.92);
        });
    }

    async function uploadCiBlob(kind, blob, filename) {
        const fd = new FormData();
        fd.append('_token', csrfToken);
        fd.append('kind', kind);
        fd.append('ci', blob, filename || ('ci-' + kind + '.jpg'));

        const response = await fetch(uploadUrl, {
            method: 'POST',
            body: fd,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        });

        const json = await response.json();

        if (!response.ok || !json.ok) {
            throw new Error(json.error || 'Erreur upload');
        }

        setPreview(kind, json.url);
        return json;
    }

    async function captureAndUpload(kind) {
        try {
            if (!stream) {
                await startCamera(cameraSelect.value);
                if (!stream) {
                    return;
                }
            }

            showStatus('Capture en cours...', 'info');
            const blob = await captureBlob();
            await uploadCiBlob(kind, blob, 'webcam-' + kind + '.jpg');
            showStatus('Photo ' + kind + ' enregistrée.', 'success');
        } catch (e) {
            console.error(e);
            showStatus('Erreur capture/upload : ' + (e.message || 'erreur inconnue'), 'error');
        }
    }

    async function manualUpload(kind, inputFile) {
        try {
            const file = inputFile.files && inputFile.files[0] ? inputFile.files[0] : null;
            if (!file) {
                showStatus('Aucun fichier sélectionné pour ' + kind + '.', 'warning');
                return;
            }

            showStatus('Envoi du fichier ' + kind + '...', 'info');
            await uploadCiBlob(kind, file, file.name || ('manuel-' + kind + '.jpg'));
            showStatus('Fichier ' + kind + ' enregistré.', 'success');
            inputFile.value = '';
        } catch (e) {
            console.error(e);
            showStatus('Erreur upload manuel : ' + (e.message || 'erreur inconnue'), 'error');
        }
    }

    btnStart.addEventListener('click', function () {
        startCamera(cameraSelect.value);
    });

    btnStop.addEventListener('click', function () {
        stopCamera();
        showStatus('Caméra fermée.', 'warning');
    });

    cameraSelect.addEventListener('change', function () {
        if (stream) {
            startCamera(cameraSelect.value);
        }
    });

    document.querySelectorAll('[data-capture-kind]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const kind = btn.getAttribute('data-capture-kind');
            if (kind === 'recto' || kind === 'verso') {
                captureAndUpload(kind);
            }
        });
    });

    btnUploadRecto.addEventListener('click', function () {
        manualUpload('recto', manualRecto);
    });

    btnUploadVerso.addEventListener('click', function () {
        manualUpload('verso', manualVerso);
    });

    window.addEventListener('beforeunload', function () {
        stopCamera();
    });

    if (navigator.mediaDevices && navigator.mediaDevices.enumerateDevices) {
        loadCameras().catch(function (e) {
            console.warn(e);
        });
    }
})();
</script>


{% endblock %}
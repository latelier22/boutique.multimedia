{% extends '@!SyliusAdmin/layout.html.twig' %}
{% block title %}Éditer rachat #{{ rachat.id ?? '—' }}{% endblock %}

{% block content %}
<div class="ui segment">
  <h2 class="ui header">Rachat #{{ rachat.id ?? '—' }}</h2>

  {{ form_start(form, { attr: { class: 'ui form', id: 'rachat-form' } }) }}

  <div class="two fields">
    <div class="field">{{ form_row(form.marqueModele) }}</div>
    <div class="field">{{ form_row(form.imei) }}</div>
  </div>

  <div class="three fields">
    <div class="field">{{ form_row(form.numeroCi) }}</div>
    <div class="field">{{ form_row(form.prixAchat) }}</div>
    <div class="field">{{ form_row(form.dateCession) }}</div>
  </div>

  <div class="three fields">
    <div class="field">{{ form_row(form.nom) }}</div>
    <div class="field">{{ form_row(form.prenom) }}</div>
    <div class="field">{{ form_row(form.telephone) }}</div>
  </div>

  <div class="two fields">
    <div class="field">{{ form_row(form.email) }}</div>
    <div class="field">{{ form_row(form.codePostal) }}</div>
  </div>

  <div class="field">{{ form_row(form.adresse) }}</div>

  <div class="two fields">
    <button class="ui primary button" type="submit">Enregistrer</button>
    <a class="ui button" href="{{ path('admin_rachats_index') }}">Retour liste</a>
  </div>

  <h4 class="ui dividing header">Pièce d'identité — Upload AJAX immédiat</h4>
  <div class="two fields">
    <div class="field">
      {{ form_row(form.pieceIdentiteRectoFile) }}
      <div id="ci-recto-preview" style="margin-top:.5rem;display:none">
        <div class="ui small header">Recto sélectionné</div>
        <img id="ci-recto-img" style="max-width:100%;border:1px solid #ccc;border-radius:6px">
      </div>
    </div>
    <div class="field">
      {{ form_row(form.pieceIdentiteVersoFile) }}
      <div id="ci-verso-preview" style="margin-top:.5rem;display:none">
        <div class="ui small header">Verso sélectionné</div>
        <img id="ci-verso-img" style="max-width:100%;border:1px solid #ccc;border-radius:6px">
      </div>
    </div>
  </div>

  <div id="ci-saved" class="ui segment" style="background:#f8fafc; display:none">
    <div class="ui header">Pièce d'identité enregistrée</div>
    <div id="ci-saved-list" style="display:flex;flex-wrap:wrap;gap:10px"></div>
  </div>

  <h4 class="ui dividing header">Photos produit</h4>
  <div class="field">
    {{ form_row(form.photoFiles) }}
    <div class="muted" style="margin-top:.3rem">Les photos seront compressées en JPEG ≤ 1 Mo et stockées localement.</div>
  </div>

  {{ form_row(form._token) }}
  <input type="hidden" name="_go_sign" id="go-sign" value="0">
  {{ form_end(form, { render_rest: false }) }}
</div>

{# ========= Photos locales : conteneur TOUJOURS PRÉSENT + placeholder ========= #}
<h4 class="ui dividing header">Photos locales</h4>
<div id="photos-gallery" class="ui small images" style="display:flex;flex-wrap:wrap;gap:10px"></div>
<div id="photos-placeholder" class="ui message">
  Aucune photo locale pour l’instant.
</div>

{# Pré-remplissage de la galerie au 1er rendu si des photos existent #}
{% if rachat.id and rachat.photosJson %}
  {% set arr = rachat.photosJson is string ? (rachat.photosJson|json_decode) : rachat.photosJson %}
  {% if arr is iterable and (arr|length) > 0 %}
    <script>
      (function(){
        const gallery = document.getElementById('photos-gallery');
        const placeholder = document.getElementById('photos-placeholder');
        if (placeholder) placeholder.style.display = 'none';
        {% for name in arr|slice(0,24) %}
          {% set fname = name is string ? (name|split('/')|last) : '' %}
          {% if fname %}
            (function(u){
              const a = document.createElement('a');
              a.href = u; a.target = '_blank'; a.rel='noopener'; a.className='image';
              const img = document.createElement('img');
              img.src = u;
              img.style.height='120px';
              img.style.aspectRatio='1/1';
              img.style.objectFit='cover';
              img.style.borderRadius='6px';
              img.style.border='1px solid #e5e7eb';
              a.appendChild(img);
              gallery.appendChild(a);
            })('{{ absolute_url(path("admin_rachats_photo", { id: rachat.id, file: fname })) }}');
          {% endif %}
        {% endfor %}
      })();
    </script>
  {% endif %}
{% endif %}

{# ========= Actions bas de page ========= #}
<div class="ui right aligned basic segment">
  <a class="ui button" href="{{ path('admin_rachats_index') }}"><i class="left arrow icon"></i> Retour</a>

  {% if rachat.id %}
    <button type="button" id="btn-save-and-sign" class="ui primary button">
      <i class="edit outline icon"></i> Signer
    </button>
    {% if rachat.pdfUrl %}
      <a class="ui button" target="_blank" href="{{ rachat.pdfUrl }}"><i class="file pdf icon"></i> Ouvrir le PDF</a>
    {% endif %}
  {% else %}
    <div class="ui warning message" style="display:inline-block;margin-left:1rem">
      Enregistrez le rachat pour accéder à la signature et au PDF.
    </div>
  {% endif %}
</div>

{# ======================= JS ======================= #}

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script>
(function(){
  const csrf  = '{{ csrf_token("rachat_edit_" ~ rachat.id) }}';
  const uploadCiUrl     = '{{ path("admin_rachats_upload_ci", { id: rachat.id }) }}';

  const rectoInput  = document.getElementById('{{ form.pieceIdentiteRectoFile.vars.id|e('js') }}');
  const versoInput  = document.getElementById('{{ form.pieceIdentiteVersoFile.vars.id|e('js') }}');
  const ciSaved     = document.getElementById('ci-saved');
  const ciSavedList = document.getElementById('ci-saved-list');

  // --- aperçu recto/verso existants
  {% if rachat.pieceIdentiteUrl %}
  try {
    const saved = JSON.parse({{ rachat.pieceIdentiteUrl|json_encode|raw }});
    for (const k of ['recto','verso']) {
      if (saved[k]) addSavedCiThumb(k, saved[k]);
    }
  } catch(e){}
  {% endif %}

  // --- fonction affichage vignettes
  function addSavedCiThumb(kind, url) {
    ciSaved.style.display = 'block';
    const prev = ciSavedList.querySelector('[data-kind="'+kind+'"]');
    if (prev) prev.remove();
    const wrap = document.createElement('div');
    wrap.dataset.kind = kind;
    wrap.style = 'border:1px dashed #ccc;border-radius:6px;padding:8px;width:240px;';
    wrap.innerHTML = `<div style="font-weight:600">${kind}</div>
                      <img src="${url}?v=${Date.now()}" style="max-width:100%;border-radius:6px">
                      <a class="ui mini button" target="_blank" href="${url}">🔗 Ouvrir</a>`;
    ciSavedList.appendChild(wrap);
  }

  // --- CROP + ENVOI ---
  function cropAndUpload(file, kind) {
    if (!file || !file.type.startsWith('image/')) return;
    const reader = new FileReader();
    reader.onload = ev => {
      const overlay = document.createElement('div');
      overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;';
      const img = document.createElement('img');
      img.src = ev.target.result;
      img.style.maxWidth = '90%';
      img.style.maxHeight = '80vh';
      overlay.appendChild(img);
      const btn = document.createElement('button');
      btn.textContent = '✅ Valider recadrage';
      btn.className = 'ui primary button';
      btn.style.marginTop = '1rem';
      overlay.appendChild(btn);
      document.body.appendChild(overlay);

      const cropper = new Cropper(img, { aspectRatio: 3/2, viewMode: 1, autoCropArea: 1 });

      btn.onclick = () => {
        cropper.getCroppedCanvas({width:1200,height:800}).toBlob(async blob => {
          overlay.remove();
          // ✅ corrige ici : on fabrique un vrai File
          const croppedFile = new File([blob], `${kind}.jpg`, { type: 'image/jpeg' });
          await uploadCi(croppedFile, kind);
        }, 'image/jpeg', 0.9);
      };
    };
    reader.readAsDataURL(file);
  }

  async function uploadCi(file, kind) {
    const fd = new FormData();
    fd.append('_token', csrf);
    fd.append('kind', kind);
    fd.append('ci', file, file.name); // 👈 important : nom explicite
    try {
      const res = await fetch(uploadCiUrl, { method: 'POST', body: fd });
      const j = await res.json();
      if (!res.ok || !j.ok) throw new Error(j.error || res.statusText);
      addSavedCiThumb(kind, j.url);
    } catch(e) {
      console.error('Erreur upload', e);
      alert('Erreur upload '+kind+' : '+e.message);
    }
  }

  if (rectoInput) rectoInput.addEventListener('change', e => cropAndUpload(e.target.files[0], 'recto'));
  if (versoInput) versoInput.addEventListener('change', e => cropAndUpload(e.target.files[0], 'verso'));
})();


// ====== BOUTON SIGNER ======
  const btn = document.getElementById('btn-save-and-sign');
  const go  = document.getElementById('go-sign');
  const frm = document.getElementById('rachat-form');
  if (btn && go && frm) {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      go.value = '1';
      frm.submit();
    });
  }
</script>


{% endblock %}

{% extends '@!SyliusAdmin/layout.html.twig' %}
{% block title %}Éditer rachat #{{ rachat.id ?? '—' }}{% endblock %}

{% block content %}
<div class="ui segment">
  <h2 class="ui header">Rachat #{{ rachat.id ?? '—' }}</h2>

  {# ================= REVendeur (STATUT + ACTION) ================= #}
  {% set revendeur = attribute(rachat, 'revendeur') is defined ? rachat.revendeur : null %}
  {% set revendeurId = revendeur ? revendeur.id : (attribute(rachat, 'revendeurId') is defined ? rachat.revendeurId : null) %}
  {% set treated = revendeurId is not empty %}

  <div class="ui secondary segment" style="margin-top: .8rem;">
    <div class="ui grid middle aligned">
      <div class="ten wide column">
        <div class="ui small header" style="margin-bottom:.4rem;">
          <i class="user icon"></i> Revendeur
        </div>

        {% if treated %}
          <div class="ui green label">
            <i class="check icon"></i> Traité
          </div>
          <span style="margin-left:.5rem;color:#666;">
            Revendeur #{{ revendeurId }}
          </span>
        {% else %}
          <div class="ui grey label">
            <i class="clock outline icon"></i> Non traité
          </div>
          <span style="margin-left:.5rem;color:#666;">
            Aucun revendeur lié
          </span>
        {% endif %}

        {% if rachat.hibSupplierId %}
          <div style="margin-top:.4rem;">
            <span class="ui tiny label">
              Hiboutik supplier_id : {{ rachat.hibSupplierId }}
            </span>
          </div>
        {% endif %}
      </div>

      <div class="six wide column right aligned">
        {% if treated %}
         <a class="ui button" href="{{ path('admin_revendeurs_show', {id: rachat.revendeur.id}) }}">
    Voir revendeur
  </a>
          <a class="ui small basic button"
             href="{{ path('admin_revendeurs_edit', {id: revendeurId}) }}">
            <i class="user icon"></i> Voir revendeur
          </a>
    
 


          {% if rachat.hibSupplierId %}
            <a class="ui small basic button"
               href="{{ path('admin_vendors_edit', {id: rachat.hibSupplierId}) }}">
              <i class="warehouse icon"></i> Voir vendor Hiboutik
            </a>
          {% endif %}
        {% else %}
          {% if rachat.id %}
            <form method="post"
                  action="{{ path('admin_rachats_process_revendeur', {id: rachat.id}) }}"
                  style="display:inline-block"
                  onsubmit="return confirm('Créer/relier le revendeur pour ce rachat ?');">
              <input type="hidden" name="_token" value="{{ csrf_token('process_revendeur_' ~ rachat.id) }}">
              <button class="ui small blue button" type="submit">
                <i class="user plus icon"></i> Créer / lier
              </button>
            </form>
          {% else %}
            <div class="ui tiny message">Enregistrez d’abord pour créer le revendeur.</div>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>

  {{ form_start(form, { attr: { class: 'ui form', id: 'rachat-form' } }) }}

  <div class="four fields">
    <div class="field">{{ form_row(form.marqueModele) }}</div>
    <div class="field">{{ form_row(form.imei) }}</div>
    <div class="field">{{ form_row(form.hibBrandId) }}</div>
    <div class="field">{{ form_row(form.hibCategoryId) }}</div>
  </div>

  <div class="three fields">
    <div class="field">{{ form_row(form.numeroCi) }}</div>
    <div class="field">{{ form_row(form.prixAchat) }}</div>
    <div class="field">{{ form_row(form.dateCession) }}</div>
  </div>
<div class="ui segment">
  <div class="field">
    <label>Revendeur existant (recherche)</label>
    <input type="text" id="rev-search" placeholder="Tape nom, téléphone ou email…">
    <div id="rev-results" class="ui very relaxed list" style="margin-top: .5em;"></div>
  </div>

  <input type="hidden" id="apply_revendeur_token" value="{{ csrf_token('apply_revendeur_' ~ rachat.id) }}">
</div>
  <div class="three fields">
    <div class="field">{{ form_row(form.nom) }}</div>
    <div class="field">{{ form_row(form.prenom) }}</div>
    <div class="field">{{ form_row(form.telephone) }}</div>
  </div>

  <div class="two fields">
    <div class="field">{{ form_row(form.email) }}</div>
    <div class="field">{{ form_row(form.codePostal) }}</div>
  </div>

  <div class="field">{{ form_row(form.adresse) }}</div>

  

  <h4 class="ui dividing header">Pièce d'identité — Upload AJAX immédiat</h4>
  <div class="two fields">
    <div class="field">
      {{ form_row(form.pieceIdentiteRectoFile) }}
      <div id="ci-recto-preview" style="margin-top:.5rem;display:none">
        <div class="ui small header">Recto sélectionné</div>
        <img id="ci-recto-img" style="max-width:100%;border:1px solid #ccc;border-radius:6px">
      </div>
    </div>
    <div class="field">
      {{ form_row(form.pieceIdentiteVersoFile) }}
      <div id="ci-verso-preview" style="margin-top:.5rem;display:none">
        <div class="ui small header">Verso sélectionné</div>
        <img id="ci-verso-img" style="max-width:100%;border:1px solid #ccc;border-radius:6px">
      </div>
    </div>
  </div>

  <div id="ci-saved" class="ui segment" style="background:#f8fafc; display:none">
    <div class="ui header">Pièce d'identité enregistrée</div>
    <div id="ci-saved-list" style="display:flex;flex-wrap:wrap;gap:10px"></div>
  </div>

  <h4 class="ui dividing header">Photos produit</h4>
  <div class="field">
    {{ form_row(form.photoFiles) }}
    <div class="muted" style="margin-top:.3rem">Les photos seront compressées en JPEG ≤ 1 Mo et stockées localement.</div>
  </div>

  <div class="two fields">
    <button class="ui primary button" type="submit">Enregistrer</button>
    <a class="ui button" href="{{ path('admin_rachats_index') }}">Retour liste</a>
  </div>

  {{ form_row(form._token) }}
  <input type="hidden" name="_go_sign" id="go-sign" value="0">
  {{ form_end(form, { render_rest: false }) }}
</div>

{# ========= Photos locales : conteneur TOUJOURS PRÉSENT + placeholder ========= #}
<h4 class="ui dividing header">Photos locales</h4>
<div id="photos-gallery" class="ui small images" style="display:flex;flex-wrap:wrap;gap:10px"></div>
<div id="photos-placeholder" class="ui message">
  Aucune photo locale pour l’instant.
</div>

{# Pré-remplissage de la galerie au 1er rendu si des photos existent #}
{% if rachat.id and rachat.photosJson %}
  {% set arr = rachat.photosJson is string ? (rachat.photosJson|json_decode) : rachat.photosJson %}
  {% if arr is iterable and (arr|length) > 0 %}
    <script>
      (function(){
        const gallery = document.getElementById('photos-gallery');
        const placeholder = document.getElementById('photos-placeholder');
        if (placeholder) placeholder.style.display = 'none';
        {% for name in arr|slice(0,24) %}
          {% set fname = name is string ? (name|split('/')|last) : '' %}
          {% if fname %}
            (function(u){
              const a = document.createElement('a');
              a.href = u; a.target = '_blank'; a.rel='noopener'; a.className='image';
              const img = document.createElement('img');
              img.src = u;
              img.style.height='120px';
              img.style.aspectRatio='1/1';
              img.style.objectFit='cover';
              img.style.borderRadius='6px';
              img.style.border='1px solid #e5e7eb';
              a.appendChild(img);
              gallery.appendChild(a);
            })('{{ absolute_url(path("admin_rachats_photo", { id: rachat.id, file: fname })) }}');
          {% endif %}
        {% endfor %}
      })();
    </script>
  {% endif %}
{% endif %}



{# ========= Actions bas de page ========= #}
<div class="ui right aligned basic segment">
  <a class="ui button" href="{{ path('admin_rachats_index') }}"><i class="left arrow icon"></i> Retour</a>

  {% if rachat.id %}
    <button type="button" id="btn-save-and-sign" class="ui primary button">
      <i class="edit outline icon"></i> Signer
    </button>

    {# ✅ NOUVEAU : ouvrir sur tablette #}
  <button type="button" id="btn-open-on-tablet" class="ui teal button">
    <i class="tablet alternate icon"></i> Ouvrir sur tablette
  </button>
  <div class="ui message">
  <strong>DEBUG TOKEN:</strong>
  <code id="dbg-token">{{ tablet_socket_token }}</code>
</div>

<button type="button" class="btn btn-primary" id="btn-tablet-sign"
        data-id="{{ rachat.id }}"
        data-device="TAB1">
  Signer sur tablette
</button>

    {% if rachat.pdfUrl %}
      <a class="ui button" target="_blank" href="{{ rachat.pdfUrl }}"><i class="file pdf icon"></i> Ouvrir le PDF</a>
    {% endif %}
  {% else %}
    <div class="ui warning message" style="display:inline-block;margin-left:1rem">
      Enregistrez le rachat pour accéder à la signature et au PDF.
    </div>
  {% endif %}
</div>

{# ======================= JS ======================= #}

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

<script>
/* ===================== CI: crop + upload ===================== */
(function () {
  const csrf = '{{ csrf_token("rachat_edit_" ~ rachat.id) }}';
  const uploadCiUrl = '{{ path("admin_rachats_upload_ci", { id: rachat.id }) }}';

  const rectoInput = document.getElementById('{{ form.pieceIdentiteRectoFile.vars.id|e("js") }}');
  const versoInput = document.getElementById('{{ form.pieceIdentiteVersoFile.vars.id|e("js") }}');
  const ciSaved = document.getElementById('ci-saved');
  const ciSavedList = document.getElementById('ci-saved-list');

  if (!ciSaved || !ciSavedList) return;

  function addSavedCiThumb(kind, url) {
    ciSaved.style.display = 'block';
    const prev = ciSavedList.querySelector('[data-kind="' + kind + '"]');
    if (prev) prev.remove();

    const wrap = document.createElement('div');
    wrap.dataset.kind = kind;
    wrap.style.cssText = 'border:1px dashed #ccc;border-radius:6px;padding:8px;width:240px;';
    wrap.innerHTML =
      '<div style="font-weight:600">' + kind + '</div>' +
      '<img src="' + url + '?v=' + Date.now() + '" style="max-width:100%;border-radius:6px">' +
      '<a class="ui mini button" target="_blank" rel="noopener" href="' + url + '">🔗 Ouvrir</a>';

    ciSavedList.appendChild(wrap);
  }

  // Pré-affichage des URLs existantes
  {% if rachat.pieceIdentiteUrl %}
  try {
    const saved = JSON.parse({{ rachat.pieceIdentiteUrl|json_encode|raw }});
    ['recto','verso'].forEach(k => { if (saved && saved[k]) addSavedCiThumb(k, saved[k]); });
  } catch(e) {}
  {% endif %}

  function cropAndUpload(file, kind) {
    if (!file || !file.type || !file.type.startsWith('image/')) return;

    const reader = new FileReader();
    reader.onload = (ev) => {
      const overlay = document.createElement('div');
      overlay.style.cssText =
        'position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:9999;' +
        'display:flex;flex-direction:column;align-items:center;justify-content:center;';

      const img = document.createElement('img');
      img.src = ev.target.result;
      img.style.maxWidth = '90%';
      img.style.maxHeight = '80vh';
      overlay.appendChild(img);

      const btnValidate = document.createElement('button');
      btnValidate.textContent = '✅ Valider recadrage';
      btnValidate.className = 'ui primary button';
      btnValidate.style.marginTop = '1rem';
      overlay.appendChild(btnValidate);

      document.body.appendChild(overlay);

      const cropper = new Cropper(img, {
        aspectRatio: 3/2,
        viewMode: 1,
        autoCropArea: 1
      });

      btnValidate.addEventListener('click', () => {
        cropper.getCroppedCanvas({ width: 1200, height: 800 }).toBlob(async (blob) => {
          overlay.remove();
          const croppedFile = new File([blob], kind + '.jpg', { type: 'image/jpeg' });
          await uploadCi(croppedFile, kind);
        }, 'image/jpeg', 0.9);
      });
    };
    reader.readAsDataURL(file);
  }

  async function uploadCi(file, kind) {
    const fd = new FormData();
    fd.append('_token', csrf);
    fd.append('kind', kind);
    fd.append('ci', file, file.name);

    try {
      const res = await fetch(uploadCiUrl, { method: 'POST', body: fd });
      const j = await res.json();
      if (!res.ok || !j.ok) throw new Error(j.error || res.statusText);
      addSavedCiThumb(kind, j.url);
    } catch (e) {
      console.error('Erreur upload', e);
      alert('Erreur upload ' + kind + ' : ' + (e.message || e));
    }
  }

  if (rectoInput) rectoInput.addEventListener('change', (e) => cropAndUpload(e.target.files[0], 'recto'));
  if (versoInput) versoInput.addEventListener('change', (e) => cropAndUpload(e.target.files[0], 'verso'));
})();
</script>

<script>
/* ===================== Bouton "Signer" (NE TOUCHE PAS go-sign) ===================== */
(function () {
  const btnSaveAndSign = document.getElementById('btn-save-and-sign');
  const go = document.getElementById('go-sign');      // on l’utilise tel quel
  const frm = document.getElementById('rachat-form');

  if (!btnSaveAndSign || !go || !frm) return;

  btnSaveAndSign.addEventListener('click', (e) => {
    e.preventDefault();
    go.value = '1';
    frm.submit();
  });
})();
</script>

<script>
/* ===================== Recherche revendeur + appliquer ===================== */
(function () {
  const inp = document.getElementById('rev-search');
  const results = document.getElementById('rev-results');
  const tokenEl = document.getElementById('apply_revendeur_token');

  if (!inp || !results || !tokenEl) return;

  const token = tokenEl.value;
  let timer = null;
  let abortCtl = null;

  function render(list) {
    results.innerHTML = (list || []).map(v => `
      <div class="item" style="cursor:pointer" data-id="${v.id}">
        <i class="user icon"></i>
        <div class="content"><div class="header">${v.label}</div></div>
      </div>
    `).join('');

    results.querySelectorAll('.item').forEach(el => {
      el.addEventListener('click', async () => {
        const revId = el.getAttribute('data-id');

        const fd = new FormData();
        fd.append('_token', token);
        fd.append('revendeur_id', revId);

        const r = await fetch(`/admin/rachats/{{ rachat.id }}/apply-revendeur`, {
          method: 'POST',
          body: fd
        });
        const data = await r.json();
        if (!data.ok) { alert(data.error || 'Erreur'); return; }

        const setVal = (name, value) => {
          const el = document.querySelector(`[name="${name}"]`);
          if (el) el.value = value ?? '';
        };

        setVal('rachat[nom]', data.filled?.nom);
        setVal('rachat[prenom]', data.filled?.prenom);
        setVal('rachat[telephone]', data.filled?.telephone);
        setVal('rachat[email]', data.filled?.email);
        setVal('rachat[adresse]', data.filled?.adresse);
        setVal('rachat[codePostal]', data.filled?.codePostal ?? data.filled?.code_postal);

        results.innerHTML = '';
        inp.value = '';
      });
    });
  }

  inp.addEventListener('input', () => {
    clearTimeout(timer);
    const q = inp.value.trim();

    if (q.length < 2) { results.innerHTML = ''; return; }

    timer = setTimeout(async () => {
      try {
        if (abortCtl) abortCtl.abort();
        abortCtl = new AbortController();

        const res = await fetch(`/admin/revendeurs/search?q=${encodeURIComponent(q)}`, {
          signal: abortCtl.signal
        });
        const list = await res.json();
        render(list);
      } catch (e) {
        // abort => silencieux
      }
    }, 250);
  });
})();
</script>

<script>
/* ===================== Push tablette "Ouvrir sur tablette" ===================== */
(function () {
  const btnOpenTablet = document.getElementById('btn-open-on-tablet');
  if (!btnOpenTablet) return;

  btnOpenTablet.addEventListener('click', async () => {
    try {
      const signUrl = "{{ path('admin_rachats_sign', {id: rachat.id}) }}";
      const token = "{{ tablet_socket_token|e('js') }}";

      const payload = new URLSearchParams();
      payload.append('device', 'TAB1');
      payload.append('url', signUrl);
      payload.append('token', token);

      const res = await fetch('/ws-tablet-push', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
        body: payload.toString(),
      });

      const data = await res.json();
      console.log('[TABLET] push', data);

      if (!data.ok) {
        alert("Push KO: " + (data.error || ''));
        return;
      }
      alert("OK tablette !");
    } catch (e) {
      console.error(e);
      alert('Erreur push tablette');
    }
  });
})();
</script>

<script>
/* ===================== Bouton "Signer sur tablette" ===================== */
(function () {
  const btnTabletSign = document.getElementById('btn-tablet-sign');
  if (!btnTabletSign) return;

  btnTabletSign.addEventListener('click', async () => {
    try {
      const id = btnTabletSign.dataset.id;
      const device = btnTabletSign.dataset.device || 'TAB1';

      // 1) créer lien public tablette
      const res = await fetch(`/admin/rachats/${id}/tablet-link`, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
      });
      const j = await res.json();
      if (!j || !j.url) throw new Error('tablet-link: url manquante');

      // 2) push vers tablette
      const u = new URL(j.url, window.location.origin);
      const push = await fetch(`/ws-tablet-push`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({
          device,
          url: u.pathname + u.search,
          token: '{{ tablet_socket_token|e("js") }}'
        })
      });

      const pj = await push.json();
      console.log('[TABLET] push', pj);

      if (!pj.ok) alert('Push KO: ' + (pj.error || ''));
    } catch (e) {
      console.error(e);
      alert('Erreur "Signer sur tablette"');
    }
  });
})();
</script>


{% endblock %}

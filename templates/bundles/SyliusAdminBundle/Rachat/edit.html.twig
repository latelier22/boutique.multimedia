<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>



<script>
(function () {
    function bootRachatEditPage() {
        initSemanticUi();
        initBrandUi();
        initRachatAttributes();
    }

    function initSemanticUi() {
        if (window.$ && $.fn.dropdown) {
            $('.ui.dropdown').dropdown();
        }

        if (window.$ && $.fn.checkbox) {
            $('.ui.checkbox').checkbox();
        }
    }

    function initBrandUi() {
        const form = document.getElementById('rachat-form');
        if (!form || form.dataset.rachatBrandInit === '1') return;
        form.dataset.rachatBrandInit = '1';

        const realBrandField = document.getElementById('{{ form.hibBrandId.vars.id|e("js") }}');
        const brandUi = document.getElementById('hib_brand_ui');
        const brandUiValue = document.getElementById('brand_ui_value');
        const newBrandField = document.getElementById('new-brand-field');
        const newBrandInput = document.getElementById('new_brand_name');

        function syncBrandUi() {
            if (!brandUi || !realBrandField || !brandUiValue) return;

            const val = brandUi.value;
            brandUiValue.value = val;

            if (val === '__new__') {
                if (newBrandField) newBrandField.style.display = '';
                realBrandField.value = '';
            } else {
                if (newBrandField) newBrandField.style.display = 'none';
                if (newBrandInput) newBrandInput.value = '';
                realBrandField.value = val || '';
            }
        }

        if (brandUi) {
            brandUi.addEventListener('change', syncBrandUi);
            syncBrandUi();
        }
    }

    function initRachatAttributes() {
        const form = document.getElementById('rachat-form');
        if (!form) return;

        if (form.dataset.rachatAttrInit === '1') {
            return;
        }
        form.dataset.rachatAttrInit = '1';

        const INITIAL_VALUES = {{ initialAttributeValues|default({})|json_encode|raw }};
        const INITIAL_CATEGORY_ID = {{ selectedCategoryId|default(0)|json_encode|raw }};
        const INITIAL_ATTR_DEFS = {{ initialAttributeDefs|default([])|json_encode|raw }};

        const catSelect = document.getElementById('{{ form.hibCategoryId.vars.id|e("js") }}');
        const listEl = document.getElementById('rachat-attributes-list');
        const rawBox = document.getElementById('rachatAttributesRawBox');
        const hiddenInput = document.getElementById('rachatAttributesJson');

        const QUICK_ATTR_URL = '{{ path("admin_rachats_create_attribute_definition") }}';
        const DEFS_BASE_URL = '{{ path("admin_rachats_attributes_definitions", {category: "__CATEGORY__"}) }}';

        const quickAttrLabel = document.getElementById('quickAttrLabel');
        const quickAttrType = document.getElementById('quickAttrType');
        const quickAttrOptions = document.getElementById('quickAttrOptions');
        const quickAttrOptionsField = document.getElementById('quickAttrOptionsField');
        const quickAttrBtn = document.getElementById('btnQuickCreateAttr');
        const quickAttrState = document.getElementById('quickAttrState');

        if (!catSelect || !listEl || !hiddenInput) {
            return;
        }

        let defs = [];
        let values = JSON.parse(JSON.stringify(INITIAL_VALUES || {}));
        const preloadedDefsByCategory = {};

        if (String(INITIAL_CATEGORY_ID || '0') !== '0') {
            preloadedDefsByCategory[String(INITIAL_CATEGORY_ID)] = Array.isArray(INITIAL_ATTR_DEFS) ? INITIAL_ATTR_DEFS : [];
        }

        function escapeHtml(str) {
            return String(str ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

        function slugifyCode(str) {
            return String(str || '')
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/[^a-z0-9]+/g, '_')
                .replace(/^_+|_+$/g, '');
        }

        function getSelectedCategoryId() {
            let val = String(catSelect.value || '').trim();

            if ((!val || val === '0') && INITIAL_CATEGORY_ID) {
                val = String(INITIAL_CATEGORY_ID);
            }

            return val;
        }

        function buildPreviewRows() {
            if (!Array.isArray(defs) || defs.length === 0) {
                return values || {};
            }

            return defs.map(def => ({
                code: String(def.code || ''),
                label: String(def.label || def.code || ''),
                value: String(values?.[def.code] ?? '')
            }));
        }

        function syncHiddenInput() {
            hiddenInput.value = JSON.stringify(values || {});

            if (rawBox) {
                rawBox.textContent = JSON.stringify(buildPreviewRows(), null, 2);
            }
        }

        function refreshQuickAttrVisibility() {
            if (!quickAttrType || !quickAttrOptionsField) return;
            quickAttrOptionsField.style.display = quickAttrType.value === 'select' ? '' : 'none';
        }

        function normalizeValuesForCurrentDefs() {
            const nextValues = {};

            for (const def of defs || []) {
                const code = String(def.code || '');
                nextValues[code] = values?.[code] ?? '';
            }

            values = nextValues;
        }

        function bindInputs() {
            listEl.querySelectorAll('.rachat-misc-input').forEach(el => {
                const update = () => {
                    const code = el.getAttribute('data-code');
                    values[code] = el.value;
                    syncHiddenInput();
                };

                el.addEventListener('change', update);
                el.addEventListener('input', update);
            });

            syncHiddenInput();
        }

        function renderDefs() {
            if (!defs.length) {
                listEl.innerHTML = `<div class="ui message">Aucun attribut défini pour cette catégorie.</div>`;
                syncHiddenInput();
                return;
            }

            listEl.innerHTML = '';

            defs.forEach(def => {
                const currentValue = String(values?.[def.code] ?? '');
                const wrapper = document.createElement('div');
                wrapper.className = 'ui segment';

                let inputHtml = '';

                if (def.type === 'select') {
                    const opts = Array.isArray(def.options) ? def.options : [];

                    inputHtml = `
                        <select data-code="${escapeHtml(def.code)}" class="rachat-misc-input" style="width:100%;padding:8px;">
                            <option value="">-- choisir --</option>
                            ${opts.map(o => `
                                <option value="${escapeHtml(o)}" ${String(o) === currentValue ? 'selected' : ''}>
                                    ${escapeHtml(o)}
                                </option>
                            `).join('')}
                        </select>
                    `;
                } else {
                    inputHtml = `
                        <input
                            type="text"
                            value="${escapeHtml(currentValue)}"
                            data-code="${escapeHtml(def.code)}"
                            class="rachat-misc-input"
                            style="width:100%;padding:8px;"
                        >
                    `;
                }

                wrapper.innerHTML = `
                    <div style="font-weight:700;margin-bottom:6px;">${escapeHtml(def.label || def.code)}</div>
                    <div style="font-size:12px;color:#666;margin-bottom:8px;">
                        code: <code>${escapeHtml(def.code)}</code>
                    </div>
                    ${inputHtml}
                `;

                listEl.appendChild(wrapper);
            });

            bindInputs();
            syncHiddenInput();
        }

        async function loadDefs(forcedCatId = null) {
            const catId = String(forcedCatId || getSelectedCategoryId() || '0');

            if (!catId || catId === '0') {
                listEl.innerHTML = `<div class="ui message">Choisis une catégorie pour afficher les attributs.</div>`;
                defs = [];
                syncHiddenInput();
                return;
            }

            if (Object.prototype.hasOwnProperty.call(preloadedDefsByCategory, catId)) {
                defs = Array.isArray(preloadedDefsByCategory[catId]) ? preloadedDefsByCategory[catId] : [];
                normalizeValuesForCurrentDefs();
                renderDefs();
                return;
            }

            listEl.innerHTML = `<div class="ui active inline loader"></div> Chargement...`;

            try {
                const res = await fetch(DEFS_BASE_URL.replace('__CATEGORY__', encodeURIComponent(catId)), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!res.ok) {
                    listEl.innerHTML = `<div class="ui negative message">Erreur chargement attributs</div>`;
                    return;
                }

                defs = await res.json();
                preloadedDefsByCategory[catId] = defs;
                normalizeValuesForCurrentDefs();
                renderDefs();
            } catch (e) {
                console.error(e);
                listEl.innerHTML = `<div class="ui negative message">Erreur JS</div>`;
            }
        }

        async function createQuickAttribute() {
            const catId = getSelectedCategoryId();
            const label = String(quickAttrLabel?.value || '').trim();
            const type = String(quickAttrType?.value || 'text');
            const options = String(quickAttrOptions?.value || '').trim();

            if (!catId || catId === '0') {
                quickAttrState.textContent = 'Choisis d’abord une catégorie';
                return;
            }

            if (!label) {
                quickAttrState.textContent = 'Label obligatoire';
                return;
            }

            quickAttrState.textContent = 'Création...';

            try {
                const res = await fetch(QUICK_ATTR_URL, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        category_id: catId,
                        category: catId,
                        code: slugifyCode(label),
                        label: label,
                        type: type,
                        options: options
                    })
                });

                const json = await res.json();

                if (!res.ok || !json.ok) {
                    quickAttrState.textContent = json.error || 'Erreur';
                    return;
                }

                quickAttrLabel.value = '';
                quickAttrType.value = 'text';
                quickAttrOptions.value = '';
                refreshQuickAttrVisibility();

                delete preloadedDefsByCategory[catId];
                quickAttrState.textContent = 'Attribut créé';
                await loadDefs(catId);
            } catch (e) {
                console.error(e);
                quickAttrState.textContent = 'Erreur JS';
            }
        }

        catSelect.addEventListener('change', () => loadDefs(catSelect.value));

        if (quickAttrType) {
            quickAttrType.addEventListener('change', refreshQuickAttrVisibility);
            refreshQuickAttrVisibility();
        }

        if (quickAttrBtn) {
            quickAttrBtn.addEventListener('click', createQuickAttribute);
        }

        syncHiddenInput();

        if (String(INITIAL_CATEGORY_ID || '0') !== '0' && Array.isArray(INITIAL_ATTR_DEFS)) {
            defs = Array.isArray(INITIAL_ATTR_DEFS) ? INITIAL_ATTR_DEFS : [];
            normalizeValuesForCurrentDefs();
            renderDefs();
        } else {
            loadDefs();
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bootRachatEditPage, { once: true });
    } else {
        bootRachatEditPage();
    }

    document.addEventListener('turbo:load', bootRachatEditPage);
})();
</script>

<script>
/* ===================== CI: crop + upload ===================== */
(function () {
  const csrf = '{{ csrf_token("rachat_edit_" ~ rachat.id) }}';
  const uploadCiUrl = '{{ path("admin_rachats_upload_ci", { id: rachat.id }) }}';

  const rectoInput = document.getElementById('{{ form.pieceIdentiteRectoFile.vars.id|e("js") }}');
  const versoInput = document.getElementById('{{ form.pieceIdentiteVersoFile.vars.id|e("js") }}');
  const ciSaved = document.getElementById('ci-saved');
  const ciSavedList = document.getElementById('ci-saved-list');

  if (!ciSaved || !ciSavedList) return;

  function addSavedCiThumb(kind, url) {
    ciSaved.style.display = 'block';
    const prev = ciSavedList.querySelector('[data-kind="' + kind + '"]');
    if (prev) prev.remove();

    const wrap = document.createElement('div');
    wrap.dataset.kind = kind;
    wrap.style.cssText = 'border:1px dashed #ccc;border-radius:6px;padding:8px;width:240px;';
    wrap.innerHTML =
      '<div style="font-weight:600">' + kind + '</div>' +
      '<img src="' + url + '?v=' + Date.now() + '" style="max-width:100%;border-radius:6px">' +
      '<a class="ui mini button" target="_blank" rel="noopener" href="' + url + '">🔗 Ouvrir</a>';

    ciSavedList.appendChild(wrap);
  }

  {% if rachat.pieceIdentiteUrl %}
  try {
    const saved = JSON.parse({{ rachat.pieceIdentiteUrl|json_encode|raw }});
    ['recto','verso'].forEach(k => { if (saved && saved[k]) addSavedCiThumb(k, saved[k]); });
  } catch(e) {}
  {% endif %}

  function cropAndUpload(file, kind) {
    if (!file || !file.type || !file.type.startsWith('image/')) return;

    const reader = new FileReader();
    reader.onload = (ev) => {
      const overlay = document.createElement('div');
      overlay.style.cssText =
        'position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:9999;' +
        'display:flex;flex-direction:column;align-items:center;justify-content:center;';

      const img = document.createElement('img');
      img.src = ev.target.result;
      img.style.maxWidth = '90%';
      img.style.maxHeight = '80vh';
      overlay.appendChild(img);

      const btnValidate = document.createElement('button');
      btnValidate.textContent = '✅ Valider recadrage';
      btnValidate.className = 'ui primary button';
      btnValidate.style.marginTop = '1rem';
      overlay.appendChild(btnValidate);

      document.body.appendChild(overlay);

      const cropper = new Cropper(img, {
        aspectRatio: 3/2,
        viewMode: 1,
        autoCropArea: 1
      });

      btnValidate.addEventListener('click', () => {
        cropper.getCroppedCanvas({ width: 1200, height: 800 }).toBlob(async (blob) => {
          overlay.remove();
          const croppedFile = new File([blob], kind + '.jpg', { type: 'image/jpeg' });
          await uploadCi(croppedFile, kind);
        }, 'image/jpeg', 0.9);
      });
    };
    reader.readAsDataURL(file);
  }

  async function uploadCi(file, kind) {
    const fd = new FormData();
    fd.append('_token', csrf);
    fd.append('kind', kind);
    fd.append('ci', file, file.name);

    try {
      const res = await fetch(uploadCiUrl, { method: 'POST', body: fd });
      const j = await res.json();
      if (!res.ok || !j.ok) throw new Error(j.error || res.statusText);
      addSavedCiThumb(kind, j.url);
    } catch (e) {
      console.error('Erreur upload', e);
      alert('Erreur upload ' + kind + ' : ' + (e.message || e));
    }
  }

  if (rectoInput) rectoInput.addEventListener('change', (e) => cropAndUpload(e.target.files[0], 'recto'));
  if (versoInput) versoInput.addEventListener('change', (e) => cropAndUpload(e.target.files[0], 'verso'));
})();
</script>


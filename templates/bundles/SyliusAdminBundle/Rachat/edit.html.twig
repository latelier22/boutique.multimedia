{% extends '@!SyliusAdmin/layout.html.twig' %}
{% block title %}Éditer rachat #{{ rachat.id ?? '—' }}{% endblock %}

{% block content %}
{# Top menu dans le pre_content du Layout Admin #}
<div class="ui breadcrumb" style="margin-bottom:1rem;">
  <h1 class="ui header" style="margin:0;">
    <i class="edit icon"></i>
    Éditer rachat #{{ rachat.id ?? '—' }}
  </h1>
</div>

{% set revendeur = attribute(rachat, 'revendeur') is defined ? rachat.revendeur : null %}
{% set revendeurId = revendeur ? revendeur.id : (attribute(rachat, 'revendeurId') is defined ? rachat.revendeurId : null) %}
{% set treated = revendeurId is not empty %}

{{ form_start(form, { attr: { class: 'ui form', id: 'rachat-form' } }) }}
  <input type="hidden" name="rachat_attributes_json" id="rachatAttributesJson" value="{}">
  <input type="hidden" name="_go_sign" id="go-sign" value="0">

  <div class="ui stackable grid">

    {# ===================== COLONNE GAUCHE ===================== #}
    <div class="eight wide column">

      <div class="ui segment">
        <h3 class="ui header">
          <i class="box icon"></i>
          Fiche rachat
        </h3>

        <div class="two fields">
          <div class="field">{{ form_row(form.marqueModele) }}</div>
          <div class="field">{{ form_row(form.imei) }}</div>
        </div>

        <div class="two fields">
         <div class="field">
  <label>Marque</label>

  {# vrai champ Symfony, caché mais conservé pour la sauvegarde #}
  <div style="display:none;">
    {{ form_widget(form.hibBrandId) }}
  </div>

  {# UI visible pour l'utilisateur #}
  <select id="hib_brand_ui" class="ui fluid search selection dropdown hib-search-dropdown">
    <option value="">Choisir une marque</option>
    <option value="__new__">+ Nouvelle marque...</option>

    {% for b in brands %}
      <option
        value="{{ b.brand_id }}"
        {% if (rachat.hibBrandId ?? 0) == b.brand_id %}selected{% endif %}
      >
        {{ b.brand_name ?: ('BRAND #' ~ b.brand_id) }}
      </option>
    {% endfor %}
  </select>

  <input type="hidden" name="brand_ui_value" id="brand_ui_value" value="{{ rachat.hibBrandId ?? '' }}">

  <div class="field" id="new-brand-field" style="display:none; margin-top:10px;">
    <label>Nouvelle marque</label>
    <input
      type="text"
      name="new_brand_name"
      id="new_brand_name"
      placeholder="Ex : Xiaomi"
      value=""
    >
  </div>

  {{ form_errors(form.hibBrandId) }}
</div>

          <div class="field">
            <label>{{ form.hibCategoryId.vars.label|default('Catégorie') }}</label>

            {{ form_widget(form.hibCategoryId, {
  attr: { class: 'ui fluid search selection dropdown hib-search-dropdown' }
}) }}

            <div style="margin-top:6px;font-size:12px;color:#666;">
              Les parents sont affichés pour le contexte, mais seuls les enfants peuvent être choisis.
            </div>

            {% if form_errors(form.hibCategoryId) %}
              <div class="ui pointing red basic label" style="margin-top:6px;">
                {{ form_errors(form.hibCategoryId) }}
              </div>
            {% endif %}
          </div>
        </div>

        <div class="three fields">
          <div class="field">{{ form_row(form.numeroCi) }}</div>
          <div class="field">{{ form_row(form.prixAchat) }}</div>
          <div class="field">{{ form_row(form.dateCession) }}</div>
        </div>
      </div>

      {# ===== ATTRIBUTS ===== #}
      <div class="ui segment">
        <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
          <h3 class="ui header" style="margin:0;">
            <i class="list icon"></i>
            Attributs rachat
          </h3>
        </div>

        <div class="ui info message" style="margin-top:12px;">
          Les attributs suivent la catégorie choisie et seront enregistrés avec le bouton <strong>Enregistrer</strong>.
        </div>

        <div id="rachat-attributes-list">
          <div class="ui active inline loader"></div> Chargement...
        </div>

        <div class="ui divider"></div>

        <h4 class="ui header">
          <i class="plus circle icon"></i>
          Ajouter rapidement un attribut à la catégorie choisie
        </h4>

        <div class="ui form">
          <div class="three fields">
            <div class="field">
              <label>Label</label>
              <input type="text" id="quickAttrLabel" placeholder="Ex : Batterie">
            </div>

            <div class="field">
              <label>Type</label>
              <select id="quickAttrType" class="ui dropdown">
                <option value="text">Texte</option>
                <option value="select">Liste</option>
              </select>
            </div>

            <div class="field" id="quickAttrOptionsField" style="display:none;">
              <label>Options</label>
              <input type="text" id="quickAttrOptions" placeholder="Ex : 64Go,128Go,256Go">
            </div>
          </div>

          <button type="button" class="ui button" id="btnQuickCreateAttr">
            <i class="plus icon"></i>
            Ajouter à cette catégorie
          </button>

          <span id="quickAttrState" style="margin-left:8px;"></span>
        </div>

        <div class="ui divider"></div>

        <details>
          <summary style="cursor:pointer;font-weight:700;">Afficher JSON brut</summary>
          <pre id="rachatAttributesRawBox" style="white-space:pre-wrap;border:1px dashed #ddd;padding:10px;border-radius:8px;background:#fff;margin-top:10px;"></pre>
        </details>
      </div>

    </div>

    {# ===================== COLONNE DROITE ===================== #}
    <div class="eight wide column">

      <div class="ui segment">
        <h3 class="ui header">
          <i class="user icon"></i>
          Revendeur / vendeur
        </h3>

        {% if treated %}
          <div class="ui green label">
            <i class="check icon"></i> Traité
          </div>
          <span style="margin-left:.5rem;color:#666;">
            Revendeur #{{ revendeurId }}
          </span>
        {% else %}
          <div class="ui grey label">
            <i class="clock outline icon"></i> Non traité
          </div>
          <span style="margin-left:.5rem;color:#666;">
            Aucun revendeur lié
          </span>
        {% endif %}

        {% if rachat.hibSupplierId %}
          <div style="margin-top:.6rem;">
            <span class="ui tiny label">
              Hiboutik supplier_id : {{ rachat.hibSupplierId }}
            </span>
          </div>
        {% endif %}

        <div style="margin-top:1rem; display:flex; gap:8px; flex-wrap:wrap;">
          {% if treated %}
            <a class="ui button" href="{{ path('admin_revendeurs_show', {id: rachat.revendeur.id}) }}">
              Voir revendeur
            </a>

            <a class="ui basic button" href="{{ path('admin_revendeurs_edit', {id: revendeurId}) }}">
              Éditer revendeur
            </a>

            {% if rachat.hibSupplierId %}
              <a class="ui basic button" href="{{ path('admin_vendors_edit', {id: rachat.hibSupplierId}) }}">
                Voir vendor Hiboutik
              </a>
            {% endif %}
          {% else %}
            {% if rachat.id %}
              <button class="ui blue button"
        type="submit"
        form="process-revendeur-form"
        onclick="return confirm('Créer/relier le revendeur pour ce rachat ?');">
  <i class="user plus icon"></i> Créer / lier
</button>
            {% else %}
              <div class="ui tiny message">Enregistrez d’abord pour créer le revendeur.</div>
            {% endif %}
          {% endif %}
        </div>

        <div class="ui divider"></div>

        <div class="field">
          <label>Revendeur existant (recherche)</label>
          <input type="text" id="rev-search" placeholder="Tape nom, téléphone ou email…">
          <div id="rev-results" class="ui very relaxed list" style="margin-top: .5em;"></div>
        </div>

        <input type="hidden" id="apply_revendeur_token" value="{{ csrf_token('apply_revendeur_' ~ rachat.id) }}">
      </div>

      <div class="ui segment">
        <h3 class="ui header">
          <i class="address card icon"></i>
          Coordonnées vendeur
        </h3>

        <div class="three fields">
          <div class="field">{{ form_row(form.nom) }}</div>
          <div class="field">{{ form_row(form.prenom) }}</div>
          <div class="field">{{ form_row(form.telephone) }}</div>
        </div>

        <div class="two fields">
          <div class="field">{{ form_row(form.email) }}</div>
          <div class="field">{{ form_row(form.codePostal) }}</div>
        </div>

        <div class="field">{{ form_row(form.adresse) }}</div>
      </div>

      <div class="ui segment">
        <h3 class="ui header">
          <i class="id card outline icon"></i>
          Pièce d’identité
        </h3>
{# =========================
   PIÈCE D'IDENTITÉ - UPLOAD + WEBCAM DESKTOP
   À coller dans edit.html.twig
   Nécessite :
   - variable "rachat"
   - route admin_rachats_upload_ci
   - route admin_rachats_ci
   ========================= #}

<div class="ui segment" id="ciWebcamBox"
     data-upload-url="{{ path('admin_rachats_upload_ci', { id: rachat.id }) }}"
     data-csrf="{{ csrf_token('rachat_edit_' ~ rachat.id) }}"
>
    <h3 class="ui dividing header">
        <i class="id card outline icon"></i>
        <div class="content">
            Pièce d'identité
            <div class="sub header">Upload manuel ou prise de photo avec webcam</div>
        </div>
    </h3>

    <style>
        #ciWebcamBox .ci-video-wrap{
            background:#111;
            border-radius:12px;
            padding:10px;
            box-shadow: inset 0 0 0 1px rgba(255,255,255,.05);
        }

        #ciWebcamBox .ci-video{
            width:100%;
            max-height:420px;
            display:block;
            border-radius:8px;
            background:#000;
            object-fit:contain;
        }

        #ciWebcamBox .ci-preview-box{
            background:#f8f8f8;
            border:1px solid rgba(34,36,38,.12);
            border-radius:12px;
            padding:10px;
            min-height:260px;
            display:flex;
            align-items:center;
            justify-content:center;
            overflow:hidden;
        }

        #ciWebcamBox .ci-preview-box img{
            max-width:100%;
            max-height:240px;
            object-fit:contain;
            display:block;
        }

        #ciWebcamBox .ci-preview-empty{
            color:#888;
            font-style:italic;
            text-align:center;
            padding:20px;
        }

        #ciWebcamBox .ci-actions{
            margin-top:12px;
            display:flex;
            gap:8px;
            flex-wrap:wrap;
        }

        #ciWebcamBox .ci-upload-manual{
            margin-top:18px;
            padding-top:16px;
            border-top:1px solid rgba(34,36,38,.08);
        }

        #ciWebcamBox .ci-hidden{
            display:none !important;
        }
    </style>

    <div id="ciCameraStatus" class="ui message ci-hidden"></div>

    <div class="ui stackable two column grid">
        <div class="column">
            <div class="ui form">
                <div class="fields">
                    <div class="eight wide field">
                        <label>Caméra</label>
                        <select id="ciCameraSelect" class="ui dropdown">
                            <option value="">Caméra par défaut</option>
                        </select>
                    </div>

                    <div class="four wide field">
                        <label>&nbsp;</label>
                        <button type="button" id="btnStartCamera" class="ui primary fluid button">
                            Ouvrir
                        </button>
                    </div>

                    <div class="four wide field">
                        <label>&nbsp;</label>
                        <button type="button" id="btnStopCamera" class="ui fluid button">
                            Fermer
                        </button>
                    </div>
                </div>
            </div>

            <div class="ci-video-wrap">
                <video id="ciVideo" class="ci-video" autoplay playsinline muted></video>
            </div>

            <canvas id="ciCanvas" class="ci-hidden"></canvas>

            <div class="ci-actions">
                <button type="button" class="ui orange button" data-capture-kind="recto">
                    <i class="camera icon"></i>
                    Capturer recto
                </button>

                <button type="button" class="ui blue button" data-capture-kind="verso">
                    <i class="camera icon"></i>
                    Capturer verso
                </button>
            </div>

            <div class="ui small info message" style="margin-top:12px;">
                <div class="header">Conseil</div>
                Place la carte bien à plat, remplis l’image au maximum, puis capture.
            </div>
        </div>

        <div class="column">
            <div class="ui two stackable cards">
                <div class="card">
                    <div class="content">
                        <div class="header">Recto</div>
                    </div>
                    <div class="content">
                        <div class="ci-preview-box">
                            <img
                                id="ciPreviewRecto"
                                src="{{ path('admin_rachats_ci', { id: rachat.id, kind: 'recto' }) }}?t={{ 'now'|date('U') }}"
                                alt="Recto"
                                onerror="this.classList.add('ci-hidden'); this.nextElementSibling.classList.remove('ci-hidden');"
                            >
                            <div id="ciPreviewRectoEmpty" class="ci-preview-empty ci-hidden">
                                Aucun recto enregistré
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="content">
                        <div class="header">Verso</div>
                    </div>
                    <div class="content">
                        <div class="ci-preview-box">
                            <img
                                id="ciPreviewVerso"
                                src="{{ path('admin_rachats_ci', { id: rachat.id, kind: 'verso' }) }}?t={{ 'now'|date('U') }}"
                                alt="Verso"
                                onerror="this.classList.add('ci-hidden'); this.nextElementSibling.classList.remove('ci-hidden');"
                            >
                            <div id="ciPreviewVersoEmpty" class="ci-preview-empty ci-hidden">
                                Aucun verso enregistré
                            </div>

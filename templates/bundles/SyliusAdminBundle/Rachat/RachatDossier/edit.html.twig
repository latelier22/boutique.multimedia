		<script>
			(function () {
document.addEventListener('click', async function (e) {
const btn = e.target.closest('.btn-tablet-edit-customer');
if (! btn) 
return;



const box = btn.closest('#hibCustomerBox') || document;
const msg = box.querySelector('.js-tablet-customer-msg');

btn.classList.add('loading');
btn.disabled = true;

if (msg) {
msg.innerHTML = '';
}

try {
const customerId = btn.dataset.id;
const device = btn.dataset.device || 'TAB1';

if (! customerId) {
throw new Error('Client Hiboutik introuvable.');
}

const url = `/tablet/customers/${customerId}/edit?device=${
encodeURIComponent(device)
}`;

const push = await fetch('/ws-tablet-push', {
method: 'POST',
headers: {
'Content-Type': 'application/x-www-form-urlencoded',
'X-Requested-With': 'XMLHttpRequest'
},
body: new URLSearchParams(
{device: device, url: url, token: '{{ tablet_socket_token|e("js") }}'}
),
credentials: 'same-origin'
});

const pj = await push.json().catch(() => ({}));

if (! push.ok || ! pj.ok) {
throw new Error(pj.error || 'Push tablette impossible.');
}

if (msg) {
msg.innerHTML = `
          <div class="ui positive message">
            Édition client envoyée sur la tablette.
          </div>
        `;
}
} catch (err) {
console.error(err);

if (msg) {
msg.innerHTML = `
          <div class="ui negative message">
            ${
err.message || 'Erreur push tablette'
}
          </div>
        `;
}
} finally {
btn.classList.remove('loading');
btn.disabled = false;
}
});
})();
		</script>



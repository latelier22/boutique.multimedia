		<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

		{% if dossier.id %}
			{% include '@SyliusAdmin/Rachat/RachatDossier/_media_capture_widget_js.html.twig' with { dossier: dossier } %}
		{% endif %}

		{% if dossier.id and dossier.hibCustomerId and dossier.status != 'signed' %}
			<script>
				(function () {
const watchUrl = "{{ path('admin_rachats_v2_customer_watch', {id: dossier.id}) }}";

let lastSignature = null;
let busy = false;
let reloading = false;

async function checkCustomerChanged() {
if (busy || reloading) {
return;
}

busy = true;

try {
const res = await fetch(watchUrl, {
headers: {
'X-Requested-With': 'XMLHttpRequest',
'Accept': 'application/json'
},
credentials: 'same-origin'
});

const json = await res.json();

if (! res.ok || ! json.ok) {
throw new Error(json.error || 'Erreur watch client');
}

const newSignature = String(json.signature || '');

if (! newSignature) {
return;
}

if (lastSignature === null) {
lastSignature = newSignature;
return;
}

if (newSignature !== lastSignature) {
reloading = true;
window.location.reload();
}
} catch (e) {
console.error('[rachat-customer-watch]', e);
} finally {
busy = false;
}
}

checkCustomerChanged();
setInterval(checkCustomerChanged, 2000);
})();
			</script>
		{% endif %}


	{% endblock %}

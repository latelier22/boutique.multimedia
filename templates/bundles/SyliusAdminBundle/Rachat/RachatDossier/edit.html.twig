{% extends '@!SyliusAdmin/layout.html.twig' %}

{% block title %}
	{% if dossier.id %}
		Éditer dossier V2 #{{ dossier.id }}
	{% else %}
		Nouveau dossier V2
	{% endif %}
{% endblock %}

{% block content %}

	<style>
		.js-item-attributes-box select,
		.js-item-attributes-box input {
			width: 100%;
		}

		.js-item-attributes-details summary {
			list-style: none;
		}

		.js-item-attributes-details summary::-webkit-details-marker {
			display: none;
		}

		.js-item-attributes-details[open] .dropdown.icon {
			transform: rotate(90deg);
		}

		.js-item-attributes-details .dropdown.icon {
			transition: transform 0.15s ease;
		}
	</style>
		{% if dossier.lockedAt %}
			<style>
				#rachat-dossier-form input,
				#rachat-dossier-form select,
				#rachat-dossier-form textarea {
					pointer-events: none;
					background: #f3f4f6 !important;
					color: #6b7280 !important;
				}
			</style>
		{% endif %}

		<div class="ui breadcrumb" style="margin-bottom:1rem;">
			<h1 class="ui header" style="margin:0;">
				<i class="folder open icon"></i>
				{% if dossier.id %}
					Éditer dossier V2 #{{ dossier.id }}
				{% else %}
					Nouveau dossier V2
				{% endif %}
			</h1>
			<div class="ui segment">
				<div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
					{% if not dossier.lockedAt %}
						<button class="ui primary button" type="submit" form="rachat-dossier-form">
							<i class="save icon"></i>
							Enregistrer
						</button>
					{% else %}
						<button class="ui button disabled" type="button">
							<i class="lock icon"></i>
							Dossier verrouillé
						</button>
						<form method="post"
          action="{{ path('admin_rachats_v2_unlock', { id: dossier.id }) }}"
          style="display:inline-block;"
          onsubmit="return confirm('Déverrouiller ce dossier ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('unlock_dossier_' ~ dossier.id) }}">
        <button type="submit" class="ui orange button">
            <i class="unlock icon"></i>
            Déverrouiller le dossier
        </button>
    </form>
					{% endif %}


					{% if dossier.id %}
						<button class="ui teal button js-btn-pdf-preview" type="submit" form="generate-pdf-form" {{ dossier.hibCustomerId ? '' : 'disabled' }}>
							<i class="file pdf icon"></i>
							Aperçu PDF
						</button>
					{% endif %}

					{% if dossier.id %}
    <button
        class="ui red button"
        type="submit"
        form="delete-form"
        {{ (dossier.lockedAt) ? 'disabled' : '' }}
    >
        <i class="trash icon"></i>
        Supprimer
    </button>
{% endif %}

					<a class="ui button" href="{{ path('admin_rachats_v2_index') }}">
						Retour liste
					</a>
				</div>
			</div>
		</div>

		{% set status = dossier.status ?: 'draft' %}

		{{ form_start(form, { attr: { class: 'ui form', id: 'rachat-dossier-form' } }) }}

		<div class="ui stackable grid">
			<div class="eight wide column">

				<div class="ui segment">
					<div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
						<h3 class="ui header" style="margin:0;">
							<i class="user icon"></i>
							Dossier / vendeur
						</h3>

						<div>
							{% if dossier.isLocked %}
								<span class="ui red label">
									<i class="lock icon"></i>
									Verrouillé
								</span>
							{% elseif status == 'signed' %}
								<span class="ui green label">Signé</span>
							{% elseif status == 'cancelled' %}
								<span class="ui red label">Annulé</span>
							{% elseif status == 'ready' %}
								<span class="ui blue label">Prêt</span>
							{% else %}
								<span class="ui grey label">Brouillon</span>
							{% endif %}

							{% if dossier.reference %}
								<span class="ui basic label">{{ dossier.reference }}</span>
							{% endif %}
						</div>
					</div>

					<div class="three fields" style="margin-top:1rem;">
						<div class="field">{{ form_row(form.nomSnapshot) }}</div>
						<div class="field">{{ form_row(form.prenomSnapshot) }}</div>
						<div class="field">{{ form_row(form.telephoneSnapshot) }}</div>
					</div>

					<div class="three fields">
						<div class="field">{{ form_row(form.emailSnapshot) }}</div>
						<div class="field">{{ form_row(form.codePostalSnapshot) }}</div>
						<div class="field">{{ form_row(form.numeroCiSnapshot) }}</div>
					</div>

					<div class="field">
						{{ form_row(form.adresseSnapshot) }}
					</div>

					<div style="display:none;">
						{{ form_widget(form.hibCustomerId, { attr: { class: 'js-hib-customer-id-field' } }) }}
					</div>

					<div class="ui segment" id="hib-customer-live-box" data-dossier-id="{{ dossier.id ?: '' }}" data-search-url="{{ dossier.id ? path('admin_rachats_v2_customer_search', { id: dossier.id }) : '' }}" data-create-url="{{ dossier.id ? path('admin_rachats_v2_customer_create', { id: dossier.id }) : '' }}" data-assign-url-template="{{ dossier.id ? path('admin_rachats_v2_customer_assign', { id: dossier.id, customerId: 0 }) : '' }}" data-partial-url="{{ dossier.id ? path('admin_rachats_v2_customer_partial', { id: dossier.id }) : '' }}" data-create-token="{{ dossier.id ? csrf_token('rachat_dossier_customer_create_' ~ dossier.id) : '' }}" data-assign-token="{{ dossier.id ? csrf_token('rachat_dossier_customer_assign_' ~ dossier.id) : '' }}">
						<div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
							<h4 class="ui header" style="margin:0;">
								<i class="users icon"></i>
								Client Hiboutik
							</h4>
							<div class="js-hib-customer-status">
								{% if dossier.hibCustomerId %}
									<span class="ui green label">Client #{{ dossier.hibCustomerId }}
										lié</span>
								{% else %}
									<span class="ui red label">Aucun client lié</span>
								{% endif %}
							</div>
						</div>

						<div class="js-hib-customer-finalize-msg" style="margin-top:8px;color:{{ dossier.hibCustomerId ? '#1b5e20' : '#b71c1c' }};font-size:13px;">
							{% if dossier.id %}
								{% if dossier.hibCustomerId %}
									Client Hiboutik requis : OK, tu peux continuer vers le PDF puis la signature.
								{% else %}
									Liaison obligatoire avant l’aperçu PDF et la signature.
								{% endif %}
							{% else %}
								Enregistre d’abord le dossier pour activer la recherche et la création du client Hiboutik.
							{% endif %}
						</div>

						{% set customerLinked = dossier.hibCustomerId ? true : false %}

						<details class="js-hib-customer-search-details" style="margin-top:12px;" {{ customerLinked ? '' : 'open' }}>
							<summary style="cursor:pointer;font-weight:700;display:flex;align-items:center;gap:8px;outline:none;">
								<i class="dropdown icon"></i>
								{{ customerLinked ? 'Changer le client' : 'Rechercher / créer un client Hiboutik' }}
							</summary>

							<div style="margin-top:12px;">
								<div class="js-hib-customer-search-state" style="margin-top:8px;font-size:12px;color:#6b7280;">
									Tape nom, prénom ou téléphone pour chercher un client existant.
								</div>

								<div class="js-hib-customer-results" style="margin-top:12px;"></div>
							</div>
						</details>
					</div>

					<div id="hibCustomerBox" data-customer-signature="{{ [ dossier.hibCustomerId ?: '', hibCustomer.last_name|default(''), hibCustomer.first_name|default(''), hibCustomer.phone|default(''), hibCustomer.email|default(''), hibCustomer.company|default('') ]|join('||')|e('html_attr') }}" class="ui segment">
						<div id="hibCustomerReloadMsg" style="margin-top:10px;"></div>
						{% if dossier.hibCustomerId %}
							<div style="display:flex;gap:8px;flex-wrap:wrap;">
								<a class="ui button" href="{{ path('admin_hiboutik_customer_edit', { id: dossier.hibCustomerId }) }}" target="_blank">
									<i class="edit icon"></i>
									Éditer client
								</a>

								<button type="button" class="ui button btn-tablet-edit-customer" data-id="{{ dossier.hibCustomerId }}" data-device="TAB1">
									<i class="tablet alternate icon"></i>
									Éditer sur tablette
								</button>
							</div>

							<div class="js-tablet-customer-msg" style="margin-top:10px;"></div>
						{% endif %}
					</div>


					<div class="two fields">
						<div class="field">{{ form_row(form.paidMethod) }}</div>
						<div class="field">{{ form_row(form.dateCession) }}</div>
					</div>
				</div>

				<div class="ui segment">
					<h3 class="ui header">
						<i class="calculator icon"></i>
						Total dossier
					</h3>

					<div style="font-size:1.2rem;font-weight:700;">
						{{ dossier.totalAchat ?: '0.00' }}
						€
					</div>

					<div style="margin-top:6px;color:#6b7280;">
						Recalculé automatiquement à l’enregistrement.
					</div>

					{% if dossier.id %}
						{{ include('@SyliusAdmin/Rachat/RachatDossier/_media_capture_widget.html.twig', {
					widgetId: 'ci-dossier-' ~ dossier.id,
					title: 'Pièce d’identité dossier',
					uploadUrl: path('admin_rachats_v2_upload_ci', { id: dossier.id }),
					deleteUrl: path('admin_rachats_v2_delete_ci', { id: dossier.id }),
					csrfToken: csrf_token('rachat_dossier_ci_' ~ dossier.id),
					slotField: 'kind',
					fileField: 'ci',
					slots: {
						recto: pieceIdentite.recto|default(''),
						verso: pieceIdentite.verso|default('')
					},
					labels: {
						recto: 'Recto',
						verso: 'Verso'
					}
				}) }}
					{% else %}
						<div class="ui warning message">
							Enregistre d’abord le dossier pour activer la pièce d’identité.
						</div>
					{% endif %}
				</div>

			</div>

			<div class="eight wide column">

				<div class="ui segment">
					<div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
						<h3 class="ui header" style="margin:0;">
							<i class="boxes icon"></i>
							Items rachetés
						</h3>

						{% if not dossier.lockedAt %}
							<button type="button" class="ui primary button" id="btn-add-item">
								<i class="plus icon"></i>
								Ajouter un item
							</button>
						{% else %}
							<button type="button" class="ui button disabled">
								<i class="lock icon"></i>
								Ajout bloqué
							</button>
						{% endif %}
					</div>

					<div class="ui message" style="margin-top:12px;">
						Un dossier = un vendeur + plusieurs items.
					</div>

					<div id="items-collection" data-locked="{{ dossier.lockedAt ? '1' : '0' }}" data-index="{{ form.items|length }}">
						{% for itemForm in form.items %}
							{{ include('@SyliusAdmin/Rachat/RachatDossier/_item_form.html.twig', {
						itemForm: itemForm,
						dossier: dossier,
						brands: brands|default([])
					}) }}
						{% endfor %}
					</div>

					<template id="item-prototype-template">
						{{ include('@SyliusAdmin/Rachat/RachatDossier/_item_form.html.twig', {
					itemForm: form.items.vars.prototype,
					dossier: dossier,
					brands: brands|default([])
				}) }}
					</template>
				</div>

			</div>
		</div>

		{{ form_end(form) }}


		{% if dossier.id %}
			<form id="generate-pdf-form" method="post" action="{{ path('admin_rachats_v2_generate_pdf', { id: dossier.id }) }}" style="display:none;">
				<input type="hidden" name="_token" value="{{ csrf_token('generate_pdf_dossier_' ~ dossier.id) }}">
			</form>
		{% endif %}
		{% if dossier.id %}
			<form id="delete-form" method="post" action="{{ path('admin_rachats_v2_delete', { id: dossier.id }) }}" style="display:none;" onsubmit="return confirm('Confirmer la suppression de ce dossier ?')">
				<input type="hidden" name="_token" value="{{ csrf_token('rachat_dossier_delete_' ~ dossier.id) }}">
			</form>
		{% endif %}
		<script>
			(function () {
const box = document.getElementById('hib-customer-live-box');

if (! box || box.dataset.booted === '1') {
return;
}

box.dataset.booted = '1';

const dossierId = String(box.dataset.dossierId || '').trim();
const searchUrl = box.dataset.searchUrl || '';
const createUrl = box.dataset.createUrl || '';
const assignUrlTemplate = box.dataset.assignUrlTemplate || '';
const createToken = box.dataset.createToken || '';
const assignToken = box.dataset.assignToken || '';

const statusNode = box.querySelector('.js-hib-customer-status');
const searchStateNode = box.querySelector('.js-hib-customer-search-state');
const resultsNode = box.querySelector('.js-hib-customer-results');
const finalizeMsgNode = box.querySelector('.js-hib-customer-finalize-msg');
const searchDetails = box.querySelector('.js-hib-customer-search-details');

const hibCustomerIdField = document.querySelector('.js-hib-customer-id-field');
const pdfButton = document.querySelector('.js-btn-pdf-preview');

const nomInput = document.querySelector('[name$="[nomSnapshot]"]');
const prenomInput = document.querySelector('[name$="[prenomSnapshot]"]');
const telephoneInput = document.querySelector('[name$="[telephoneSnapshot]"]');
const emailInput = document.querySelector('[name$="[emailSnapshot]"]');
const adresseInput = document.querySelector('[name$="[adresseSnapshot]"]');
const codePostalInput = document.querySelector('[name$="[codePostalSnapshot]"]');
const numeroCiInput = document.querySelector('[name$="[numeroCiSnapshot]"]');

let debounceTimer = null;
let currentController = null;

function getValue(input) {
return input ? String(input.value || '').trim() : '';
}

function getPayload() {
return {
nomSnapshot: getValue(nomInput),
prenomSnapshot: getValue(prenomInput),
telephoneSnapshot: getValue(telephoneInput),
emailSnapshot: getValue(emailInput),
adresseSnapshot: getValue(adresseInput),
codePostalSnapshot: getValue(codePostalInput),
numeroCiSnapshot: getValue(numeroCiInput)
};
}

function hasLinkedCustomer() {
return !!(hibCustomerIdField && String(hibCustomerIdField.value || '').trim() !== '');
}

function escapeHtml(value) {
return String(value || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
}

function hasEnoughInfo(payload) {
return payload.nomSnapshot.length >= 2 || payload.prenomSnapshot.length >= 2 || payload.telephoneSnapshot.replace(/\D+/g, '').length >= 4 || payload.emailSnapshot.length >= 5;
}

function canCreate(payload) {
return payload.nomSnapshot !== '' || payload.prenomSnapshot !== '' || payload.telephoneSnapshot !== '';
}

function setSearchState(message, type) {
if (! searchStateNode) {
return;
}

let color = '#6b7280';
if (type === 'error') {
color = '#b71c1c';
} else if (type === 'success') {
color = '#1b5e20';
}

searchStateNode.style.color = color;
searchStateNode.textContent = message;
}

function updateFinalizeUi() {
const linked = hasLinkedCustomer();

if (pdfButton) {
pdfButton.disabled = ! linked;
}

if (finalizeMsgNode) {
finalizeMsgNode.style.color = linked ? '#1b5e20' : '#b71c1c';
finalizeMsgNode.textContent = linked ? 'Client Hiboutik requis : OK, tu peux continuer vers le PDF puis la signature.' : 'Liaison obligatoire avant l’aperçu PDF et la signature.';
}
}

function updateStatusBadge(customerId, isVirtual) {
if (! statusNode) {
return;
}

if (customerId) {
statusNode.innerHTML = '<span class="ui ' + (
isVirtual ? 'grey' : 'green'
) + ' label">' + (
isVirtual ? 'Client virtuel #' : 'Client #'
) + escapeHtml(customerId) + ' lié</span>';
} else {
statusNode.innerHTML = '<span class="ui red label">Aucun client lié</span>';
}
}

function renderCreateButton(payload) {
if (! canCreate(payload)) {
return '';
}

return '' + '<div class="ui info message" style="margin-top:10px;">' + '<div class="header">Aucun résultat satisfaisant</div>' + '<p style="margin-top:.5rem;">Créer un client Hiboutik avec les informations actuellement saisies.</p>' + '<button type="button" class="ui primary button js-hib-create-customer">Créer client</button>' + '</div>';
}

function renderResults(candidates, payload) {
if (! resultsNode) {
return;
}

if (!Array.isArray(candidates) || candidates.length === 0) {
resultsNode.innerHTML = renderCreateButton(payload);
return;
}

resultsNode.innerHTML = candidates.map(function (candidate) {
const id = candidate.id || '';
const name = [
candidate.first_name || '',
candidate.last_name || ''
].join(' ').trim() || 'Client';
const phone = candidate.phone || '—';
const email = candidate.email || '—';
const score = candidate.score !== undefined && candidate.score !== null ? candidate.score : '—';

return '' + '<div class="js-hib-customer-result">' + '<div>' + '<div style="font-weight:700;">' + escapeHtml(name) + '</div>' + '<div style="margin-top:4px;color:#4b5563;">#' + escapeHtml(id) + '</div>' + '<div style="margin-top:4px;font-size:12px;color:#6b7280;">Tél. ' + escapeHtml(phone) + ' · Email ' + escapeHtml(email) + ' · Score ' + escapeHtml(score) + '</div>' + '</div>' + '<div>' + '<button type="button" class="ui tiny primary button js-hib-assign-customer" data-customer-id="' + escapeHtml(id) + '">Affecter</button>' + '</div>' + '</div>';
}).join('') + renderCreateButton(payload);
}

async function runSearch() {
if (! dossierId || ! searchUrl) {
return;
}

if (hasLinkedCustomer() && searchDetails && ! searchDetails.open) {
return;
}

const payload = getPayload();

if (! hasEnoughInfo(payload)) {
if (resultsNode) {
resultsNode.innerHTML = '';
}
setSearchState('Tape au moins 2 lettres sur le nom ou prénom, ou 4 chiffres de téléphone.', 'info');
return;
}

if (currentController) {
currentController.abort();
}

currentController = new AbortController();

const params = new URLSearchParams({nom: payload.nomSnapshot, prenom: payload.prenomSnapshot, telephone: payload.telephoneSnapshot, email: payload.emailSnapshot});

setSearchState('Recherche en cours…', 'info');

try {
const response = await fetch(searchUrl + '?' + params.toString(), {
method: 'GET',
headers: {
'X-Requested-With': 'XMLHttpRequest',
'Accept': 'application/json'
},
credentials: 'same-origin',
signal: currentController.signal
});

const json = await response.json();

if (! response.ok || ! json.ok) {
throw new Error(json.error || 'Recherche impossible');
}

renderResults(json.candidates || [], payload);
setSearchState((json.candidates || []).length + ' résultat(s) Hiboutik.', 'success');
} catch (error) {
if (error.name === 'AbortError') {
return;
}

console.error(error);
if (resultsNode) {
resultsNode.innerHTML = renderCreateButton(payload);
}
setSearchState(error.message || 'Erreur de recherche.', 'error');
}
}

function scheduleSearch() {
clearTimeout(debounceTimer);
debounceTimer = window.setTimeout(runSearch, 350);
}

async function postForm(url, data) {
const response = await fetch(url, {
method: 'POST',
body: data,
headers: {
'X-Requested-With': 'XMLHttpRequest',
'Accept': 'application/json'
},
credentials: 'same-origin'
});

const json = await response.json();

if (! response.ok || ! json.ok) {
throw new Error(json.error || 'Action impossible');
}

return json;
}

async function createCustomer() {
const payload = getPayload();
const formData = new FormData();
formData.append('_token', createToken);
Object.entries(payload).forEach(function (entry) {
formData.append(entry[0], entry[1]);
});

setSearchState('Création du client Hiboutik…', 'info');

const json = await postForm(createUrl, formData);

if (hibCustomerIdField) {
hibCustomerIdField.value = String(json.hibCustomerId || '');
}

setSearchState(json.message || 'Client créé.', 'success');
window.location.reload();
}

async function assignCustomer(customerId) {
const formData = new FormData();
formData.append('_token', assignToken);

setSearchState('Affectation du client Hiboutik…', 'info');

const json = await postForm(assignUrlTemplate.replace(/\/0$/, '/' + encodeURIComponent(customerId)), formData);

if (hibCustomerIdField) {
hibCustomerIdField.value = String(json.hibCustomerId || customerId || '');
}

setSearchState(json.message || 'Client affecté.', 'success');
window.location.reload();
}[nomInput, prenomInput, telephoneInput, emailInput].forEach(function (input) {
if (input) {
input.addEventListener('input', scheduleSearch);
}
});

if (searchDetails) {
searchDetails.addEventListener('toggle', function () {
if (searchDetails.open) {
scheduleSearch();
}
});
}

box.addEventListener('click', function (event) {
const assignBtn = event.target.closest('.js-hib-assign-customer');
if (assignBtn) {
event.preventDefault();
assignCustomer(assignBtn.dataset.customerId).catch(function (error) {
console.error(error);
setSearchState(error.message || 'Affectation impossible.', 'error');
});
return;
}

const createBtn = event.target.closest('.js-hib-create-customer');
if (createBtn) {
event.preventDefault();
createCustomer().catch(function (error) {
console.error(error);
setSearchState(error.message || 'Création impossible.', 'error');
});
}
});

updateFinalizeUi();

if (dossierId && (! hasLinkedCustomer() || (searchDetails && searchDetails.open))) {
scheduleSearch();
}
})();
		</script>

		<script>
			(function () {
function bootRachatDossierV2() {
const collection = document.getElementById('items-collection');
const addBtn = document.getElementById('btn-add-item');
const prototypeTemplate = document.getElementById('item-prototype-template');

if (! collection || collection.dataset.booted === '1') {
return;
}
collection.dataset.booted = '1';

function initSemanticUi(root) {
if (! root) {
root = document;
}

if (window.$ && $.fn.checkbox) {
$(root || document).find('.ui.checkbox').checkbox();
}


if (window.$ && $.fn.dropdown) {
$(root).find('.ui.dropdown').each(function () {
const $el = $(this);

if ($el.data('msDropdownBooted')) {
return;
}

$el.data('msDropdownBooted', 1);
$el.dropdown();
});
}
}

function safeParseJson(value) {
if (! value) {
return {};
}

try {
const parsed = JSON.parse(value);
return parsed && typeof parsed === 'object' ? parsed : {};
} catch (e) {
return {};
}
}

function syncItemNumbers() {
collection.querySelectorAll('.js-rachat-item').forEach(function (node, index) {
const n = node.querySelector('.js-item-number');
if (n) {
n.textContent = String(index + 1);
}
});
}

function updateAttributesSummary(summaryText, values) {
if (! summaryText) {
return;
}

const data = values && typeof values === 'object' ? values : {};
let filled = 0;

Object.values(data).forEach(function (value) {
if (Array.isArray(value)) {
if (value.length > 0) {
filled++;
}
return;
}

if (value !== null && value !== undefined && String(value).trim() !== '') {
filled++;
}
});

summaryText.textContent = filled > 0 ? 'Attributs de l’item (' + filled + ' rempli' + (
filled > 1 ? 's' : ''
) + ')' : 'Attributs de l’item';
}

function bindItem(itemNode) {

{% set slots = slots ?? {} %}
{% set labels = labels ?? {} %}
{% set widgetId = widgetId ?? ('media-widget-' ~ random()) %}
{% set title = title ?? 'Médias' %}
{% set uploadUrl = uploadUrl ?? '' %}
{% set deleteUrl = deleteUrl ?? '' %}
{% set csrfToken = csrfToken ?? '' %}
{% set disabled = disabled ?? false %}
{% set slotField = slotField ?? 'slot' %}
{% set fileField = fileField ?? 'file' %}

<div
    id="{{ widgetId }}"
    class="ui segment js-rachat-media-widget"
    data-widget-id="{{ widgetId }}"
    data-upload-url="{{ uploadUrl }}"
    data-delete-url="{{ deleteUrl }}"
    data-csrf="{{ csrfToken }}"
    data-disabled="{{ disabled ? '1' : '0' }}"
    data-slot-field="{{ slotField }}"
    data-file-field="{{ fileField }}"
>
    <style>
        #{{ widgetId }} .rmw-hidden { display:none !important; }
        #{{ widgetId }} .rmw-video-wrap {
            background:#111;
            border-radius:12px;
            padding:10px;
            box-shadow:inset 0 0 0 1px rgba(255,255,255,.05);
        }
        #{{ widgetId }} .rmw-video {
            width:100%;
            max-height:360px;
            display:block;
            border-radius:8px;
            background:#000;
            object-fit:contain;
        }
        #{{ widgetId }} .rmw-preview-box {
            background:#f8f8f8;
            border:1px solid rgba(34,36,38,.12);
            border-radius:12px;
            padding:10px;
            min-height:220px;
            display:flex;
            align-items:center;
            justify-content:center;
            overflow:hidden;
        }
        #{{ widgetId }} .rmw-preview-box img {
            max-width:100%;
            max-height:190px;
            object-fit:contain;
            display:block;
            border-radius:8px;
        }
        #{{ widgetId }} .rmw-preview-empty {
            color:#888;
            font-style:italic;
            text-align:center;
            padding:20px;
        }
        #{{ widgetId }} .rmw-actions,
        #{{ widgetId }} .rmw-mobile-buttons {
            display:flex;
            gap:8px;
            flex-wrap:wrap;
            margin-top:12px;
        }
        #{{ widgetId }} .rmw-status {
            margin-bottom:12px;
        }
        #{{ widgetId }} .rmw-upload-block {
            margin-top:18px;
            padding-top:16px;
            border-top:1px solid rgba(34,36,38,.08);
        }
    </style>

    <h4 class="ui dividing header">{{ title }}</h4>

    <div class="ui message rmw-status rmw-hidden js-rmw-status"></div>

    {% if disabled %}
        <div class="ui warning message">
            Enregistre d’abord l’élément pour activer la webcam et l’upload.
        </div>
    {% else %}
        <div class="ui stackable two column grid">
            <div class="column">
                <div class="ui form">
                    <div class="fields">
                        <div class="eight wide field">
                            <label>Caméra</label>
                            <select class="ui dropdown js-rmw-camera-select">
                                <option value="">Caméra par défaut</option>
                            </select>
                        </div>

                        <div class="four wide field">
                            <label>&nbsp;</label>
                            <button type="button" class="ui primary fluid button js-rmw-start-camera">
                                Ouvrir
                            </button>
                        </div>

                        <div class="four wide field">
                            <label>&nbsp;</label>
                            <button type="button" class="ui fluid button js-rmw-stop-camera">
                                Fermer
                            </button>
                        </div>
                    </div>
                </div>

                <div class="rmw-video-wrap">
                    <video class="rmw-video js-rmw-video" autoplay playsinline muted></video>
                </div>

                <canvas class="rmw-hidden js-rmw-canvas"></canvas>

                <div class="rmw-actions">
                    {% for slot, url in slots %}
                        <button type="button" class="ui orange button js-rmw-capture" data-slot="{{ slot }}">
                            <i class="camera icon"></i>
                            Capturer {{ labels[slot] ?? slot }}
                        </button>
                    {% endfor %}
                </div>

                <div class="rmw-mobile-buttons">
                    {% for slot, url in slots %}
                        <label class="ui basic button" for="{{ widgetId }}-camera-{{ slot }}">
                            <i class="camera icon"></i>
                            Prendre {{ labels[slot] ?? slot }}
                        </label>
                        <input
                            type="file"
                            id="{{ widgetId }}-camera-{{ slot }}"
                            class="rmw-hidden js-rmw-file-input"
                            data-slot="{{ slot }}"
                            accept="image/*"
                            capture="environment"
                        >
                    {% endfor %}
                </div>

                <div class="ui small info message" style="margin-top:12px;">
                    Sur ordinateur : webcam en direct. Sur téléphone : les boutons “Prendre …” ouvrent directement l’appareil photo.
                </div>
            </div>

            <div class="column">
                <div class="ui stackable cards">
                    {% for slot, url in slots %}
                        <div class="card">
                            <div class="content">
                                <div class="header">{{ labels[slot] ?? slot }}</div>
                            </div>
                            <div class="content">
                                <div class="rmw-preview-box">
                                    <img
                                        class="js-rmw-preview {% if not url %}rmw-hidden{% endif %}"
                                        data-slot="{{ slot }}"
                                        src="{{ url ?: '' }}"
                                        alt="{{ labels[slot] ?? slot }}"
                                    >
                                    <div
                                        class="rmw-preview-empty js-rmw-preview-empty {% if url %}rmw-hidden{% endif %}"
                                        data-slot="{{ slot }}"
                                    >
                                        Aucun média enregistré
                                    </div>
                                </div>

                                <div style="margin-top:8px; display:flex; gap:6px; flex-wrap:wrap;">
                                    <a
                                        href="{{ url ?: '#' }}"
                                        target="_blank"
                                        class="ui tiny basic button js-rmw-open-link {% if not url %}rmw-hidden{% endif %}"
                                        data-slot="{{ slot }}"
                                    >
                                        <i class="external alternate icon"></i>
                                        Ouvrir
                                    </a>

                                    <button
                                        type="button"
                                        class="ui tiny button js-rmw-crop {% if not url %}rmw-hidden{% endif %}"
                                        data-slot="{{ slot }}"
                                    >
                                        <i class="crop icon"></i>
                                        Recadrer
                                    </button>

                                    <button
                                        type="button"
                                        class="ui tiny red basic button js-rmw-delete {% if not url %}rmw-hidden{% endif %}"
                                        data-slot="{{ slot }}"
                                    >
                                        <i class="trash icon"></i>
                                        Supprimer
                                    </button>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <div class="rmw-upload-block">
                    <h5 class="ui dividing header">Import manuel</h5>

                    <div class="ui form">
                        <div class="fields">
                            {% for slot, url in slots %}
                                <div class="field">
                                    <label class="ui fluid button" for="{{ widgetId }}-upload-{{ slot }}">
                                        <i class="upload icon"></i>
                                        Importer {{ labels[slot] ?? slot }}
                                    </label>
                                    <input
                                        type="file"
                                        id="{{ widgetId }}-upload-{{ slot }}"
                                        class="rmw-hidden js-rmw-file-input"
                                        data-slot="{{ slot }}"
                                        accept="image/*"
                                    >
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
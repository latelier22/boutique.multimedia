{% set ciRaw = dossier.pieceIdentiteUrl %}
{% set recto = null %}
{% set verso = null %}

{% if ciRaw %}
    {% if ciRaw starts with '{' or ciRaw starts with '[' %}
        {% set ci = ciRaw|json_decode %}
        {% if ci %}
            {% set recto = ci.recto ?? ci.front ?? ci[0] ?? null %}
            {% set verso = ci.verso ?? ci.back ?? ci[1] ?? null %}
        {% endif %}
    {% else %}
        {% set recto = ciRaw %}
    {% endif %}
{% endif %}

<div class="ui segment">
    <h3 class="ui header">
        <i class="id card outline icon"></i>
        <div class="content">Pièce d'identité</div>
    </h3>

    <div class="ui two column stackable grid">
        <div class="column">
            <div class="ui segment">
                <div style="font-weight:700; margin-bottom:10px;">Recto</div>

                {% if recto %}
                    <a href="{{ recto }}" target="_blank">
                        <img
                            src="{{ recto }}"
                            alt="Pièce d'identité recto"
                            style="max-width:100%; max-height:420px; display:block; margin:auto; border-radius:8px;"
                        >
                    </a>
                {% else %}
                    <div class="ui placeholder segment" style="min-height:160px;">
                        <div class="ui icon header">
                            <i class="image outline icon"></i>
                            Aucun recto
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="column">
            <div class="ui segment">
                <div style="font-weight:700; margin-bottom:10px;">Verso</div>

                {% if verso %}
                    <a href="{{ verso }}" target="_blank">
                        <img
                            src="{{ verso }}"
                            alt="Pièce d'identité verso"
                            style="max-width:100%; max-height:420px; display:block; margin:auto; border-radius:8px;"
                        >
                    </a>
                {% else %}
                    <div class="ui placeholder segment" style="min-height:160px;">
                        <div class="ui icon header">
                            <i class="image outline icon"></i>
                            Aucun verso
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
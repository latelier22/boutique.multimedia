{# templates/bundles/SyliusAdminBundle/Rachat/index.html.twig #}
{% extends '@!SyliusAdmin/layout.html.twig' %}
{% block title %}Rachats{% endblock %}

{% block content %}
<style>
  #bar{display:flex;gap:8px;align-items:center;margin-bottom:10px;flex-wrap:wrap}
  .btn{padding:6px 10px;border-radius:6px;border:1px solid #0d6efd;background:#0d6efd;color:#fff;cursor:pointer;text-decoration:none}
  .btn-secondary{background:#475569;border-color:#475569}
  .muted{opacity:.7}
  table{width:100%;border-collapse:collapse;background:#fff}
  th,td{padding:8px;border-bottom:1px solid #eee;text-align:left;vertical-align:middle}
  thead th{position:sticky;top:0;background:#0d6efd;color:#fff;z-index:1}
  img.thumb{height:28px;border-radius:4px;vertical-align:middle}
  .pill{display:inline-block;padding:2px 6px;border-radius:999px;font-size:.85em}
  .pill-ok{background:#dcfce7;color:#166534}
  .pill-off{background:#fee2e2;color:#991b1b}
</style>

{# Barre d’actions #}
<div id="bar">
  <a class="ui primary button" href="{{ path('admin_rachats_create') }}">➕ Créer (Quick)</a>

  {# ✅ bascule d’affichage #}
  {% set viewingDisabled = enabled == 0 %}
  <a class="ui button {{ viewingDisabled ? '' : 'primary' }}"
     href="{{ path('admin_rachats_index', { enabled: 1 }) }}">👀 Actifs</a>
  <a class="ui button {{ viewingDisabled ? 'primary' : '' }}"
     href="{{ path('admin_rachats_index', { enabled: 0 }) }}">🙈 Masqués</a>

  <button id="btn-edit" class="ui button" disabled>✏️ Éditer</button>

  {# ⚠️ Encaissement — propage le filtre courant #}
  <form id="form-pay" method="post" action="{{ path('admin_rachats_encaissement_batch') }}" style="display:flex;gap:6px;align-items:center">
    <input type="hidden" name="_back_enabled" value="{{ enabled }}">
    <select name="method" class="ui dropdown">
      <option value="">— moyen —</option>
      <option value="ESP">ESP</option>
      <option value="CHQ">CHQ</option>
      <option value="CB">CB</option>
      <option value="VIRT">VIRT</option>
      <option value="PAYPAL">PAYPAL</option>
      <option value="AUTRE">AUTRE…</option>
    </select>
    <input type="text" name="other_label" placeholder="Précision (si AUTRE)">
    <button class="ui button" type="submit">💶 Encaissement</button>
  </form>

  {# ⚠️ Masquer/Afficher — propage le filtre courant #}
  <form id="form-toggle" method="post" action="{{ path('admin_rachats_toggle_enabled_batch') }}" style="display:flex;gap:6px;align-items:center">
    <input type="hidden" name="_back_enabled" value="{{ enabled }}">
    <button class="ui button" name="val" value="0" type="submit">🙈 Masquer</button>
    <button class="ui button" name="val" value="1" type="submit">👀 Afficher</button>
  </form>
</div>

{# Tableau #}
<table id="rachats">
  <thead>
    <tr>
      <th style="width:36px"><input type="checkbox" id="sel-all" title="Tout sélectionner"></th>
      {% for c in columns %}
        <th>{{ c }}</th>
      {% endfor %}
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
  {% for row in rows %}
    <tr data-id="{{ row.id }}">
      <td><input type="checkbox" class="sel"></td>

      {# Colonnes dynamiques #}
      {% for c in columns %}
        <td>
          {# PDF #}
          {% if c == 'pdf_url' %}
            {% if row.pdf_url %}
              <a href="{{ row.pdf_url }}" target="_blank" rel="noopener">📄 PDF</a>
            {% else %}—{% endif %}

          {# Photos — aperçu #}
          {% elseif c == 'photos_json' %}
            {% set first = row.__photos_first %}
            {% set count = row.__photos_count %}
            {% if first %}
              <img src="{{ first }}" class="thumb" alt="photo">
              {% if count > 1 %} <span class="muted">(+{{ count-1 }})</span>{% endif %}
            {% else %}—{% endif %}

          {# Enabled — petite pastille #}
          {% elseif c == 'enabled' %}
            {% if row.enabled in [1, '1', true, 'true'] %}
              <span class="pill pill-ok">actif</span>
            {% else %}
              <span class="pill pill-off">masqué</span>
            {% endif %}

          {# paidAt — déjà formaté côté contrôleur si DateTime ; sinon affiche brut #}
          {% elseif c == 'paidAt' %}
            {{ attribute(row, c) ?: '—' }}

          {# paidMethod #}
          {% elseif c == 'paidMethod' %}
            {{ attribute(row, c) ?: '—' }}

          {# fallback #}
          {% else %}
            {{ attribute(row, c) is defined and attribute(row, c) is not empty ? attribute(row, c) : '—' }}
          {% endif %}
        </td>
      {% endfor %}

      <td>
        <a class="btn-secondary btn" href="{{ row.__edit_url }}">✏️ Éditer</a>
      </td>
    </tr>
  {% else %}
    <tr><td colspan="{{ 2 + columns|length }}"><em>Aucun rachat.</em></td></tr>
  {% endfor %}
  </tbody>
</table>

{# JS sélection + formulaires #}
<script>
(function(){
  const selAll = document.getElementById('sel-all');
  const btnEdit = document.getElementById('btn-edit');
  const payForm = document.getElementById('form-pay');
  const toggleForm = document.getElementById('form-toggle');

  function selectedIds(){
    return Array.from(document.querySelectorAll('.sel:checked'))
      .map(cb => cb.closest('tr')?.dataset.id)
      .filter(Boolean);
  }

  function onSelectionChanged(){
    const ids = selectedIds();
    if (btnEdit) btnEdit.disabled = (ids.length !== 1);
  }

  selAll?.addEventListener('change', (e)=>{
    document.querySelectorAll('.sel').forEach(cb => cb.checked = e.target.checked);
    onSelectionChanged();
  });
  document.querySelectorAll('.sel').forEach(cb => cb.addEventListener('change', onSelectionChanged));
  onSelectionChanged();

  // Bouton "Éditer"
  btnEdit?.addEventListener('click', (e)=>{
    e.preventDefault();
    const ids = selectedIds();
    if (ids.length !== 1) { alert('Sélectionne exactement un rachat.'); return; }
    const url = "{{ path('admin_rachats_edit', {id: 999999}) }}".replace('999999', ids[0]);
    window.location.href = url;
  });

  // Injecte ids[] dans le formulaire d'encaissement
  payForm?.addEventListener('submit', (e)=>{
    const ids = selectedIds();
    if (!ids.length) { e.preventDefault(); alert('Sélectionne au moins un rachat.'); return; }
    payForm.querySelectorAll('input[name="ids[]"]').forEach(n=>n.remove());
    ids.forEach(id=>{
      const inp = document.createElement('input');
      inp.type='hidden'; inp.name='ids[]'; inp.value=id;
      payForm.appendChild(inp);
    });
  });

  // Injecte ids[] dans le formulaire toggle enabled
  toggleForm?.addEventListener('submit', (e)=>{
    const ids = selectedIds();
    if (!ids.length) { e.preventDefault(); alert('Sélectionne au moins un rachat.'); return; }
    toggleForm.querySelectorAll('input[name="ids[]"]').forEach(n=>n.remove());
    ids.forEach(id=>{
      const inp = document.createElement('input');
      inp.type='hidden'; inp.name='ids[]'; inp.value=id;
      toggleForm.appendChild(inp);
    });
  });
})();
</script>
{% endblock %}

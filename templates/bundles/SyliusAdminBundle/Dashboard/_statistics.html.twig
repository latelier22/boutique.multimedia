			<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
			<script>
			document.addEventListener('DOMContentLoaded', () => {
			  const canvas = document.getElementById('rachat-stats-graph');
			  const loader = document.querySelector('.stats-loader');
			  if (!canvas) return;
			  let chart;
			
			  function drawChart(labels, values) {
			    const ctx = canvas.getContext('2d');
			    if (chart) chart.destroy();
			    chart = new Chart(ctx, {
			      type: 'bar',
			      data: {
			        labels,
			        datasets: [{
			          label: 'Montant des rachats (€)',
			          data: values,
			          backgroundColor: '#21ba45', // vert
			          borderColor: '#16ab39',
			          borderWidth: 1,
			          barThickness: 22,
			          borderRadius: 4
			        }]
			      },
			      options: {
			        responsive: true,
			        maintainAspectRatio: false,
			        plugins: { legend: { display: false } },
			        scales: {
			          y: { beginAtZero: true, grid:{color:'rgba(0,0,0,0.05)'} },
			          x: { grid:{display:false} }
			        }
			      }
			    });
			  }
			
			  drawChart(JSON.parse(canvas.dataset.labels), JSON.parse(canvas.dataset.values));
			
			  document.querySelectorAll('[data-rachat-stats]').forEach(btn => {
			    btn.addEventListener('click', async () => {
			      const interval = btn.dataset.rachatStats;
			      const url = btn.dataset.url + '?interval=' + interval;
			
			      // ✅ bouton actif vert
			      document.querySelectorAll('[data-rachat-stats]').forEach(b => b.classList.remove('green', 'active'));
			      btn.classList.add('green', 'active');
			
			      loader.classList.add('active');
			      try {
			        const res = await fetch(url);
			        const data = await res.json();
			
			        console.log('[RachatStats]', interval, data);
			
			        document.getElementById('rachat-total').textContent = data.summary.total_sales + ' €';
			        document.getElementById('rachat-count').textContent = data.summary.number_of_new_orders;
			        document.getElementById('rachat-avg').textContent = data.summary.average_order_value + ' €';
			
			        drawChart(data.series.intervals, data.series.sales);
			      } catch (e) {
			        console.error('Erreur stats:', e);
			      } finally {
			        setTimeout(() => loader.classList.remove('active'), 300);
			      }
			    });
			  });
			});
			</script> #}

{% extends '@!SyliusAdmin/layout.html.twig' %}

{% block title %}Arrivages Rachat Mensuel{% endblock %}

{% block content %}
{% include '@SyliusAdmin/Rachat/_menu_rachats.html.twig' %}
<h1 class="ui header">📦 Arrivages Rachat Mensuel</h1>

<form method="post" action="{{ path('admin_arrivages_create') }}" style="margin-bottom: 1em;">
  <button type="submit" class="ui green button">
    <i class="plus icon"></i> Créer l’arrivage du mois
  </button>
</form>

<table class="ui celled table">
  <thead>
    <tr>
      <th>ID</th>
      <th>Libellé</th>
      <th>Fournisseur</th>
      <th>Date</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
  {% for a in arrivages %}
    <tr>
      <td>{{ a.inventory_input_id ?? '—' }}</td>
      <td>{{ a.inventory_input_label ?? '—' }}</td>
      <td>{{ a.inventory_input_supplier_id ?? '—' }}</td>
      <td>{{ a.inventory_input_date ?? '—' }}</td>
      <td>
        <form method="post" action="{{ path('admin_arrivages_validate', {id: a.inventory_input_id}) }}" style="display:inline;">
          <button class="ui blue mini button"><i class="check icon"></i> Valider</button>
        </form>
        <a href="{{ path('admin_arrivages_details', {id: a.inventory_input_id}) }}" class="ui grey mini button">
          <i class="eye icon"></i> Détails
        </a>
      </td>
    </tr>
  {% else %}
    <tr><td colspan="5" class="center aligned">Aucun arrivage trouvé</td></tr>
  {% endfor %}
  </tbody>
</table>
{% endblock %}

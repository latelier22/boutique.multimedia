    <script>
    (function () {
      const toggleBtn = document.getElementById('toggleLocalUnlockFormBtn');
      const cancelBtn = document.getElementById('cancelLocalUnlockFormBtn');
      const wrap = document.getElementById('localUnlockFormWrap');

      if (toggleBtn && wrap) {
        toggleBtn.addEventListener('click', () => {
          wrap.style.display = wrap.style.display === 'none' ? '' : 'none';
        });
      }

      if (cancelBtn && wrap) {
        cancelBtn.addEventListener('click', () => {
          wrap.style.display = 'none';
        });
      }

      const grid = document.getElementById('patternInputGrid');
      const svg = document.getElementById('patternInputSvg');
      const hidden = document.getElementById('local_pattern');
      const clearBtn = document.getElementById('clearPatternBtn');
      const text = document.getElementById('patternInputText');

      if (!grid || !svg || !hidden || !clearBtn || !text) return;

      const points = {
        1: { x: 45,  y: 45 },
        2: { x: 110, y: 45 },
        3: { x: 175, y: 45 },
        4: { x: 45,  y: 110 },
        5: { x: 110, y: 110 },
        6: { x: 175, y: 110 },
        7: { x: 45,  y: 175 },
        8: { x: 110, y: 175 },
        9: { x: 175, y: 175 }
      };

      let pattern = [];
      let drawing = false;

      function render() {
        svg.innerHTML = '';

        if (pattern.length > 1) {
          for (let i = 0; i < pattern.length - 1; i++) {
            const from = points[pattern[i]];
            const to = points[pattern[i + 1]];
            if (!from || !to) continue;

            const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            line.setAttribute('x1', from.x);
            line.setAttribute('y1', from.y);
            line.setAttribute('x2', to.x);
            line.setAttribute('y2', to.y);
            line.setAttribute('stroke', '#2563eb');
            line.setAttribute('stroke-width', '5');
            line.setAttribute('stroke-linecap', 'round');
            svg.appendChild(line);
          }
        }

        grid.querySelectorAll('.pattern-node').forEach(el => el.remove());

        for (let i = 1; i <= 9; i++) {
          const p = points[i];
          const active = pattern.includes(i);

          const el = document.createElement('div');
          el.className = 'pattern-node';
          el.dataset.id = String(i);
          el.style.position = 'absolute';
          el.style.left = (p.x - 18) + 'px';
          el.style.top = (p.y - 18) + 'px';
          el.style.width = '36px';
          el.style.height = '36px';
          el.style.borderRadius = '50%';
          el.style.display = 'flex';
          el.style.alignItems = 'center';
          el.style.justifyContent = 'center';
          el.style.fontWeight = 'bold';
          el.style.userSelect = 'none';
          el.style.cursor = 'pointer';
          el.style.border = active ? '4px solid #2563eb' : '3px solid #9ca3af';
          el.style.background = active ? '#dbeafe' : '#fff';
          el.textContent = i;

          grid.appendChild(el);
        }

        hidden.value = JSON.stringify(pattern);
        text.textContent = pattern.length ? ('Schéma : ' + pattern.join('-')) : 'Aucun schéma';
      }

      function addPoint(id) {
        id = parseInt(id, 10);
        if (!id || pattern.includes(id)) return;
        pattern.push(id);
        render();
      }

      grid.addEventListener('mousedown', (e) => {
        const node = e.target.closest('.pattern-node');
        drawing = true;
        if (node) addPoint(node.dataset.id);
      });

      grid.addEventListener('mouseover', (e) => {
        if (!drawing) return;
        const node = e.target.closest('.pattern-node');
        if (node) addPoint(node.dataset.id);
      });

      window.addEventListener('mouseup', () => {
        drawing = false;
      });

      grid.addEventListener('touchstart', (e) => {
        drawing = true;
        const t = e.touches[0];
        const el = document.elementFromPoint(t.clientX, t.clientY);
        const node = el ? el.closest('.pattern-node') : null;
        if (node) addPoint(node.dataset.id);
        e.preventDefault();
      }, { passive: false });

      grid.addEventListener('touchmove', (e) => {
        if (!drawing) return;
        const t = e.touches[0];
        const el = document.elementFromPoint(t.clientX, t.clientY);
        const node = el ? el.closest('.pattern-node') : null;
        if (node) addPoint(node.dataset.id);
        e.preventDefault();
      }, { passive: false });

      window.addEventListener('touchend', () => {
        drawing = false;
      });

      clearBtn.addEventListener('click', () => {
        pattern = [];
        render();
      });

      render();
    })();
    </script>

    <script>
    (function () {
      const btnPreview = document.getElementById('btnPreviewTicketAjax');
      const btnPrint = document.getElementById('btnPrintTicketAjax');
      const btnClose = document.getElementById('btnCloseTicketPreview');
      const previewWrap = document.getElementById('ticketPreviewWrap');
      const form = document.getElementById('interventionEditForm');
      const frame = document.getElementById('printTicketFrame');

      if (!form || !frame) return;

      async function loadTicket() {
        const url = (btnPreview || btnPrint)?.dataset.url;
        if (!url) throw new Error('URL ticket manquante');

        const formData = new FormData(form);

        const response = await fetch(url, {
          method: 'POST',
          body: formData,
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        });

        if (!response.ok) {
          throw new Error('Erreur génération ticket');
        }

        const html = await response.text();
        const doc = frame.contentWindow.document;
        doc.open();
        doc.write(html);
        doc.close();
      }

      if (btnPreview) {
        btnPreview.addEventListener('click', async function () {
          btnPreview.classList.add('loading');
          btnPreview.disabled = true;

          try {
            await loadTicket();
            if (previewWrap) {
              previewWrap.style.display = 'block';
            }
          } catch (e) {
            console.error(e);
            alert('Impossible de générer l’aperçu.');
          } finally {
            btnPreview.classList.remove('loading');
            btnPreview.disabled = false;
          }
        });
      }

      if (btnPrint) {
        btnPrint.addEventListener('click', async function () {
          btnPrint.classList.add('loading');
          btnPrint.disabled = true;

          try {
            await loadTicket();
            frame.contentWindow.focus();
            frame.contentWindow.print();
          } catch (e) {
            console.error(e);
            alert('Impossible d’imprimer le ticket.');
          } finally {
            btnPrint.classList.remove('loading');
            btnPrint.disabled = false;
          }
        });
      }

      if (btnClose && previewWrap) {
        btnClose.addEventListener('click', function () {
          previewWrap.style.display = 'none';
        });
      }
    })();
    </script>


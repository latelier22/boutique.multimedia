    <script>
    (function () {
      const btn = document.querySelector('.btn-tablet-unlock-push');
      const msg = document.getElementById('tabletUnlockPushMsg');
      if (!btn) return;

      btn.addEventListener('click', async () => {
        msg.innerHTML = '';
        btn.classList.add('loading');
        btn.disabled = true;

        try {
          const device = btn.dataset.device || 'TAB1';

          const res = await fetch(btn.dataset.linkTemplate, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          });

          const j = await res.json();

          if (!j || !j.ok || !j.url) {
            throw new Error(j?.error || 'Génération du lien tablette impossible');
          }

          const u = new URL(j.url, window.location.origin);

          const push = await fetch('/ws-tablet-push', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: new URLSearchParams({
              device,
              url: u.pathname + u.search,
              token: '{{ tablet_socket_token|default('')|e('js') }}'
            })
          });

          const pj = await push.json().catch(() => ({}));

          if (!pj.ok) {
            throw new Error('Push KO: ' + (pj.error || ''));
          }

          msg.innerHTML = `
            <div class="ui positive message">
              <div class="header">Tablette envoyée</div>
              <p>Intervention #${j.intervention_number} envoyée sur la tablette.</p>
            </div>
          `;
        } catch (e) {
          console.error(e);
          msg.innerHTML = `
            <div class="ui negative message">
              <div class="header">Erreur tablette</div>
              <p>${e.message || 'Erreur push tablette'}</p>
            </div>
          `;
        } finally {
          btn.classList.remove('loading');
          btn.disabled = false;
        }
      });
    })();
    </script>

    {% if unlockData %}
    <script>
    (function () {
      const btn = document.getElementById('holdToRevealBtn');
      if (!btn) return;

      const maskedPin = document.getElementById('maskedPin');
      const realPin = document.getElementById('realPin');

      const maskedPatternText = document.getElementById('maskedPatternText');
      const realPatternBox = document.getElementById('realPatternBox');

      const maskedRemarks = document.getElementById('maskedRemarks');
      const realRemarks = document.getElementById('realRemarks');

      const preview = document.getElementById('patternPreview');
      const svg = document.getElementById('patternSvg');

      const HOLD_MS = 500;
      const ANIM_MS = 500;

      let pattern = [];
      let rafId = null;
      let cycleTimer = null;
      let isVisible = false;

      const positions = {
        1: { x: 35,  y: 35 },
        2: { x: 90,  y: 35 },
        3: { x: 145, y: 35 },
        4: { x: 35,  y: 90 },
        5: { x: 90,  y: 90 },
        6: { x: 145, y: 90 },
        7: { x: 35,  y: 145 },
        8: { x: 90,  y: 145 },
        9: { x: 145, y: 145 }
      };

      function loadPattern() {
        if (!preview) return [];
        try {
          const p = JSON.parse(preview.dataset.pattern || '[]');
          return Array.isArray(p) ? p : [];
        } catch (e) {
          return [];
        }
      }

      function clearPreview() {
        if (!preview || !svg) return;
        svg.innerHTML = '';
        preview.querySelectorAll('.pattern-dot').forEach(el => el.remove());
      }

      function drawDots(currentPattern) {
        if (!preview) return;
        const firstId = currentPattern[0];
        const lastId = currentPattern[currentPattern.length - 1];

        for (let i = 1; i <= 9; i++) {
          const pos = positions[i];
          const active = currentPattern.includes(i);
          const isStart = i === firstId;
          const isEnd = i === lastId;

          const dot = document.createElement('div');
          dot.className = 'pattern-dot';
          dot.style.position = 'absolute';
          dot.style.left = (pos.x - 16) + 'px';
          dot.style.top = (pos.y - 16) + 'px';
          dot.style.width = '32px';
          dot.style.height = '32px';
          dot.style.borderRadius = '50%';
          dot.style.display = 'flex';
          dot.style.alignItems = 'center';
          dot.style.justifyContent = 'center';
          dot.style.fontSize = '12px';
          dot.style.fontWeight = 'bold';
          dot.style.color = '#1f2937';

          if (isStart) {
            dot.style.border = '4px solid #16a34a';
            dot.style.background = '#dcfce7';
          } else if (isEnd) {
            dot.style.border = '4px solid #dc2626';
            dot.style.background = '#fee2e2';
          } else if (active) {
            dot.style.border = '4px solid #2563eb';
            dot.style.background = '#dbeafe';
          } else {
            dot.style.border = '3px solid #9ca3af';
            dot.style.background = '#ffffff';
          }

          dot.textContent = i;
          preview.appendChild(dot);
        }
      }

      function drawLine(x1, y1, x2, y2, withArrow = true) {
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', x1);
        line.setAttribute('y1', y1);
        line.setAttribute('x2', x2);
        line.setAttribute('y2', y2);
        line.setAttribute('stroke', '#2563eb');
        line.setAttribute('stroke-width', '4');
        line.setAttribute('stroke-linecap', 'round');
        svg.appendChild(line);

        if (!withArrow) return;

        const dx = x2 - x1;
        const dy = y2 - y1;
        const len = Math.sqrt(dx * dx + dy * dy);
        if (len < 1) return;

        const ux = dx / len;
        const uy = dy / len;

        const mx = x1 + dx * 0.60;
        const my = y1 + dy * 0.60;

        const arrowLen = 18;
        const arrowHalfWidth = 7;

        const tipX = mx + ux * (arrowLen / 2);
        const tipY = my + uy * (arrowLen / 2);

        const baseX = mx - ux * (arrowLen / 2);
        const baseY = my - uy * (arrowLen / 2);

        const px = -uy;
        const py = ux;

        const leftX = baseX + px * arrowHalfWidth;
        const leftY = baseY + py * arrowHalfWidth;

        const rightX = baseX - px * arrowHalfWidth;
        const rightY = baseY - py * arrowHalfWidth;

        const arrow = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
        arrow.setAttribute('points', `${tipX},${tipY} ${leftX},${leftY} ${rightX},${rightY}`);
        arrow.setAttribute('fill', '#2563eb');
        arrow.setAttribute('stroke', '#ffffff');
        arrow.setAttribute('stroke-width', '1.5');
        svg.appendChild(arrow);
      }

      function renderStaticFull(currentPattern) {
        clearPreview();
        if (!svg || !currentPattern.length) return;

        if (currentPattern.length > 1) {
          for (let i = 0; i < currentPattern.length - 1; i++) {
            const from = positions[currentPattern[i]];
            const to = positions[currentPattern[i + 1]];
            if (!from || !to) continue;
            drawLine(from.x, from.y, to.x, to.y, true);
          }
        }

        drawDots(currentPattern);
      }

      function renderAnimated(currentPattern, progress) {
        clearPreview();
        if (!svg || currentPattern.length < 1) return;

        const segmentCount = Math.max(0, currentPattern.length - 1);

        if (segmentCount > 0) {
          const fullSegments = Math.floor(progress);
          const partial = progress - fullSegments;

          for (let i = 0; i < fullSegments && i < segmentCount; i++) {
            const from = positions[currentPattern[i]];
            const to = positions[currentPattern[i + 1]];
            if (!from || !to) continue;
            drawLine(from.x, from.y, to.x, to.y, true);
          }

          if (fullSegments < segmentCount) {
            const from = positions[currentPattern[fullSegments]];
            const to = positions[currentPattern[fullSegments + 1]];

            if (from && to) {
              const x = from.x + (to.x - from.x) * partial;
              const y = from.y + (to.y - from.y) * partial;
              drawLine(from.x, from.y, x, y, true);
            }
          }
        }

        drawDots(currentPattern);
      }

      function stopAnimationLoop() {
        if (rafId) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
        if (cycleTimer) {
          clearTimeout(cycleTimer);
          cycleTimer = null;
        }
      }

      function startAnimationLoop() {
        stopAnimationLoop();

        if (!isVisible || !pattern.length) {
          renderStaticFull(pattern);
          return;
        }

        renderStaticFull(pattern);

        cycleTimer = setTimeout(() => {
          if (!isVisible) return;

          const segmentCount = Math.max(0, pattern.length - 1);
          if (segmentCount <= 0) {
            startAnimationLoop();
            return;
          }

          const start = performance.now();

          function step(now) {
            if (!isVisible) return;

            const elapsed = now - start;
            const t = Math.min(1, elapsed / ANIM_MS);
            const progress = t * segmentCount;

            renderAnimated(pattern, progress);

            if (t < 1) {
              rafId = requestAnimationFrame(step);
            } else {
              renderStaticFull(pattern);
              cycleTimer = setTimeout(() => {
                if (isVisible) {
                  startAnimationLoop();
                }
              }, HOLD_MS);
            }
          }

          rafId = requestAnimationFrame(step);
        }, HOLD_MS);
      }

      function reveal() {
        if (maskedPin) maskedPin.style.display = 'none';
        if (realPin) realPin.style.display = '';

        if (maskedPatternText) maskedPatternText.style.display = 'none';
        if (realPatternBox) realPatternBox.style.display = '';

        if (maskedRemarks) maskedRemarks.style.display = 'none';
        if (realRemarks) realRemarks.style.display = '';

        pattern = loadPattern();
        isVisible = true;
        startAnimationLoop();
      }

      function hide() {
        isVisible = false;
        stopAnimationLoop();

        if (maskedPin) maskedPin.style.display = '';
        if (realPin) realPin.style.display = 'none';

        if (maskedPatternText) maskedPatternText.style.display = '';
        if (realPatternBox) realPatternBox.style.display = 'none';

        if (maskedRemarks) maskedRemarks.style.display = '';
        if (realRemarks) realRemarks.style.display = 'none';
      }

      btn.addEventListener('mousedown', reveal);
      btn.addEventListener('mouseup', hide);
      btn.addEventListener('mouseleave', hide);

      btn.addEventListener('touchstart', function (e) {
        e.preventDefault();
        reveal();
      }, { passive: false });

      btn.addEventListener('touchend', function (e) {
        e.preventDefault();
        hide();
      }, { passive: false });

      btn.addEventListener('touchcancel', hide);

      window.addEventListener('mouseup', hide);
      window.addEventListener('touchend', hide);
    })();
    </script>
    {% endif %}

    <script>
    (function () {
      const statusUrl = "{{ path('app_admin_intervention_unlock_status', {id: intervention.id}) }}";
      let initialUpdatedAt = "{{ intervention.updatedAt|date('c') }}";
      let reloading = false;

      async function checkUnlockUpdate() {
        if (reloading) return;

        try {
          const res = await fetch(statusUrl, {
            method: 'GET',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          });

          const j = await res.json();
          if (!j || !j.ok) return;

          if (j.updatedAt && j.updatedAt !== initialUpdatedAt) {
            reloading = true;
            window.location.reload();
          }
        } catch (e) {
          console.error('[unlock-status]', e);
        }
      }

      setInterval(checkUnlockUpdate, 2000);
    })();
    </script>

<script>
(function () {
  document.addEventListener('click', async function (e) {
    const btn = e.target.closest('.btn-tablet-edit-customer');
    if (!btn) return;

    const box = btn.closest('#hibCustomerBox') || document;
    const msg = box.querySelector('#tabletCustomerMsg');

    btn.classList.add('loading');
    btn.disabled = true;
    if (msg) msg.innerHTML = '';

    try {
      const id = btn.dataset.id;
      const device = btn.dataset.device || 'TAB1';

      const url = `/tablet/customers/${id}/edit?device=${device}`;

      const push = await fetch(`/ws-tablet-push`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded'
        },
        body: new URLSearchParams({
          device,
          url,
          token: '{{ tablet_socket_token|e("js") }}'
        })
      });

      const pj = await push.json().catch(() => ({}));

      if (!pj.ok) {
        throw new Error(pj.error || 'push KO');
      }

      if (msg) {
        msg.innerHTML = `
          <div class="ui positive message">
            Édition client envoyée sur la tablette.
          </div>
        `;
      }
    } catch (e) {
      console.error(e);
      if (msg) {
        msg.innerHTML = `
          <div class="ui negative message">
            ${e.message || 'Erreur push tablette'}
          </div>
        `;
      }
    } finally {
      btn.classList.remove('loading');
      btn.disabled = false;
    }
  });
})();

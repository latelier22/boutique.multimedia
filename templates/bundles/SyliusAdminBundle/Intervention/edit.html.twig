<script>
(function () {
    const interventionId = {{ intervention.id }};
    const url = "{{ path('app_admin_intervention_customer_box', {id: intervention.id}) }}";
    const customerId = {{ intervention.hiboutikCustomerId ?: 'null' }};
    let lastSnapshot = '';
    let busy = false;

    function extractText(el) {
        return (el ? el.innerText : '').trim();
    }

    function buildSnapshotFromDom() {
        const box = document.getElementById('hibCustomerBox');
        return extractText(box);
    }

    async function refreshCustomerBoxIfChanged() {
        if (busy) return;
        busy = true;

        try {
            const res = await fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!res.ok) {
                throw new Error('Erreur chargement client');
            }

            const html = await res.text();

            const temp = document.createElement('div');
            temp.innerHTML = html.trim();

            const newBox = temp.firstElementChild;
            const currentBox = document.getElementById('hibCustomerBox');

            if (!newBox || !currentBox) {
                busy = false;
                return;
            }

            const newSnapshot = extractText(newBox);

            if (lastSnapshot === '') {
                lastSnapshot = extractText(currentBox);
            }

            if (newSnapshot !== lastSnapshot) {
                currentBox.replaceWith(newBox);
                lastSnapshot = newSnapshot;
            }
        } catch (e) {
            console.error(e);
        } finally {
            busy = false;
        }
    }

    lastSnapshot = buildSnapshotFromDom();
    setInterval(refreshCustomerBoxIfChanged, 2000);
})();
</script>

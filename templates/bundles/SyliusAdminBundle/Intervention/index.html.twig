{% extends '@!SyliusAdmin/layout.html.twig' %}

{% block title %}Interventions{% endblock %}

{% block content %}

<style>
  .tr-status-open > td { background-color: #e8f4fd !important; }
  .tr-status-wait > td { background-color: #fff8e1 !important; }
  .tr-status-done > td { background-color: #e8f5e9 !important; }
  .tr-status-cancel > td { background-color: #fdecea !important; }

  .intervention-table-loading {
    opacity: .55;
    pointer-events: none;
    transition: opacity .15s ease;
  }

  .intervention-compact-table th,
  .intervention-compact-table td {
    padding: 6px 8px !important;
    vertical-align: middle !important;
    line-height: 1.15;
  }

  .intervention-compact-table td {
    white-space: nowrap;
  }

  .intervention-compact-table .td-work {
    white-space: pre-line !important;
    min-width: 220px;
    max-width: 360px;
  }

  .intervention-compact-table .td-client,
  .intervention-compact-table .td-payment,
  .intervention-compact-table .td-actions {
    white-space: nowrap;
  }

  .cell-inline {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: nowrap;
  }

  .customer-name {
    font-weight: 600;
  }

  .mini-icon-btn.ui.button {
    padding: 6px 7px !important;
  }

  .intervention-actions-wrap {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    flex-wrap: nowrap;
  }

  .intervention-actions {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: nowrap;
  }

  .intervention-actions form {
    margin: 0;
  }

  .intervention-actions > .button,
  .intervention-actions > a.button,
  .intervention-actions > form > .button {
    margin: 0 !important;
  }

  .payment-inline {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: nowrap;
  }

  .payment-amount {
    font-weight: 600;
  }

  .inline-msg:empty {
    display: none;
  }

  .inline-msg .ui.label {
    margin: 0 !important;
  }

  .status-label.ui.label,
  .payment-inline .ui.label {
    margin: 0 !important;
  }

  @media (max-width: 991px) {
    .intervention-actions-wrap {
      justify-content: flex-start;
    }

    .intervention-compact-table {
      font-size: 12px;
    }

    .intervention-compact-table .td-work {
      min-width: 160px;
      max-width: 240px;
    }
  }
</style>

{# {% include '@SyliusAdmin/Rachat/_menu_rachats.html.twig' %} #}

<div class="ui segment">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;gap:12px;flex-wrap:wrap;">
    <h1 class="ui header" style="margin:0;">Interventions</h1>

    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <a class="ui primary button" href="{{ path('app_admin_intervention_new') }}">
        Nouvelle intervention (client)
      </a>

      <form method="post" action="{{ path('app_admin_intervention_quick_create') }}" style="display:inline-block;">
        <button class="ui primary button" type="submit">
          <i class="flash icon"></i>
          Intervention rapide (vide)
        </button>
      </form>
    </div>
  </div>

  <form class="ui form" id="filterForm" onsubmit="return false;" style="margin-bottom:16px;">
    <div class="fields">
      <div class="eight wide field">
        <label>Recherche</label>
        <input
          type="text"
          name="q"
          placeholder="N°, client, téléphone, appareil, travail, déverrouillage..."
          value="{{ filters.q ?? '' }}"
          autocomplete="off"
        >
      </div>

      <div class="four wide field">
        <label>Statut</label>
        <select name="status" class="ui dropdown">
          <option value="">Tous statuts</option>
          <option value="Ouverte" {{ (filters.status ?? '') == 'Ouverte' ? 'selected' : '' }}>Ouverte</option>
          <option value="En attente" {{ (filters.status ?? '') == 'En attente' ? 'selected' : '' }}>En attente</option>
          <option value="Terminée" {{ (filters.status ?? '') == 'Terminée' ? 'selected' : '' }}>Terminée</option>
          <option value="Annulée" {{ (filters.status ?? '') == 'Annulée' ? 'selected' : '' }}>Annulée</option>
        </select>
      </div>

      <div class="four wide field">
        <label>&nbsp;</label>
        <button type="button" class="ui button" id="resetFiltersBtn">
          Réinitialiser
        </button>
      </div>
    </div>
  </form>

  <div id="interventionTableWrap">
    <table class="ui celled table intervention-compact-table">
      <thead>
        <tr>
          <th>N°</th>
          <th>Date</th>
          <th>Client</th>
          <th>Société</th>
          <th>Téléphone</th>
          <th>Appareil</th>
          <th>Travail</th>
          <th>BOITE</th>
          <th>Statut</th>
          <th>Paiement</th>
          <th>ACTIONS</th>
        </tr>
      </thead>
      <tbody>
        {% for item in items %}
          <tr class="
            {% if item.status == 'Ouverte' %}
              tr-status-open
            {% elseif item.status == 'En attente' %}
              tr-status-wait
            {% elseif item.status == 'Terminée' %}
              tr-status-done
            {% elseif item.status == 'Annulée' %}
              tr-status-cancel
            {% endif %}
          ">
            <td>{{ item.interventionNumber }}</td>
            <td>{{ item.createdAt|date('d/m/Y H:i') }}</td>

            {% set hc = item.hiboutikCustomerId and hibCustomers[item.hiboutikCustomerId] is defined ? hibCustomers[item.hiboutikCustomerId] : null %}

            <td class="td-client">
              {% if hc %}
                <div class="cell-inline">
                  <span class="customer-name">{{ hc.last_name ?? '' }} {{ hc.first_name ?? '' }}</span>

                  {% if item.hiboutikCustomerId %}
                    <a
                      class="ui icon mini button mini-icon-btn"
                      href="{{ path('admin_hiboutik_customer_edit', {id: item.hiboutikCustomerId}) }}"
                      title="Éditer client"
                    >
                      <i class="pencil icon"></i>
                    </a>

                    <button
                      type="button"
                      class="ui icon mini button mini-icon-btn btn-tablet-edit-customer"
                      data-id="{{ item.hiboutikCustomerId }}"
                      data-device="TAB1"
                      data-msg-id="tabletClientMsg{{ item.id }}"
                      title="Éditer client sur tablette"
                    >
                      <i class="tablet alternate icon"></i>
                    </button>

                    <span id="tabletClientMsg{{ item.id }}" class="inline-msg"></span>
                  {% endif %}
                </div>
              {% else %}
                —
              {% endif %}
            </td>

            <td>
              {% if hc and hc.company is defined and hc.company %}
                {{ hc.company }}
              {% else %}
                —
              {% endif %}
            </td>

            <td>
              {% if hc and hc.phone is defined and hc.phone %}
                {{ hc.phone }}
              {% else %}
                —
              {% endif %}
            </td>

            <td>{{ item.deviceLabel ?: '—' }}</td>

            <td class="td-work">{{ item.workToDo ?: '—' }}</td>

            <td>
              {% if item.boite %}
                {{ item.boite.code }}
              {% else %}
                —
              {% endif %}
            </td>

            <td>
              <div class="ui mini label status-label
                {% if item.status == 'Ouverte' %}blue
                {% elseif item.status == 'En attente' %}yellow
                {% elseif item.status == 'Terminée' %}green
                {% elseif item.status == 'Annulée' %}red
                {% endif %}
              ">
                {{ item.status }}
              </div>
            </td>

            <td class="td-payment">
              {% set total = item.amountTotal is defined and item.amountTotal is not null and item.amountTotal != '' ? (item.amountTotal + 0) : 0 %}
              {% set paid = item.amountPaid is defined and item.amountPaid is not null and item.amountPaid != '' ? (item.amountPaid + 0) : 0 %}

              {% if total > 0 %}
                <div class="payment-inline">
                  <span class="payment-amount">{{ total|number_format(2, ',', ' ') }} €</span>

                  {% if paid >= total and paid > 0 %}
                    <span class="ui mini green label">PAYÉ</span>
                    <span>Versé {{ paid|number_format(2, ',', ' ') }} €</span>

                  {% elseif paid > 0 and paid < total %}
                    <span class="ui mini yellow label">Acompte {{ paid|number_format(2, ',', ' ') }} €</span>
                    <span>Reste {{ (total - paid)|number_format(2, ',', ' ') }} €</span>

                  {% else %}
                    <span class="ui mini grey label">Non payé</span>
                  {% endif %}

                  {% if item.paymentMode %}
                    <span class="ui mini basic label">{{ item.paymentMode }}</span>
                  {% endif %}
                </div>
              {% else %}
                —
              {% endif %}
            </td>

            <td class="right aligned td-actions">
              <div class="intervention-actions-wrap">
                <div class="intervention-actions">
                  <a
                    class="ui icon mini button mini-icon-btn"
                    href="{{ path('app_admin_intervention_edit', {id: item.id}) }}"
                    title="Éditer intervention"
                  >
                    <i class="pencil icon"></i>
                  </a>

                  <button
                    type="button"
                    class="ui icon mini blue button mini-icon-btn btn-tablet-unlock-push"
                    data-id="{{ item.id }}"
                    data-device="TAB1"
                    data-link-template="{{ path('app_admin_intervention_tablet_link', {id: item.id}) }}"
                    data-msg-id="tabletMsg{{ item.id }}"
                    title="Envoyer sur tablette"
                  >
                    <i class="tablet alternate icon"></i>
                  </button>

                  <form
                    method="post"
                    action="{{ path('app_admin_intervention_delete', {id: item.id}) }}"
                    onsubmit="return confirm('Supprimer l’intervention #{{ item.interventionNumber }} ?');"
                    style="display:inline-block;margin:0;"
                  >
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_intervention_' ~ item.id) }}">
                    <button class="ui icon mini red button mini-icon-btn" type="submit" title="Supprimer">
                      <i class="trash icon"></i>
                    </button>
                  </form>
                </div>

                <span id="tabletMsg{{ item.id }}" class="inline-msg"></span>
              </div>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="11">Aucune intervention.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<script>
(function () {
  const form = document.getElementById('filterForm');
  const tableWrap = document.getElementById('interventionTableWrap');
  const resetBtn = document.getElementById('resetFiltersBtn');

  if (!form || !tableWrap) return;

  let timeout = null;
  let currentAbort = null;

  function showInlineMsg(el, type, text) {
    if (!el) return;

    const color = type === 'error' ? 'red' : 'green';
    el.innerHTML = `<span class="ui mini basic ${color} label">${text}</span>`;

    clearTimeout(el._msgTimer);
    el._msgTimer = setTimeout(() => {
      el.innerHTML = '';
    }, 3500);
  }

  function bindTabletButtons(scope = document) {
    const buttons = scope.querySelectorAll('.btn-tablet-unlock-push');
    if (!buttons.length) return;

    buttons.forEach(btn => {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';

      btn.addEventListener('click', async () => {
        const msg = document.getElementById(btn.dataset.msgId);
        if (msg) msg.innerHTML = '';

        btn.disabled = true;
        btn.classList.add('loading');

        try {
          const device = btn.dataset.device || 'TAB1';

          const res = await fetch(btn.dataset.linkTemplate, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          });

          const j = await res.json();
          if (!j || !j.ok || !j.url) {
            throw new Error(j?.error || 'Génération du lien tablette impossible');
          }

          const u = new URL(j.url, window.location.origin);

          const push = await fetch('/ws-tablet-push', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: new URLSearchParams({
              device,
              url: u.pathname + u.search,
              token: '{{ tablet_socket_token|default('')|e('js') }}'
            })
          });

          const pj = await push.json().catch(() => ({}));

          if (!pj.ok) {
            throw new Error('Push KO: ' + (pj.error || ''));
          }

          showInlineMsg(msg, 'ok', `Intervention #${j.intervention_number} envoyée`);
        } catch (e) {
          console.error(e);
          showInlineMsg(msg, 'error', e.message || 'Erreur push tablette');
        } finally {
          btn.disabled = false;
          btn.classList.remove('loading');
        }
      });
    });
  }

  function bindTabletCustomerButtons(scope = document) {
    const buttons = scope.querySelectorAll('.btn-tablet-edit-customer');
    if (!buttons.length) return;

    buttons.forEach(btn => {
      if (btn.dataset.boundCustomer === '1') return;
      btn.dataset.boundCustomer = '1';

      btn.addEventListener('click', async () => {
        const msg = btn.dataset.msgId ? document.getElementById(btn.dataset.msgId) : null;
        if (msg) msg.innerHTML = '';

        btn.disabled = true;
        btn.classList.add('loading');

        try {
          const id = btn.dataset.id;
          const device = btn.dataset.device || 'TAB1';
          const url = `/tablet/customers/${id}/edit?device=${device}`;

          const push = await fetch('/ws-tablet-push', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: new URLSearchParams({
              device,
              url,
              token: '{{ tablet_socket_token|default('')|e('js') }}'
            })
          });

          const pj = await push.json().catch(() => ({}));

          if (!pj.ok) {
            throw new Error(pj.error || 'push KO');
          }

          showInlineMsg(msg, 'ok', 'Client envoyé tablette');
        } catch (e) {
          console.error(e);
          showInlineMsg(msg, 'error', e.message || 'Erreur push tablette');
        } finally {
          btn.disabled = false;
          btn.classList.remove('loading');
        }
      });
    });
  }

  async function refreshTable() {
    const params = new URLSearchParams(new FormData(form));
    const url = window.location.pathname + '?' + params.toString();

    if (currentAbort) {
      currentAbort.abort();
    }

    currentAbort = new AbortController();
    tableWrap.classList.add('intervention-table-loading');

    try {
      const res = await fetch(url, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        signal: currentAbort.signal
      });

      const html = await res.text();
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');

      const newWrap = doc.querySelector('#interventionTableWrap');
      if (!newWrap) return;

      tableWrap.innerHTML = newWrap.innerHTML;

      bindTabletButtons(tableWrap);
      bindTabletCustomerButtons(tableWrap);

      window.history.replaceState({}, '', url);
    } catch (e) {
      if (e.name !== 'AbortError') {
        console.error('Erreur refresh filtre', e);
      }
    } finally {
      tableWrap.classList.remove('intervention-table-loading');
    }
  }

  form.querySelectorAll('input, select').forEach(el => {
    el.addEventListener('input', () => {
      clearTimeout(timeout);
      timeout = setTimeout(refreshTable, 250);
    });

    el.addEventListener('change', () => {
      clearTimeout(timeout);
      refreshTable();
    });
  });

  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      form.reset();
      refreshTable();
    });
  }

  bindTabletButtons(document);
  bindTabletCustomerButtons(document);
})();
</script>

{% endblock %}